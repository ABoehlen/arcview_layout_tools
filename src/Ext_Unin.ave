if (av.GetProject = nil) then
  return nil
end

if (av.GetProject.IsClosing) then
  return nil
end

layoutGUI = av.GetProject.FindGUI( "Layout" )

'# Schaltflaeche und Dialoge entfernen
layoutGUI.GetButtonBar.Remove(layoutGUI.GetButtonBar.FindByScript( "LayoutTools.start"))
av.GetProject.removedialog("LayoutTools")
av.GetProject.removedialog("Satzspiegel")
