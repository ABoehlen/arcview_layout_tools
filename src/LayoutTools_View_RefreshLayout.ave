theLayout = av.GetActiveDoc

if (theLayout.Is(layout).Not) then
  MsgBox.Info("Start this script from an active Layout.","")
  return nil
end

theLayout.GetDisplay.ZoomIn(110)
theLayout.GetDisplay.ZoomOut(111)
theLayout.GetDisplay.ZoomIn(111)
theLayout.GetDisplay.ZoomOut(110)

