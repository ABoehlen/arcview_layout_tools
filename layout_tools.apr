(SEd.244
	Name:	"LayoutTools.Guides_TurnGuidesOnOff"
	Creator:	"adrian"
	CreationDate:	"Sam 07 Jan 2017 10:44:28 CET"
	GUIName:	"Script"
	Win:	245
	CSMgr:	246
	DocExts:	247
	Source:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_Guides_TurnGuidesOnOff.ave\n'# Author:       Adrian Boehlen\n'# Date:         20.12.2022\n'# Version:      1.0\n'#\n'# Purpose:      schaltet durch DrawGuides erzeugte Hilfslinien fuer\n'#               das aktive oder mehrere Layouts ein oder aus\n'#\n'###########################################################################\n\n'# Variablen uebernehmen\nanz = Self.Get(0)\nonoff = Self.Get(1)\n\n'# mehrere oder 
ein Layout definieren\nif (anz = \"many\") then\n  theProject = av.GetProject\n  theDocL = theProject.GetDocs\n  theLayoutL = {}\n  for each theEntry in theDocL\n    if (theEntry.Is(Layout)) then\n      theLayoutL.Add(theEntry)\n    end\n  end\n  theBatchLayoutL = MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Turn Rulers Off\")\n  if (theBatchLayoutL = nil) then \n    return nil\n  end\n  while (theBatchLayoutL.Count = 0) \n    MsgBox.Error(\"Please choose one oder more layout(s)\"+NL+\"Cancel for abort\", \"\")\n    theBatchL
ayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Turn Rulers Off\")\n    if (theBatchLayoutL = nil) then\n      return nil\n    end\n  end\nelse\n  theLayout = av.GetActiveDoc\n  if (theLayout.Is(layout).Not) then\n    MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n    return nil\n  else\n    theBatchLayoutL = {theLayout}\n  end\nend\n\n'# Farbe fuer Hilfslinie und weiss festlegen und vorhandene Linien entsprechend aendern\nfor each theLayout in theBatchLayoutL\n  farbeStr = \"\"\n  hilfslFarbeStr = \"24
040200\"          '# RGB-Wert der Hilfslinie...\n  hilfslFarbe = Color.Make\n  hilfslFarbe.SetRGBList({240,40,200}) '# ...gemaess Definition in DrawRulers\n  weissStr = \"255255255\"\n  weiss = Color.Make\n  weiss.SetRGBList({255,255,255})      '# RGB weiss\n\n  for each g in theLayout.GetGraphics\n    if (g.Is(GraphicGroup).Not) then\n      symb = g.GetSymbol\n      rgb = symb.GetColor.GetRGBList\n      for each farbe in rgb\n        farbeStr = farbeStr + farbe.AsString '# RGB-String bilden\n      end\n      if (onoff = \"o
n\") then\n        if (farbeStr = weissStr) then\n          g.SetSelected(TRUE)\n          g.GetSymbol.SetColor(hilfslFarbe)\n        end\n      else\n        if (farbeStr = hilfslFarbeStr) then\n          g.SetSelected(TRUE)\n          g.GetSymbol.SetColor(weiss)\n        end\n      end\n    farbeStr = \"\"\n    end\n  end\n  theGraphicsList = theLayout.GetGraphics\n  theGraphicsList.MoveSelectedToBack\n  theGraphicsList.UnselectAll\n  theLayout.GetDisplay.Invalidate(true)\nend\n"
	SearchStr:	"Run"
)

