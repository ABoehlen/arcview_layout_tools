	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_View_UndoZoom.ave\n'# Author:       Adrian Boehlen\n'# Date:         06.11.2022\n'# Version:      1.0\n'#\n'# Purpose:      Macht die aus dem View Modus bekannte Funktion auch fuer\n'#               Layouts verfuegbar\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active
 Layout.\",\"\")\n  return nil\nend\n\ntheLayout.GetDisplay.UndoZoom\n"
)

