(SEd.316
	Name:	"LayoutTools.Text_CreateInhaltsverzeichnis"
	Creator:	"adrian"
	CreationDate:	"Son 07 Feb 2016 14:34:50 CET"
	GUIName:	"Script"
	Win:	317
	CSMgr:	318
	DocExts:	319
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_Text_CreateInhaltsverzeichnis.ave\n'# Author:       Adrian Boehlen\n'# Date:         27.11.2022\n'# Version:      0.4\n'#\n'# Purpose:      Erstellt ein Inhaltsverzeichnis\n'#\n'#               under construction!\n'#\n'#########################################################################\n\n'# Variablen initialisieren\n\nfarbeStr = \"\"\ntitelFarbeStr = \"2103545\"          '# RGB-Wert der Titel\ntitelFarbe = Color.
Make\ntitelFarbe.SetRGBList({210,35,45})\ntheProject = av.GetProject\ntheDocList = theProject.GetDocs\ntheLayoutList = {}\ntheStringList = {}\n\nfor each theEntry in theDocList\n  if (theEntry.Is(Layout)) then\n    theLayoutList.Add(theEntry)\n  end\nend\n\n'########## Layout fuer Inhaltsverzeichnis festlegen ##########\n\nif (theLayoutList.Count=0) then\n  MsgBox.Error(\"There are no Layouts. You have to create Layouts first!\", \"\")\n  return nil\nelse\n  inhaltseite=MsgBox.List(theLayoutList, \"Layout fuer Inhaltsverzeichnis f
estlegen:\", \"Inhaltsverzeichnis\")\n  if (inhaltseite = nil) then \n    return nil\n  end\nend\n\n'tbd bestehender Inhalt loeschen\n'theGraphicsList = inhaltseite.GetGraphics\n'for each theGraphic in theGraphicsList\n'  theGraphicsList.RemoveGraphic(theGraphic)\n'end\n'inhaltseite.Invalidate\n\n'########## Titelinformationen ermitteln ##########\n\nfor each theLayout in theLayoutList\n  for each g in theLayout.GetGraphics\n    symb = g.GetSymbol\n    if (symb = nil) then\n      continue\n    end\n    rgb = symb.GetColor.GetRGBLi
st\n    for each farbe in rgb\n      farbeStr = farbeStr + farbe.AsString\n    end\n    if (farbeStr = titelFarbeStr) then\n      g.SetSelected(TRUE)\n      theString = g.GetText\n      theStringList.Add(theString)\n    end\n    farbeStr = \"\"\n  end\n  theGraphicsList = theLayout.GetGraphics\n  theGraphicsList.UnselectAll\n  theLayout.GetDisplay.Invalidate(true)\nend\n\n'########## Geometrie von Inhaltseite ermitteln ##########\n\n_theLayout = inhaltseite\nthePageDisplay = _theLayout.GetDisplay\nrecMargin = thePageDisplay.Retu
rnMarginExtent\ntheOrigin = recMargin.ReturnOrigin\nxOriginLeft = theOrigin.GetX\nxOriginRight = xOriginLeft + recMargin.GetWidth\nyOriginBottom = theOrigin.GetY\nyOriginTop = yOriginBottom + recMargin.GetHeight\n\n'########## Schriften definieren ##########\n\ntheSizeTitle = 22\ntheSizeText = 10\nschwarz = Color.GetBlack\ntextFont = Font.Make (_defaultValues.Get(\"schriftart\"), _defaultValues.Get(\"schriftschnitt\"))\n\n'########## Seitentitel platzieren ##########\n\ntextString = \"Inhaltsverzeichnis\"\ntextOrigin = (xOriginLe
ft + 0.01)@(yOriginTop - 0.5)\ntextSize = theSizeTitle\ntextColor = titelFarbe\n\nav.Run(\"LayoutTools.Sub_PlaceText\", {textFont, textString, textOrigin, textColor, textSize})\n\n'########## Inhaltsverzeichnis aufbauen ##########\n\ni = 0\nzeile = 0.6\nzeilenabst = 0.2\nfor each theString in theStringList\n  i = i + 1\n  '# Nummer\n  if (i Mod 2 <> 0) then\n    zeile = zeile + zeilenabst\n    textString = theString\n    textOrigin = (xOriginLeft + 0.01)@(yOriginTop - zeile)\n    textSize = theSizeText\n    textColor = schwarz\n
    av.Run(\"LayoutTools.Sub_PlaceText\", {textFont, textString, textOrigin, textColor, textSize})\n  '# zugehoeriger Titel\n  else\n    textString = theString\n    textOrigin = (xOriginLeft + 0.6)@(yOriginTop - zeile)\n    textSize = theSizeText\n    textColor = schwarz\n    av.Run(\"LayoutTools.Sub_PlaceText\", {textFont, textString, textOrigin, textColor, textSize})\n  end\nend\n\n_theLayout.Invalidate\n"
	SearchStr:	"_"
)

