(SEd.232
	Name:	"LayoutTools.General_SetDefaultValues"
	Creator:	"adrian"
	CreationDate:	"Son 27 Nov 2022 10:34:57 CET"
	GUIName:	"Script"
	Win:	233
	CSMgr:	234
	DocExts:	235
	Source:	"'##############################################################################\n'#\n'# Filename:     LayoutTools_General_SetDefaultValues.ave\n'# Author:       Adrian Boehlen\n'# Date:         31.01.2023\n'# Version:      1.2\n'#\n'# Purpose:      liest Defaultwerte aus default_values.dbf ein und speichert\n'#               sie im globalen Dictionary _defaultValues\n'#\n'#               wird auch im Editor verwendet\n'#\n'##############################################################################\n\nif (_defaultValue
s = nil) then\n  theVTab = av.Run(\"LayoutTools.Sub_ReadTable\", {\"Select Default Values Table\"})\nelse\n  return nil\nend\n\nif (theVTab = nil) then\n  MsgBox.Warning(\"No default values defined. Use 'def' to define them later.\", \"No default values\")\n  return nil\nend\n\n\ntheFields = theVTab.GetFields\n\n_defaultValues = Dictionary.Make(2)\n\nfor each rec in theVTab\n  for each feld in theFields\n    if (feld.AsString = \"Key\") then\n      theKey = theVTab.ReturnValue(feld, rec)\n    elseif (feld.AsString = \"Value\") then\n      
theValue = theVTab.ReturnValue(feld, rec)\n      if (theValue.IsNumber) then\n        theValue = theValue.AsNumber\n      end\n    else\n      MsgBox.Error(\"Wrong table structure. Please select the default values table.\", \"\")\n      return nil\n    end\n  end\n  _defaultValues.Add(theKey, theValue)\nend\n\n_schwarzC =         Color.GetBlack\n_schwarzHF =        Color.Make\n_schwarzHF.SetRGBList({1,1,1})\n"
)

