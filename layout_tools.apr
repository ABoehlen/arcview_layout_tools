(SEd.340
	Name:	"LayoutTools.Text_Silbentrennung"
	CreationDate:	"Freitag, 24. März 2017 10:08:24"
	GUIName:	"Script"
	Win:	341
	CSMgr:	342
	DocExts:	343
	Source:	"'######################################################################\n'#\n'# Filename:     LayoutTools_Text_Silbentrennung.ave\n'# Author:       Adrian Boehlen\n'# Date:         09.11.2018\n'# Version:      0.2\n'#\n'# Purpose:      einfacher Algorithmus zur Silbentrennung deutscher \n'#               Woerter\n'#               basiert auf Open-Script von:\n'#               http://www.wer-weiss-was.de/t/silbentrennung/544436/4\n'#\n'#               under construction!\n'#\n'#               erfordert:\n'#               -
 LayoutTools.Sub_IstIn\n'#\n'######################################################################\n\nwelchesWort = \"Donaudampfschifffahrskapitän\"\n\n'# Variablen initialisieren\nzeichenAnzahl = 0\ntrennenErlaubt = true\nz = \"\"\nz0 = \"\"\nz1 = \"\"\nv = \"\"\ntrennPositionen = {}\nistInR = false\n\nzeichenAnzahl = welchesWort.Count\n\nif (zeichenAnzahl > 2) then\n  trennenErlaubt = false\n  vokale = {\"a\",\"e\",\"i\",\"o\",\"u\",\"ä\",\"ü\",\"ö\"}\n  verbindungen = {\"sch\",\"ch\",\"ph\",\"ck\",\"pf\",\"br\",\"pl\",\"tr\",\"st\",\"gr\"}\n  trennungen = {\"-\",\"/\",\"\\\",\"
*\",\"#\",\";\",\".\",\"+\",\"=\",\")\",\"(\",\"&\",\"!\",\"?\",\",\",\":\",\" \",\"_\",\"~\"}\n  for each i in 2..(zeichenAnzahl - 1)\n    z0 = welchesWort.Middle((i - 1),1)\n    char = z0\n    liste = vokale\n    istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n    if ((trennenErlaubt = false) and (istInR = true)) then\n      trennenErlaubt = true\n    end\n    \n    if (trennenErlaubt = true) then\n      z = welchesWort.Middle(i,1)\n      z1 = welchesWort.Middle((i + 1),1)\n      v = z0 + z\n      if ((v = \"ch\") and (i > 2) and (welchesWort
.Middle((i - 2),1) = \"s\")) then\n        v = \"sch\"\n      end\n      liste = vokale\n      char = z1\n      istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n      if (istInR = true) then\n        char = z\n        istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n        if (istInR = false) then\n          liste = trennungen\n          istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n          if (istInR = false) then\n            char = z0\n            istInR = av.Run(\"LayoutTools.Sub_IstIn\", {cha
r, liste})\n            if (istInR = false) then\n              char = v\n              liste = verbindungen\n              istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n              if (istInR = true) then\n                trennPositionen.Add((i - (v.Count + 1)))\n              else\n                trennPositionen.Add(i)\n              end\n            end\n          end\n        end\n      end\n    end\n  end\nend\n\nfor each pos in trennPositionen\n  silbe = welchesWort.Left(pos)\n  rest = welchesWort.Middle(po
s,(welchesWort.Count - 2))\n  MsgBox.Info(silbe + \"-\" + NL + rest,\"Moegliche Trennungen\")\nend\n\n"
	SearchStr:	"_"
)

