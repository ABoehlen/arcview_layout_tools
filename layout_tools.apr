(SEd.236
	Name:	"LayoutTools.General_SetWorkingDirectory"
	Creator:	"adrian"
	CreationDate:	"Fre 02 Dez 2022 16:36:24 CET"
	GUIName:	"Script"
	Win:	237
	CSMgr:	238
	DocExts:	239
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_General_SetWorkingDirectory.ave\n'# Author:       Adrian Boehlen\n'# Date:         02.12.2022\n'# Version:      1.0\n'#\n'# Purpose:      Alternativ-Script zum standardmaessigen Dialog zum \n'#               Festlegen des Arbeitsverzeichnisses. Im Gegensatz\n'#               zu diesem kann das Verzeichnis im Dialog ausgewaehlt\n'#               und braucht nicht eingetippt zu werden.\n'#\n'######################
###################################################\n\ntheProject = av.GetProject\n\nnewDir = FileDialog.Put(\"   Select directory - not files\".AsFileName, \"*\",\"Set Working Directory \")\nif (newDir = nil) then\n  return nil\nend\n\nnewDir = newDir.ReturnDir\ntheProject.SetWorkDir(newDir)\n"
)

