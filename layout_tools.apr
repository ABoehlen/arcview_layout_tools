(SEd.252
	Name:	"LayoutTools.ImpExp_CreateODB"
	Creator:	"adrian"
	CreationDate:	"Son 08 Jan 2017 16:59:38 CET"
	GUIName:	"Script"
	Win:	253
	CSMgr:	254
	DocExts:	255
	Source:	"\n' NAME: mm_docODBCreate\n\n' HERKUNFT: Harald (neu auf Grundlage von FSA)\n\n' EINBINDUNG MTOOLS: Menueeintrag im Projektmenue (Label: Dokumentauswahl exportieren (ODB))\n\n' HILFE: Oeffnet eine Auswahlliste zur Speicherung von Dokumenten in einem einzelnen ODB-File  (s. STRG-Klick Info)\n\n'*******************************************\n\n' CTRL-KLICK Info (erscheint, wenn das Skript bei gedrueckter Strg- bzw. Ctrl-Taste aufgerufen wird)\n \nif (System.IsControlKeyDown) then\n\n  message =  \" \"+nl+\n    \n    \"SCRIPTNAME: 
   mm_DocODBCreate \"+nl+nl+\n  \n    \"ORIGIN:   Harald (new on FSA Basis). \"+nl+nl+\n    \n    \"Opens a MultiList to write the selected documents to a single ODB file.\"+nl+nl+\n    \n    \"The dependencies of the project (as e.g. extensions) will be listet to annotate them \"+\n    \"in the ODB if desired. In this case they are loaded automatically when the ODB is imported into a blanc project. \"+\n    \"If you don't feel safe upon what extensions your ODB is dependent, it is advisable, to add all obligatory \"+\n    \"ex
tensions of the project at least (find them labeld with ''- fix -'' in the dialog box or with a transparent \"+\n    \"check in the extensions dialog. Extensions that are not obligatory (that you can unload) are labeled with \"+\n    \"''- lax -'' in the dialog box. If the ODB to export contains a grid for example, Spatial- or 3D Analyst are \"+\n    \"obligatory.\"+nl+nl+\n    \n    \"The string  '$'  inheres a split function in this script. Documents, with names containing this sign \"+\n    \"can not be exported. Rename
 this documents or change the split string in the system script called \"+\n    \"''mm_docODBCreate''. \"+nl\n    \n  msgbox.report(message,\"INFO: Export Documents (*.ODB) ...\")\n  \n  return nil\nend\n\n'-------------------------------------------------------\n\ntheProject = av.GetProject\n\nif (theProject = NIL) then\n  return NIL\nend\n\n'-------------------------------------------------------------------------------\n' CREATE DOCLIST \n\ntheDocList = List.Make\n\nfor each d in theProject.GetDocs\n  if (d.Is(Layout)) then  \n    
theGUIString = d.GetGUI\n    theLString = theGUIString.UCase+\" :  \"+d.AsString\n    theDocList.Add(theLString)\n  end\nend\n\nif (theDocList.count = 0) then\n  MsgBox.Info(\"No Docs to be found...\",\"\")\n  return NIL\nend\n\ntheDocList.sort(TRUE)\n\n'-------------------------------------------------------------------------------\n' LET THE USER CHOOSE\n\ntheSelDocs = MsgBox.MultiListAsString(theDocList, \"Select documents to write to the ODB file: \"+\n             \"\", \" Write Docs to ODB\")\n\n\nif ((theSelDocs = NIL) or (theSelDo
cs.Count = 0)) then return NIL end\n\n\n'-------------------------------------------------------------------------------\n' CREATE ODB-FILE, ASK FOR NAME AND PATH, CWD AND \"Docs\" AS DEFAULT\n\ntheCWD = FileName.getCWD\n\nif (File.isWritable(theCWD).not) then\n  av.GetProject.GetWorkDIR.setCWD\n  theCWD = FileName.getCWD\nend\n  \ndefaultName = FileName.Make(theCWD.AsString).MakeTmp(\"Docs\", \"odb\")\ntheDocODB = FileDialog.Put(defaultName, \"*.odb\", \" Save ODB-File as\")\n\nif (theDocODB = NIL) then\n  return NIL\nend\n\ntheODBFile
 = ODB.Make(theDocODB)\n\n'-------------------------------------------------------------------------------\n' ASK FOR DEPENDENCIES\n\ntheProjDepends = av.GetProject.GetDependencies\n\nif (theProjDepends.count > 0) then\n\n  dctExts = Extension.GetExplicitExtensions\n  \n  theExt = {}\n  \n  for each oKey in dctExts.ReturnKeys\n    if (dctExts.Get(oKey).CanUnload.not) then\n      theExt.Add(oKey+\" (- fix -)\")\n    end\n  end\n  \n\n  for each fKey in dctExts.ReturnKeys\n    if (fKey <> \"Memo Tools 6.5  (English)\") then\n      if 
(dctExts.Get(fKey).CanUnload) then\n        theExt.Add(fKey+\" (- lax -)\")\n      end\n    end\n  end\n\n  if (theExt.count > 0) then\n    theODBDepends = Msgbox.multiListAsString(theExt,\"Select extensions that should be loaded when the ODB will be imported  (OK to empty List = None):\",\" Extensions of the Project\")\n  \n    if (theOdbDepends = NIL) then\n      return NIL\n    end\n    \n    theFileNames = List.Make\n    for each E in theODBDepends\n      sExt = E\n      theExt = dctExts.Get(sExt.Left(sExt.count-10))\n      t
heFN = theExt.GetFileName\n      theFileNames.Add(theFN)\n    end\n    \n    theODBDependencies = theODBFile.getDependencies\n  \n    for each dep in theFileNames\n      theODBDependencies.Add(dep)\n    end\n  end\nend\n\n'msgbox.multilistasstring(theODBDependencies,\"\",\"ODB-Depp\")\n  \n'-------------------------------------------------------------------------------\n' WE'VE TAKEN THE DOC-GUIS IN THE LINE FOR CLARITY; NOW WE HAVE TO SPLIT THE LINE\n' AND CREATE A SPLITSIGN '$' FOR THIS PURPOSE. CONSEQUENTIAL NO DOCS WITH TH
AT SIGN COULD\n' BE EXPORTED... LOOK IF WE FIND SUCH DOCS AND SHOW IF WE HAD SUCCEEDED\n\ntheSelDokList = List.Make\ntheUnableList = List.Make\n\nfor each selDok in theSelDocs\n  if (selDok.AsString.contains(\"$\")) then\n    theUnableList.Add(selDok)\n  end\n  theSplit = selDok.Substitute(\" :  \",\"$\")\n  theSplit = theSplit.AsTokens(\"$\")\n  for each selDokString in theSplit\n    theSelDokList.Add(selDokString)\n  end\nend\n\n'-------------------------------------------------------------------------------\n' ODB MIT LISTE FUELL
EN\n\nfor each d in theSelDokList\n  theClose = theProject.FindDoc(d)\n  if (theClose = NIL) then continue end\n  theODBFile.Add(theClose)\nend\n\n'-------------------------------------------------------------------------------\n' COMMIT UND SCHREIBEN\n\ntheODBFile.Commit\n\nif (theODBFile.Commit = FALSE) then\n  MsgBox.Info(\"Could not commit...\",\"\")\n  return NIL\nend\n\ntheDocsCount = theODBFile.Count\n\n'-------------------------------------------------------------------------------\n' GIVE SOME INFOS IN THE STATUS BAR\n\nif (
theDocsCount <> 1) then\n  MsgBox.Info (\"Written \"+theDocsCount.AsString + \" Documents to  ''\"+theDocODB.AsString +\"''\", \"ODB-File\")\n  av.showMSG(\"llll llll llll llll llll   llll llll llll    Written \"+theDocsCount.AsString + \" documents to  ''\"+theDocODB.AsString +\"''\")\nelse\n  MsgBox.Info (\"Written \"+theDocsCount.AsString + \" Document to  ''\"+theDocODB.AsString +\"''\", \"ODB-File\")\n  av.showMSG(\"llll llll llll llll llll   llll llll llll    Written \"+theDocsCount.AsString + \" document to  ''\"+theDocODB.AsStrin
g +\"''\")\nend\n\nif (theUnableList.count > 0) then\n  MsgBox.Info(\"The string  '$'  inheres a split function in the 'Sort'  part of this script. \"+theUnableList.count.AsString+\" Doc(s) \"+\n  \"named using this string could not be processed.\",\"\")\nend\n\n'-------------------------------------------------------------------------------\n\n' END OF FILE\n\n"
)

