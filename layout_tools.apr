(SEd.356
	Name:	"LayoutTools.View_ZoomToExportview"
	Creator:	"adrian"
	CreationDate:	"Sam 07 Jan 2017 11:10:31 CET"
	GUIName:	"Script"
	Win:	357
	CSMgr:	358
	DocExts:	359
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_View_ZoomToExportview.ave\n'# Author:       Adrian Boehlen\n'# Date:         06.11.2022\n'# Version:      0.2\n'#\n'# Purpose:      Die Laufweite von Text aendert je nach Schriftart und \n'#               Zoomstufe, daher ist es mitunter schwierig abzuschaetzen,  \n'#               wie das exportierte Layout aussehen wird. Diese Funktion \n'#               zoomt in eine Zoomstufe, in der die Anzeige ziemlich \n
'#               genau der spaeteren Ausgabe entspricht.\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Info(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\ntheLayout.GetDisplay.ZoomToActual\ntheLayout.GetDisplay.ZoomIn(300)"
)

