(SEd.22
	Name:	"Ext_Inst"
	Creator:	"adrian"
	CreationDate:	"Sam 25 Okt 2014 16:18:59 CEST"
	GUIName:	"Script"
	Win:	23
	CSMgr:	24
	DocExts:	25
	Source:	"'#########################################################################\n'#\n'# Filename:     Ext_Inst.ave\n'# Author:       Adrian Boehlen\n'# Date:         03.11.2022\n'# Version:      1.0\n'#\n'# Purpose:      installiert die Extension \n'#\n'#########################################################################\n\nif (av.GetProject = nil) then\n  return nil\nend\n\nSack = Self '# Der 'Sack' vom makescript, wo alles Benoetigte drin ist\n\nSchaltflaeche = Sack.Get(0)\nviewGUI = av.GetProject.FindGUI( \"Layout\" )\nif (v
iewGUI <> nil) then\n  '# pruefen, ob die Schaltflaeche schon existiert\n  if(viewGUI.GetButtonBar.findbyscript(Schaltflaeche.getclick) = nil) then\n    '# Schaltflaeche an der 2. Stelle einfügen\n    viewGUI.GetButtonBar.Add(Schaltflaeche, 2)\n  end\nend\n\nav.GetProject.AddDialog(Sack.Get(1)) '# 1. Dialog hinzufuegen\nav.GetProject.AddDialog(Sack.Get(2)) '# 2. Dialog hinzufuegen\n"
)

(DocWin.23
	Owner:	22
	X:	556
	Y:	135
	W:	748
	H:	506
)

(CSMgr.24
)

(DocAct.25
	Doc:	22
)

(SEd.26
	Name:	"Ext_Make"
	Creator:	"adrian"
	CreationDate:	"Sam 25 Okt 2014 16:20:37 CEST"
	GUIName:	"Script"
	Win:	27
	CSMgr:	28
	DocExts:	29
	Source:	"'#########################################################################\n'#\n'# Filename:     Ext_Make.ave\n'# Author:       Adrian Boehlen\n'# Date:         27.11.2022\n'# Version:      1.0\n'#\n'# Purpose:      erstellt die Extension\n'#               Zum Erstellen der Extension NUR dieses Script ausfuehren\n'#\n'#########################################################################\n\nLayoutTools = Extension.Make(\"$AVHOME\\projects\\layout_tools\\LayoutTools.avx\".AsFileName,\n\"LayoutTools\",av.FindScript(\"Ext_inst\"
),av.FindScript(\"Ext_unin\"), {\"$AVBIN/avdlog.dll\".AsFileName})\n\nLayoutTools.SetExtVersion(1)\n\n'# Beschreibung (Version jeweils anpassen)\nLayoutTools.SetAbout(\"LayoutTools Toolbar (v2.1) \")\n\nLayoutTools.SetUnloadScript(av.FindScript(\"ext_unload\"))\n\n'# Schaltflaeche und Dialoge hinzufuegen\nSchaltflaeche=( av.FindGUI( \"Layout\").GetButtonBar.findbyscript(\"LayoutTools.start\"))  \nLayoutToolsDialog = av.FindDialog(\"LayoutTools\")\nSatzspiegelDialog = av.FindDialog(\"Satzspiegel\")\nDefaultValues = av.FindScript(\"Defaul
tValues\")\nLayoutTools.Add( Schaltflaeche)\nLayoutTools.Add(LayoutToolsDialog)\nLayoutTools.Add(SatzspiegelDialog)\n\nfor each aDoc in av.GetProject.GetDocs\n  if (aDoc.Is(SEd)) then\n    if (aDoc.GetName.Contains(\"LayoutTools.\")) then\n      if (aDoc.IsCompiled.Not) then\n        aDoc.Compile\n      end\n      LayoutTools.Add(av.FindScript(aDoc.GetName))\n    end\n  end\nend\n\nLayoutTools.Commit\n\n"
	SearchStr:	"MeineExtension"
)

(DocWin.27
	Owner:	26
	X:	385
	W:	924
	H:	600
)

(CSMgr.28
)

(DocAct.29
	Doc:	26
)

(SEd.30
	Name:	"Ext_Unin"
	Creator:	"adrian"
	CreationDate:	"Sam 25 Okt 2014 16:20:54 CEST"
	GUIName:	"Script"
	Win:	31
	CSMgr:	32
	DocExts:	33
	Source:	"'#########################################################################\n'#\n'# Filename:     Ext_Unin.ave\n'# Author:       Adrian Boehlen\n'# Date:         03.11.2022\n'# Version:      1.0\n'#\n'# Purpose:      entfernt die Komponenten beim Deaktivieren der Extension \n'#\n'#########################################################################\n\nif (av.GetProject = nil) then\n  return nil\nend\n\nif (av.GetProject.IsClosing) then\n  return nil\nend\n\nlayoutGUI = av.GetProject.FindGUI( \"Layout\" )\n\n'# Schaltflaeche un
d Dialoge entfernen\nlayoutGUI.GetButtonBar.Remove(layoutGUI.GetButtonBar.FindByScript( \"LayoutTools.start\"))\nav.GetProject.removedialog(\"LayoutTools\")\nav.GetProject.removedialog(\"Satzspiegel\")"
)

