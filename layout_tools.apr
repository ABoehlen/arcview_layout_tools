(SEd.344
	Name:	"LayoutTools.View_RefreshLayout"
	Creator:	"adrian"
	CreationDate:	"Mon 27 Apr 2015 20:11:41 CEST"
	GUIName:	"Script"
	Win:	345
	CSMgr:	346
	DocExts:	347
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_View_RefreshLayout.ave\n'# Author:       Adrian Boehlen\n'# Date:         21.12.2022\n'# Version:      1.0\n'#\n'# Purpose:      Erzwingt einen Neuaufbau des Layouts durch mehrfaches\n'#               ZoomIn und ZoomOut\n'#\n'#########################################################################\n\n\ntheLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Info(\"Start this script from an active
 Layout.\",\"\")\n  return nil\nend\n\ntheLayout.GetDisplay.ZoomIn(110)\ntheLayout.GetDisplay.ZoomOut(111)\ntheLayout.GetDisplay.ZoomIn(111)\ntheLayout.GetDisplay.ZoomOut(110)\n"
)

