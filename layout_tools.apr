(SEd.260
	Name:	"LayoutTools.Sel_Delete"
	Creator:	"adrian"
	CreationDate:	"Son 04 Dez 2022 11:51:36 CET"
	GUIName:	"Script"
	Win:	261
	CSMgr:	262
	DocExts:	263
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_Sel_Delete.ave\n'# Author:       Adrian Boehlen\n'# Date:         04.12.2022\n'# Version:      1.0\n'#\n'# Purpose:      loescht selektierte Elemente im Layout\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\nif (theLayout.GetGraphics
.HasSelected) then\n  if (MsgBox.YesNo(\"Are you sure?\", \"Delete features?\", true)) then\n    av.GetProject.SetModified(true)\n    theLayout.GetGraphics.ClearSelected\n  else\n    return nil\n  end\nelse\n  MsgBox.Info(\"No selected features to delete.\",\"\")\nend\n"
)

