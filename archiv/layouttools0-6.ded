(SEd.179
	Name:	"LayoutTools.HeaderAndFooter"
	Creator:	"adrian"
	CreationDate:	"Mon 20 Apr 2015 19:59:04 CEST"
	GUIName:	"Script"
	Win:	180
	CSMgr:	181
	DocExts:	182
	Source:	"'# Name:          LayoutTools.HeaderAndFooter \n'#                lyt_head.ave\n'# Author:        Mike Quentel <mquentel@acceleration.net>,\n'#                 <kingofthewood@yahoo.com>\n'# Date:          Fri Dec 10 15:28:27 1999\n'# Revised by:    Adrian Boehlen\n'# Revision Date: 26/04/2015\n'# Purpose:       Creates header (optional) and footer\n'#\n'###################################################################\n\nlytActive = av.GetActiveDoc\nif ((lytActive.is(Layout)) and (lytActive.GetClass.GetClassName <> \"
DialogEditor\")) then\n  thePageDisplay = lytActive.GetDisplay\n  thePageExtent = thePageDisplay.ReturnPageExtent\n  theCenter = thePageExtent.ReturnCenter\n  recMargin = thePageDisplay.ReturnMarginExtent\n  theOrigin = recMargin.ReturnOrigin\n  xOriginLeft = theOrigin.GetX\n  xOriginCenter = theCenter.GetX\n  xOriginRight = xOriginLeft + recMargin.GetWidth\n  yOriginBottom = theOrigin.GetY\n  yOriginTop = yOriginBottom + recMargin.GetHeight\n   \n  '# creates origins for graphic text (anchor points left)\n  docOrigin = 
(xOriginLeft + 0.01)@(yOriginBottom + 0.05)\n  userOrigin = (xOriginCenter)@(yOriginBottom + 0.05)\n  pageOrigin = (xOriginRight - 0.01)@(yOriginBottom + 0.05)\n  \n  headLeftOrigin = (xOriginLeft + 0.01)@(yOriginTop - 0.12)\n  headRightOrigin = (xOriginRight - 0.01)@(yOriginTop - 0.12)\n  \n  '# creates names strings for graphic text  \n  strAprName = av.GetProject.GetName\n  strLytName = lytActive.GetWin.GetTitle\n  fnUserName = (\"$AVEXT/user_name.odb\").AsFileName\n  \n  strUserName = MsgBox.Input (\"Name des Autors e
ingeben\",\"Autor\",\"Adrian Böhlen\")\n  \n  strDoc = MsgBox.YesNo (\"Layoutname an Projektname anfügen?\",\"Dokument\",true)\n  if (strDoc) then\n    strDoc = strAprName + \"/\" + strLytName\n  else\n    strDoc = strAprName\n  end\n  strUser = strUserName\n  strPage = MsgBox.Input (\"Seitenzahl eingeben\", \"Seitenzahl\", \"1\")\n  \n  '# defines header (optional)\n  if (MsgBox.YesNo(\"Kopfzeile definieren ?\",\"Header\",true)) then\n    strHeadLeft = MsgBox.Input(\"Text links oben eingeben:\",\n    \"Kopfzeile links\",\" \")\n    strHeadRight = 
MsgBox.Input(\"Text rechts oben eingeben:\",\n    \"Kopfzeile rechts\",\" \")\n  else\n    strHeadLeft = nil\n    strHeadRight = nil\n  end\n  \n  '# creates, adjusts and adds graphic text to layout\n  theSizeFooter = 10\n  theSizeHeader = 14\n  theColor = Color.GetBlack\n  theFont = Font.Make (\"DejaVu Sans\", \"Condensed\")\n\n  gtxDoc = GraphicText.Make (strDoc, docOrigin)  \n  gtxUser = GraphicText.Make (strUser, userOrigin)\n  gtxPage = GraphicText.Make (strPage, pageOrigin)\n  \n  if (strHeadLeft <> nil) then\n    gtxHeadLeft = 
GraphicText.Make (strHeadLeft, headLeftOrigin)\n  end\n  if (strHeadRight <> nil) then\n    gtxHeadRight = GraphicText.Make (strHeadRight, headRightOrigin)\n  end\n  \n  txtSymDoc = gtxDoc.ReturnSymbols.Get (0)\n  txtSymDoc.SetSize (theSizeFooter)\n  txtSymDoc.SetColor(theColor)\n  txtSymDoc.SetFont (theFont)\n\n  txtSymUser = gtxUser.ReturnSymbols.Get (0)\n  txtSymUser.SetSize (theSizeFooter)\n  txtSymUser.SetFont (theFont)\n    \n  txtSymPage = gtxPage.ReturnSymbols.Get (0)\n  txtSymPage.SetSize (theSizeFooter)\n  txtSymP
age.SetFont (theFont)\n  \n  if (strHeadLeft <> nil) then\n    textSymHeadLeft = gtxHeadLeft.ReturnSymbols.Get (0)\n    textSymHeadLeft.SetSize (theSizeHeader)\n    textSymHeadLeft.SetColor(theColor)\n    textSymHeadLeft.SetFont (theFont)\n  end\n  if (strHeadRight <> nil) then\n    textSymHeadRight = gtxHeadRight.ReturnSymbols.Get (0)\n    textSymHeadRight.SetSize (theSizeHeader)\n    textSymHeadRight.SetFont (theFont)\n  end\n  \n  lytActive.GetGraphics.Add (gtxDoc)\n  lytActive.GetGraphics.Add (gtxUser)\n  lytActive.Get
Graphics.Add (gtxPage)\n  \n  if (strHeadLeft <> nil) then\n    lytActive.GetGraphics.Add (gtxHeadLeft)\n  end\n  \n  if (strHeadRight <> nil) then\n    lytActive.GetGraphics.Add (gtxHeadRight)\n  end\n  theGraphicList = lytActive.GetGraphics\n  \n  '# replace user name with simulated anchor point middle\n  userOrigin = (xOriginCenter - (gtxUser.GetExtent.GetX / 2))@(yOriginBottom + 0.05)\n  theGraphicList.RemoveGraphic(gtxUser)\n  gtxUser = GraphicText.Make (strUser, userOrigin)\n  txtSymUser = gtxUser.ReturnSymbols.Get 
(0)\n  txtSymUser.SetSize (theSizeFooter)\n  txtSymUser.SetColor(theColor)\n  txtSymUser.SetFont (theFont)\n  lytActive.GetGraphics.Add (gtxUser)\n  \n  '# replace page number with simulated anchor point right\n  pageOrigin = (xOriginRight - gtxPage.GetExtent.GetX)@(yOriginBottom + 0.05)\n  theGraphicList.RemoveGraphic(gtxPage)\n  gtxPage = GraphicText.Make (strPage, pageOrigin)\n  txtSymPage = gtxPage.ReturnSymbols.Get (0)\n  txtSymPage.SetSize (theSizeFooter)\n  txtSymPage.SetColor(theColor)\n  txtSymPage.SetFont (the
Font)\n  lytActive.GetGraphics.Add (gtxPage)\n  \n  '# replace right header with simulated anchor point right\n  if (strHeadRight <> nil) then\n    headRightOrigin = (xOriginRight - gtxHeadRight.GetExtent.GetX)@(yOriginTop - 0.12)\n    theGraphicList.RemoveGraphic(gtxHeadRight)\n    gtxHeadRight = GraphicText.Make (strHeadRight, headRightOrigin)\n    textSymHeadRight = gtxHeadRight.ReturnSymbols.Get (0)\n    textSymHeadRight.SetSize (theSizeHeader)\n    textSymHeadRight.SetColor(theColor)\n    textSymHeadRight.SetFont
 (theFont)\n    lytActive.GetGraphics.Add (gtxHeadRight)\n  end\n\nelse\n  MsgBox.Warning (\"This script is meant for an Active Layout only.  Exiting.\",\"\")\n  exit\nend  \n"
	SearchStr:	"strLytName"
)

