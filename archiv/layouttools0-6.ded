(SEd.167
	Name:	"LayoutTools.DrawHorizontalLine"
	Creator:	"adrian"
	CreationDate:	"Die 12 Mai 2015 19:47:25 CEST"
	GUIName:	"Script"
	Win:	168
	CSMgr:	169
	DocExts:	170
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_DrawHorizontalLine.ave\n'# Author:       Adrian Boehlen\n'# Date:         12.05.2015\n'# Version:      0.1\n'#\n'# Purpose:      Zieht horizontale Hilfslinie am Clickpunkt\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc  \n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this tool from an active Layout.\",\"\")\n  return nil\nend\n\n'# Layout-Geo
metrie ermitteln\nthePageDisplay = av.GetActiveDoc.GetDisplay\nrecMargin = thePageDisplay.ReturnMarginExtent\ntheOrigin = recMargin.ReturnOrigin\nxOriginLeft = theOrigin.GetX\nxOriginRight = xOriginLeft + recMargin.GetWidth\n\n'# horizontale Linie aus Clickpunkt ableiten\npt = theLayout.GetDisplay.ReturnUserPoint\n\nxL = xOriginLeft - 1\nyL = pt.GetY\nxR = xOriginRight + 1\nyR = pt.GetY\n\n'# Strichstil definieren\nthePen = BasicPen.Make\ntheColor = Color.Make\ntheColor.SetRGBList({240,40,200})\nthePen.SetColor(theColor)\ntheP
en.SetSize(0.5)\n\n'# Linie zeichnen\ntheLine = Line.Make( xL@yL, xR@yR)\ntheGraphicLine = GraphicShape.Make(theLine)\ntheGraphicLine.SetSymbol(thePen)\n\ntheLayout.GetGraphics.UnselectAll\ntheGraphicLine.SetSelected(TRUE)\ntheLayout.GetGraphics.Add(theGraphicLine)\nav.GetProject.SetModified(TRUE)\n"
	SearchStr:	"aPen"
)

