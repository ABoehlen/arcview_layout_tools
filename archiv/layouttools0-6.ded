(SEd.183
	Name:	"LayoutTools.ImportText"
	Creator:	"adrian"
	CreationDate:	"Son 03 Mai 2015 15:24:59 CEST"
	GUIName:	"Script"
	Win:	184
	CSMgr:	185
	DocExts:	186
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_TextFormatter.ave\n'# Author:       Adrian Boehlen\n'# Date:         07.05.2015\n'# Version:      0.2\n'#\n'# Purpose:      Liest Textfile ein und bildet daraus einen Textblock\n'#               der definierten Anzahl Zeichen\n'#               Schriftart, -groesse und -farbe muesse definiert werden\n'#\n'#               erwartet eine leere, selektierte Textbox im Layout,\n'#               an der Stelle, wo dann 
der neue Text erscheinen soll\n'#\n'# Based on:     Aho, Kernighan, Weinberger:\n'#               The AWK Programming Language, 1988; S. 120\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc \n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\n'########## Benutzereingaben aufnehmen ###################################\n\ntheFile = FileDialog.Show(\"*.txt\",\"text files\",\"Textdatei auswaehlen\")\ni
f (theFile = nil) then\n  return nil\nend\n\n'# Maximale Anzahl Zeichen pro Zeile definieren\nmaxLength = MsgBox.Input(\"Maximale Anzahl Zeichen pro Zeile eingeben\",\n  \"Anzahl Zeichen\",50.AsString)\n\nif (maxLength = nil) then\n  return nil\nelseif (maxLength.IsNumber.Not) then\n  MsgBox.Warning(\"Ungueltige Eingabe\",\"Abbruch\")\n  return nil\nend\nmaxLength = maxLength.AsNumber\n\n'# Schriftart definieren\nschriftartListe = {\"Arial\", \"DejaVu Sans\", \"DejaVu Sans Mono\", \"DejaVu Serif\", \"Courier New\"}\nschriftart = MsgBox.ListAs
String(schriftartListe, \"Schriftart auswaehlen\", \"Schriftart\")\nif (schriftart = nil) then \n  return nil\nend\n\n'# Schriftschnitt definieren\nif (schriftart = \"Arial\") then\n  schriftschnittListe = {\"Standard\", \"Kursiv\", \"Fett\", \"Fett Kursiv\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nelseif (schriftart = \"DejaVu Sans\") then\n  schriftschnittListe = {\"Book\", \"Bold\", \"Condensed\", \"Condensed Bold\"
, \"Condensed Oblique\", \"Condensed Bold Oblique\", \"Oblique\", \"Bold Oblique\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nelseif (schriftart = \"DejaVu Sans Mono\") then\n  schriftschnittListe = {\"Book\", \"Bold\", \"Oblique\", \"Bold Oblique\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  en
d\nelseif (schriftart = \"DejaVu Serif\") then\n  schriftschnittListe = {\"Book\", \"Bold\", \"Condensed\", \"Condensed Bold\", \"Condensed Italic\", \"Condensed Bold Italic\", \"Italic\", \"Bold Italic\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nelseif (schriftart = \"Courier New\") then\n  schriftschnittListe = {\"Standard\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen
\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nend\n\n'# Schriftfarbe definieren\ntheColorList = {\"Schwarz\", \"Grau\", \"Rot\", \"Gruen\", \"Blau\", \"benutzerdefiniert\"}\ntheColor = MsgBox.ListAsString(theColorList, \"Schriftfarbe auswaehlen\", \"Schriftfarbe\")\nif (theColor = nil) then \n  return nil\nelseif (theColor = \"benutzerdefiniert\") then\n  theRGB = MsgBox.MultiInput(\"RGB-Wert definieren\", \"RGB\",\n  {\"Rot\", \"Gruen\", \"Blau\"}, {\"0\", \"0\", \"0\"})\n  if (theRGB = nil) then\n    return nil\n  end\n  
rot = theRGB.Get(0)\n  gruen = theRGB.Get(1)\n  blau = theRGB.Get(2)\nend\n\n'# Schriftgroesse definieren\ntheSize = MsgBox.Input(\"Schriftgroesse eingeben\", \"Schriftgroesse\",10.AsString)\n\nif (theSize = nil) then\n  return nil\nelseif (theSize.IsNumber.Not) then\n  MsgBox.Warning(\"Ungueltige Eingabe\",\"Abbruch\")\n  return nil\nend\ntheSize = theSize.AsNumber\n\n'########## Text einlesen, formatieren, symbolisieren und platzieren #####\n\n'# LineFile erzeugen und Anzahl Zeilen ermitteln\ntheLineFile = LineFile.Make(theFile,#FI
LE_PERM_READ)\nelementCount = theLineFile.GetSize\n\n'# Variablen initialisieren\ntheTextBlock = \"\"\ntheNewLine = \"\"\nschriftart = Font.Make (schriftart, schriftschnitt)\nif (theColor = \"Schwarz\") then\n  theColor = Color.GetBlack\nelseif (theColor = \"Grau\") then\n  theColor = Color.GetGray\nelseif (theColor = \"Rot\") then\n  theColor = Color.GetRed\nelseif (theColor = \"Gruen\") then\n  theColor = Color.GetGreen\nelseif (theColor = \"Blau\") then\n  theColor = Color.GetBlue\nelseif (theColor = \"benutzerdefiniert\") then\n  theCol
or = Color.Make\n  theColor.SetRGBList({rot.AsNumber,gruen.AsNumber,blau.AsNumber})\nend\n\n'# Input-Text in neue Zeilen der gewuenschten Laenge umformatieren\nfor each i in 1..elementCount                                '# zeilenweise durchgehen\n  theLine = theLineFile.ReadElt                              '# aktuelle Zeile\n  if (theLine.Count > 0) then                                '# alle nicht leeren Zeilen\n    for each word in theLine.AsList                          '# Zeile in Woerter auftrennen\n      if (
theNewLine.Count + word.Count > maxLength) then    '# wenn laenger als maxLength Zeichen...\n        theTextBlock = theTextBlock + theNewLine + 10.AsChar '# ...setze an Textblock an und schliesse mit Newline ab\n        theNewLine = \"\"                                      '# temporaere Zeile loeschen\n      end\n      theNewLine = theNewLine ++ word                        '# Woerter zu temporaeren Zeilen zusammensetzen\n    end\n  else                                                       '# alle leeren Zeilen\n  
  if (theNewLine.Count > 0) then                           '# wenn temporaere Zeile nicht leer ist... \n      theTextBlock = theTextBlock + theNewLine + 10.AsChar   '# ...setze an Textblock an und schliesse mit Newline ab\n      theNewLine = \"\"                                        '# temporaere Zeile loeschen\n    end\n    theTextBlock = theTextBlock + 10.AsChar                  '# wenn temporaere Zeile nicht leer ist, schliesse mit Newline ab\n  end\nend   \ntheTextBlock = theTextBlock + theNewLine + 10.AsChar 
        '# fuege Rest der letzten Zeile noch an\n\ntheLineFile.Close\n\n'# Text symbolisieren und in Layout platzieren\ntheGraphicList = theLayout.GetGraphics\ntheSelected = theGraphicList.GetSelected.Get(0)\ntheOrigin = theSelected.GetOrigin\ntheGraphicText = GraphicText.Make (theTextBlock, theOrigin)\n\ntheSymbol = theGraphicText.ReturnSymbols.Get (0)\ntheSymbol.SetColor(theColor)\ntheSymbol.SetFont(schriftart)\ntheSymbol.SetSize(theSize)\n\ntheLayout.GetGraphics.Add (theGraphicText)\ntheGraphicList.RemoveGraphic (theSel
ected)\n\ntheLayout.Invalidate\n"
	SearchStr:	"theTF"
)

