)

(Script.96
	Name:	"LayoutTools.start"
	SourceCode:	"av.getproject.finddialog(\"LayoutTools\").open"
)

(Script.97
	Name:	"LayoutTools.Sub_DefaultValues"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools.Sub_DefaultValues.ave\n'# Author:       Adrian Boehlen\n'# Date:         09.11.2018\n'# Version:      0.3\n'#\n'# Purpose:      legt Defaultwerte fest\n'#\n'#########################################################################\n\n_abstList =         5                '# Abstand zwischen Aufzaehlungszeichen und Text\n_autor =            \"Adrian Böhlen\"\n_breiteTextbl =     125\n_bullet =           150           
   '# ASCII-Code fuer Halbgeviertstrich\n_groesseFusszeile = 8\n_groesseKopfzeile = 14\n_schriftart =       \"DejaVu Sans\"\n_schriftgroesse =   10\n_schriftschnitt =   \"Condensed\"\n_seitenhoehe =      297\n_seitenbreite =     210\n_schwarzT =         \"Black\"\n_schwarzC =         Color.GetBlack\n_schwarzHF =        Color.Make\n_schwarzHF.SetRGBList({1,1,1})\n"
)

(Script.98
	Name:	"LayoutTools.Sub_IstIn"
	SourceCode:	"'######################################################################\n'#\n'# Filename:     LayoutTools.Sub_IstIn.ave\n'# Author:       Adrian Boehlen\n'# Date:         09.11.2018\n'# Version:      0.2\n'#\n'# Purpose:      prueft, ob ein bestimmter Wert (1. Argument) in \n'#               der angegebenen Liste (2. Argument) enthalten ist\n'#               und setzt in diesem Fall die Variable istInR auf true\n'#\n'######################################################################\n\n\nistInR = false\nfor each i in 
Self.Get(1)\n  if (i = Self.Get(0)) then\n    istInR = true\n  end\nend    \nreturn istInR"
)

(Script.99
	Name:	"LayoutTools.Sub_OrderedList"
	SourceCode:	"'######################################################################\n'#\n'# Filename:     LayoutTools.Sub_OrderedList.ave\n'# Author:       Adrian Boehlen\n'# Date:         15.01.2019\n'# Version:      0.2\n'#\n'# Purpose:      erzeugt eine geordnete Liste\n'#\n'######################################################################\n\nanzMark = 0\nchar = 0\nzeile = 0\ntheMarksTmp = \"\"\ntheString = Self.Get(0)                                       '# Textblock uebernehmen\n_theMarks = av.Run(\"LayoutTools.Sub_SubstituteA
ll\", {theString, \"OL\"})  '# alle Zeichen ausser ¬ loeschen und neuer Variable zuweisen\n\nfor each char in _theMarks.AsTokens(NL)                       '# Textblock, welcher nur ¬ enthaelt, durchgehen \n  zeile = zeile + 1                                           '# Zeilen zaehlen\n  if (char.Contains(\"¬\")) then\n    anzMark = anzMark + 1                                     '# \"Listenzeichen zaehlen\n    '# Listenzeichen durch aufsteigende Werte ersetzen und einen Punkt dahinter ergaenzen\n    theMarksTmp = theMa
rksTmp + char.Substitute(\"¬\", anzMark.AsString + \".\")\n    if (zeile <> _theMarks.AsTokens(NL).Count) then           '# ausser wenn die Ersetzung die letzte Zeile ist...\n      theMarksTmp = theMarksTmp + NL                          '# ...nach jeder Ersetzung ein Zeilenvorschub einfuegen\n    end\n  '# bei Zeilen, die Leerzeichen (32) enthalten, einen Zeilenvorschub setzen, ausser bei der letzten\n  elseif (char.Contains(32.AsChar) and (zeile < _theMarks.AsTokens(NL).Count)) then\n    theMarksTmp = theMarksTmp + 
NL\n  end\nend\n\n_theMarks = theMarksTmp                                       '# Inhalt wieder urspruenglicher Variable zuweisen\n_theMarks = _theMarks.Substitute(32.AsChar,\"\")                '# alle Leerzeichen entfernen\ntheTextBlock = Self.Get(0).Substitute(\"¬\",\"\")                 '# entferne Listenzeichen aus Textblock\n\nreturn theTextBlock"
)

(Script.100
	Name:	"LayoutTools.Sub_PlaceText"
	SourceCode:	"'##########################################################\n'#\n'# Filename:     LayoutTools.Sub_PlaceText.ave\n'# Author:       Adrian Boehlen\n'# Date:         09.11.2018\n'# Version:      0.3\n'#\n'# Purpose:      Subroutine zur Platzierung von Text\n'#\n'##########################################################\n\ngtxText = GraphicText.Make (Self.Get(1), Self.Get(2))\ntheText = gtxText.ReturnSymbols.Get(0)\ntheText.SetSize(Self.Get(4))\ntheText.SetColor(Self.Get(3))\ntheText.SetFont(Self.Get(0))\n_theLayout.GetGraphi
cs.Add(gtxText)"
)

(Script.101
	Name:	"LayoutTools.Sub_ReturnColor"
	SourceCode:	"nc = Color.make\n\nif (Self = \"Black\") then\n  nc.SetRGBList({0,0,0})\nelseif (Self = \"White\") then\n  nc.SetRGBList({255,255,255})\nelseif (Self = \"Dark Gray\") then\n  nc.SetRGBList({130,130,130})\nelseif (Self = \"Medium Gray\") then\n  nc.SetRGBList({165,165,165})\nelseif (Self = \"Light Gray\") then\n  nc.SetRGBList({210,210,210})\nelseif (Self = \"Dark Red\") then\n  nc.SetRGBList({150,0,0})\nelseif (Self = \"Medium Red\") then\n  nc.SetRGBList({255,0,0})\nelseif (Self = \"Light Red\") then\n  nc.SetRGBList({255,180,180})\nelseif
 (Self = \"Dark Orange\") then\n  nc.SetRGBList({180,140,0})\nelseif (Self = \"Medium Orange\") then\n  nc.SetRGBList({255,210,0})\nelseif (Self = \"Light Orange\") then\n  nc.SetRGBList({255,210,180})\nelseif (Self = \"Dark Yellow\") then\n  nc.SetRGBList({200,200,130})\nelseif (Self = \"Medium Yellow\") then\n  nc.SetRGBList({255,255,0})\nelseif (Self = \"Light Yellow\") then\n  nc.SetRGBList({255,255,200})\nelseif (Self = \"Dark Green\") then\n  nc.SetRGBList({0,150,0})\nelseif (Self = \"Medium Green\") then\n  nc.SetRGBList({0,255,0}
)\nelseif (Self = \"Light Green\") then\n  nc.SetRGBList({180,255,180})\nelseif (Self = \"Light Cyan\") then\n  nc.SetRGBList({150,255,255})\nelseif (Self = \"Medium Cyan\") then\n  nc.SetRGBList({150,150,255})\nelseif (Self = \"Dark Cyan\") then\n  nc.SetRGBList({0,150,150})\nelseif (Self = \"Dark Blue\") then\n  nc.SetRGBList({0,0,150})  \nelseif (Self = \"Medium Blue\") then\n  nc.SetRGBList({0,0,255})\nelseif (Self = \"Light Blue\") then\n  nc.SetRGBList({150,150,255})\nelseif (Self = \"Dark Purple\") then\n  nc.SetRGBList({150,0,150}
)  \nelseif (Self = \"Medium Purple\") then\n  nc.SetRGBList({255,0,255})\nelseif (Self = \"Light Purple\") then\n  nc.SetRGBList({255,180,255})\nelseif (Self = \"Transparent\") then\n  nc.SetTransparent(true)  \nend\n\nreturn nc"
)

(Script.102
	Name:	"LayoutTools.Sub_SetASCII_Char"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools.Sub_SetASCII_Char.ave\n'# Author:       Adrian Boehlen\n'# Date:         09.11.2018\n'# Version:      0.4\n'#\n'# Purpose:      Uebersetzt ASCII-Codes, die als dreistelliger dezimaler\n'#               Code mit dem Zeichen \\ davor gesetzt werden muessen\n'#               in das zugehoerige Zeichen\n'#\n'#########################################################################\n\nword = Self                       
                  '# Argument in lokale Variable uerbertragen\nwordL = word.AsTokens(\"\\\")                          '# Wort an \\ auftrennen\nif (wordL.Count > 1) then                           '# nur wenn \\ vorkommt...\n  for each i in 1..wordL.Count                      '# jeden Wortteil durchgehen...\n    if (i = 1) then\n      continue                                      '# ...ausser den ersten\n    else\n      search = \"\\\" + wordL.Get(i - 1).Left(3)       '# nach \\ plus drei folgenden Zeichen suchen\n      repl
ace = wordL.Get(i - 1).Left(3)            '# nur die drei Zeichen nach \\ auswaehlen\n      replace = replace.AsNumber                    '# in Nummer konvertieren\n      word = word.Substitute(search,replace.AsChar) '# Ersetzung vornehmen \n    end\n  end\nelse                                                '# wenn die Trennung nur einen Teil liefert...\n  if (word.Left(1) = \"\\\") then                      '# ...pruefen, ob \\ am Anfang des Strings liegt\n    search = word.Left(4)                           '# die er
sten vier Zeichen extrahieren\n    replace = word.Middle(1,3)                      '# das 2., 3., und 4. Zeichen extrahieren\n    replace = replace.AsNumber                      '# in Nummer konvertieren\n    word = word.Substitute(search,replace.AsChar)   '# Ersetzung vornehmen\n  end  \nend\n\nreturn word"
)

(Script.103
	Name:	"LayoutTools.Sub_SubstituteAll"
	SourceCode:	"'###############################################################\n'#\n'# Filename:     LayoutTools_Sub_SubstituteAll.ave\n'# Author:       Adrian Boehlen\n'# Date:         10.03.2019\n'# Version:      0.6\n'#\n'# Purpose:      ersetzt alle Zeichen ausser dem Listenzeichen ¬\n'#               definierten Zeichen\n'#\n'###############################################################\n\n'# replace printable characters 32 - 255 except ¬ (ASCII 172)\n\n'# bei ungeordneten Listen, ersetzen durch Leerstring\nif (Self.Get(1) = \"UL
\") then\n  str = Self.Get(0)\n  for each i in 32..(172 - 1)\n    str = str.Substitute(i.AsChar,\"\")\n  end\n\n  for each i in (172 + 1)..255\n    str = str.Substitute(i.AsChar,\"\")\n  end\n\n'# bei geordneten Listen, ersetzen durch Leerzeichen\nelseif (Self.Get(1) = \"OL\") then\n  str = Self.Get(0)\n  for each i in 33..(172 - 1)\n    str = str.Substitute(i.AsChar,32.AsChar)\n  end\n\n  for each i in (172 + 1)..255\n    str = str.Substitute(i.AsChar,32.AsChar)\n  end\nend\n\nreturn str"
)

(Script.104
	Name:	"LayoutTools.Sub_UnorderedList"
	SourceCode:	"'######################################################################\n'#\n'# Filename:     LayoutTools.Sub_UnorderedList.ave\n'# Author:       Adrian Boehlen\n'# Date:         15.01.2019\n'# Version:      0.2\n'#\n'# Purpose:      erzeugt eine ungeordnete Liste\n'#\n'######################################################################\n\ntheString = Self.Get(0)                                                '# Textblock uebernehmen\n_theMarks = av.Run(\"LayoutTools.Sub_SubstituteAll\", {theString, \"UL\"}) '# alle Zei
chen ausser ¬ loeschen und neuer Variable zuweisen\n_theMarks = _theMarks.Substitute(\"¬\",_bullet.AsChar)                   '# Listenzeichen durch definiertes Aufzaehlungszeichen ersetzen\ntheTextBlock = Self.Get(0).Substitute(\"¬\",\"\")                          '# Listenzeichen aus Textblock entfernen\nreturn theTextBlock"
)

(Script.105
	Name:	"LayoutTools.Text_CreateInhaltsverzeichnis"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_CreateInhaltsverzeichnis.ave\n'# Author:       Adrian Boehlen\n'# Date:         09.11.2018\n'# Version:      0.3\n'#\n'# Purpose:      Erstellt ein Inhaltsverzeichnis\n'#\n'#########################################################################\n\n'# Defaultwerte einlesen\nav.Run(\"LayoutTools.Sub_DefaultValues\", {})\n\n'# Variablen initialisieren\n\nfarbeStr = \"\"\ntitelFarbeStr = \"2103545\"          '# RGB-Wert der 
Titel\ntitelFarbe = Color.Make\ntitelFarbe.SetRGBList({210,35,45})\ntheProject = av.GetProject\ntheDocList = theProject.GetDocs\ntheLayoutList = {}\ntheStringList = {}\n\nfor each theEntry in theDocList\n  if (theEntry.Is(Layout)) then\n    theLayoutList.Add(theEntry)\n  end\nend\n\n'########## Layout fuer Inhaltsverzeichnis festlegen ##########\n\nif (theLayoutList.Count=0) then\n  MsgBox.Error(\"There are no Layouts. You have to create Layouts first!\", \"\")\n  return nil\nelse\n  inhaltseite=MsgBox.List(theLayoutList, \"Layout 
fuer Inhaltsverzeichnis festlegen:\", \"Inhaltsverzeichnis\")\n  if (inhaltseite = nil) then \n    return nil\n  end\nend\n\n'tbd bestehender Inhalt loeschen\n'theGraphicsList = inhaltseite.GetGraphics\n'for each theGraphic in theGraphicsList\n'  theGraphicsList.RemoveGraphic(theGraphic)\n'end\n'inhaltseite.Invalidate\n\n'########## Titelinformationen ermitteln ##########\n\nfor each theLayout in theLayoutList\n  for each g in theLayout.GetGraphics\n    symb = g.GetSymbol\n    if (symb = nil) then\n      continue\n    end\n    rgb
 = symb.GetColor.GetRGBList\n    for each farbe in rgb\n      farbeStr = farbeStr + farbe.AsString\n    end\n    if (farbeStr = titelFarbeStr) then\n      g.SetSelected(TRUE)\n      theString = g.GetText\n      theStringList.Add(theString)\n    end\n    farbeStr = \"\"\n  end\n  theGraphicsList = theLayout.GetGraphics\n  theGraphicsList.UnselectAll\n  theLayout.GetDisplay.Invalidate(true)\nend\n\n'########## Geometrie von Inhaltseite ermitteln ##########\n\n_theLayout = inhaltseite\nthePageDisplay = _theLayout.GetDisplay\nrecMar
gin = thePageDisplay.ReturnMarginExtent\ntheOrigin = recMargin.ReturnOrigin\nxOriginLeft = theOrigin.GetX\nxOriginRight = xOriginLeft + recMargin.GetWidth\nyOriginBottom = theOrigin.GetY\nyOriginTop = yOriginBottom + recMargin.GetHeight\n\n'########## Schriften definieren ##########\n\ntheSizeTitle = 22\ntheSizeText = 10\nschwarz = Color.GetBlack\ntextFont = Font.Make (_schriftart, _schriftschnitt)\n\n'########## Seitentitel platzieren ##########\n\ntextString = \"Inhaltsverzeichnis\"\ntextOrigin = (xOriginLeft + 0.01)@(yOrig
inTop - 0.5)\ntextSize = theSizeTitle\ntextColor = titelFarbe\n\nav.Run(\"LayoutTools.Sub_PlaceText\", {textFont, textString, textOrigin, textColor, textSize})\n\n'########## Inhaltsverzeichnis aufbauen ##########\n\ni = 0\nzeile = 0.6\nzeilenabst = 0.2\nfor each theString in theStringList\n  i = i + 1\n  '# Nummer\n  if (i Mod 2 <> 0) then\n    zeile = zeile + zeilenabst\n    textString = theString\n    textOrigin = (xOriginLeft + 0.01)@(yOriginTop - zeile)\n    textSize = theSizeText\n    textColor = schwarz\n    av.Run(\"Layou
tTools.Sub_PlaceText\", {textFont, textString, textOrigin, textColor, textSize})\n  '# zugehoeriger Titel\n  else\n    textString = theString\n    textOrigin = (xOriginLeft + 0.6)@(yOriginTop - zeile)\n    textSize = theSizeText\n    textColor = schwarz\n    av.Run(\"LayoutTools.Sub_PlaceText\", {textFont, textString, textOrigin, textColor, textSize})\n  end\nend\n\n_theLayout.Invalidate\n"
)

(Script.106
	Name:	"LayoutTools.Text_DeleteHeaderAndFooter"
	SourceCode:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_DeleteHeaderAndFooter.ave\n'# Author:       Adrian Boehlen\n'# Date:         19.12.2017\n'# Version:      0.1\n'#\n'# Purpose:      loescht durch HeaderAndFooterOne und -Many\n'#               erzeugte Kopf- und Fusszeilen\n'#\n'###########################################################################\n\ntheProject=av.GetProject\ntheDocL=theProject.GetDocs\ntheLayoutL={}\nfor each theEntry in theDocL\n  if (theE
ntry.Is(Layout)) then\n    theLayoutL.Add(theEntry)\n  end\nend\ntheBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Delete Header and Footer\")\nif (theBatchLayoutL=Nil) then \n  return nil\nend\nwhile (theBatchLayoutL.Count=0) \n  MsgBox.Error(\"Please choose one oder more layout(s)\"+NL+\"Cancel for abort\", \"\")\n  theBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Turn Rulers Off\")\n  if (theBatchLayoutL=Nil) then\n    return nil\n  end\nend\n\nfor each theLayout in theBatchLayoutL\n  farbeStr 
= \"\"\n  farbeHF_Str = \"111\"    '# RGB-Wert der Kopf- und Fusszeilen...\n\n  for each g in theLayout.GetGraphics\n    symb = g.GetSymbol\n    rgb = symb.GetColor.GetRGBList\n    for each farbe in rgb\n      farbeStr = farbeStr + farbe.AsString\n    end\n    if (farbeStr = farbeHF_Str) then\n      g.SetSelected(TRUE)\n    end\n    farbeStr = \"\"\n  end\n\n  theGraphicsList = theLayout.GetGraphics\n  theGraphicsList.ClearSelected\n  theLayout.GetDisplay.Invalidate(true)\nend"
)

(Script.107
	Name:	"LayoutTools.Text_Footnote"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_Footnote.ave\n'# Author:       Adrian Boehlen\n'# Date:         19.12.2017\n'# Version:      0.5\n'#\n'# Purpose:      erzeugt Fussnoten\n'#\n'#               erfordert:\n'#               - LayoutTools.Sub_DefaultValues\n'#               - LayoutTools.Sub_PlaceText\n'#\n'###################################################################\n\n_theLayout = av.GetActiveDoc\n\nav.Run(\"LayoutTools.Sub_DefaultValues\", {})  
'# Defaultwerte einlesen\n\nif (_theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this tool from an active Layout.\",\"\")\n  return nil\nend\n\n'# Schriftgroesse definieren\ntextSize = MsgBox.Input(\"Insert font size\", \"Font Size\",_schriftgroesse.AsString)\n\nif (textSize = nil) then\n  return nil\nelseif (textSize.IsNumber.Not) then\n  MsgBox.Warning(\"Invalid input\",\"Abort\")\n  return nil\nend\ntextSize = textSize.AsNumber\n\n'########## Layout-Geometrie ermitteln ##########\n\nthePageDisplay = av.GetActiveDoc.GetDisplay\n
recMargin = thePageDisplay.ReturnMarginExtent\ntheOrigin = recMargin.ReturnOrigin\nxOriginLeft = theOrigin.GetX\nxOriginRight = xOriginLeft + recMargin.GetWidth\n\n'########## horizontale Linie aus Clickpunkt ableiten ##########\n\npt = _theLayout.GetDisplay.ReturnUserPoint\n\nxL = xOriginLeft + 0.01\nyL = pt.GetY\nxR = (xOriginRight - xOriginLeft) / 3 + xOriginLeft\nyR = pt.GetY\n\n'# Strichstil definieren\nthePen = BasicPen.Make\nschwarz = Color.GetBlack\nthePen.SetColor(schwarz)\nthePen.SetSize(1)\n\n'# Linie zeichnen\ntheLi
ne = Line.Make( xL@yL, xR@yR)\ntheGraphicLine = GraphicShape.Make(theLine)\ntheGraphicLine.SetSymbol(thePen)\n\n_theLayout.GetGraphics.UnselectAll\ntheGraphicLine.SetSelected(TRUE)\n_theLayout.GetGraphics.Add(theGraphicLine)\nav.GetProject.SetModified(TRUE)\n\n'########## Text definieren und platzieren ##########\n\ntextFont = Font.Make (_schriftart, _schriftschnitt)\ntextString = \"Text\"\ntextOrigin = (xOriginLeft)@(pt.GetY - 0.25)\ntextColor = _schwarzC\nav.Run(\"LayoutTools.Sub_PlaceText\", {textFont, textString, textOrig
in, textColor, textSize})\n"
)

(Script.108
	Name:	"LayoutTools.Text_HeaderAndFooterMany"
	SourceCode:	"'# Name:          LayoutTools.HeaderAndFooterMany\n'#                lyt_head.ave\n'# Author:        Mike Quentel <mquentel@acceleration.net>,\n'#                 <kingofthewood@yahoo.com>\n'# Date:          Fri Dec 10 15:28:27 1999\n'# Revised by:    Adrian Boehlen\n'# Revision Date: 19/12/2017\n'# Purpose:       Creates header (optional) and footer\n'#                of one layout (default) or \n'#                of many layouts if Shift is pressed\n'#\n'#                erfordert:\n'#                - LayoutTools.Su
b_DefaultValues\n'#\n'###################################################################\n\nav.Run(\"LayoutTools.Sub_DefaultValues\", {})  '# Defaultwerte einlesen\n\n'########## Variablen initialisieren ##########\ni = 0\ntheAuthor = _autor\ntheSizeFooter = _groesseFusszeile\ntheSizeHeader = _groesseKopfzeile\ntheColor = _schwarzHF\ntheFont = Font.Make (_schriftart, _schriftschnitt)\n\ntheProject=av.GetProject\ntheDocL=theProject.GetDocs\ntheLayoutL={}\nfor each theEntry in theDocL\n  if (theEntry.Is(Layout)) then\n    theLay
outL.Add(theEntry)\n  end\nend\ntheBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Header and Footer\")\nif (theBatchLayoutL=Nil) then \n  return nil\nend\nwhile (theBatchLayoutL.Count=0) \n  MsgBox.Error(\"Please choose one oder more layout(s)\"+NL+\"Cancel for abort\", \"\")\n  theBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Header and Footer\")\n  if (theBatchLayoutL=Nil) then\n    return nil\n  end\nend\n \nstrUserName = MsgBox.Input (\"Name of the author\",\"Author\",theAuthor)\n\n'# Header defin
ieren (optional)\nif (MsgBox.YesNo(\"Define header ?\",\"Header\",true)) then\n  strHeadLeft = MsgBox.Input(\"Insert text top left:\",\n  \"Header left\",\" \")\n  strHeadRight = MsgBox.Input(\"Insert text top right:\",\n  \"Header right\",\" \")\nelse\n  strHeadLeft = nil\n  strHeadRight = nil\nend\n  \nfor each lytActive in theBatchLayoutL\n  i = i + 1\n  thePageDisplay = lytActive.GetDisplay\n  thePageExtent = thePageDisplay.ReturnPageExtent\n  theCenter = thePageExtent.ReturnCenter\n  recMargin = thePageDisplay.ReturnMarginExtent\n  th
eOrigin = recMargin.ReturnOrigin\n  xOriginLeft = theOrigin.GetX\n  xOriginCenter = theCenter.GetX\n  xOriginRight = xOriginLeft + recMargin.GetWidth\n  yOriginBottom = theOrigin.GetY\n  yOriginTop = yOriginBottom + recMargin.GetHeight\n   \n  '# creates origins for graphic text (anchor points left)\n  docOrigin = (xOriginLeft + 0.01)@(yOriginBottom + 0.05)\n  userOrigin = (xOriginCenter)@(yOriginBottom + 0.05)\n  pageOrigin = (xOriginRight - 0.01)@(yOriginBottom + 0.05)\n \n  headLeftOrigin = (xOriginLeft + 0.01)@(yOr
iginTop - 0.12)\n  headRightOrigin = (xOriginRight - 0.01)@(yOriginTop - 0.12)\n \n  '# creates names strings for graphic text  \n  strDoc = av.GetProject.GetName\n  strLytName = lytActive.GetWin.GetTitle\n  strUser = strUserName\n  strPage = i.AsString + \"/\" + theBatchLayoutL.Count.AsString\n  \n  '# creates, adjusts and adds graphic text to layout\n  gtxDoc = GraphicText.Make (strDoc, docOrigin)  \n  gtxUser = GraphicText.Make (strUser, userOrigin)\n  gtxPage = GraphicText.Make (strPage, pageOrigin)\n  \n  if (strHeadL
eft <> nil) then\n    gtxHeadLeft = GraphicText.Make (strHeadLeft, headLeftOrigin)\n  end\n  if (strHeadRight <> nil) then\n    gtxHeadRight = GraphicText.Make (strHeadRight, headRightOrigin)\n  end\n  \n  txtSymDoc = gtxDoc.ReturnSymbols.Get (0)\n  txtSymDoc.SetSize (theSizeFooter)\n  txtSymDoc.SetColor(theColor)\n  txtSymDoc.SetFont (theFont)\n\n  txtSymUser = gtxUser.ReturnSymbols.Get (0)\n  txtSymUser.SetSize (theSizeFooter)\n  txtSymUser.SetFont (theFont)\n    \n  txtSymPage = gtxPage.ReturnSymbols.Get (0)\n  txtSymPag
e.SetSize (theSizeFooter)\n  txtSymPage.SetFont (theFont)\n  \n  if (strHeadLeft <> nil) then\n    textSymHeadLeft = gtxHeadLeft.ReturnSymbols.Get (0)\n    textSymHeadLeft.SetSize (theSizeHeader)\n    textSymHeadLeft.SetColor(theColor)\n    textSymHeadLeft.SetFont (theFont)\n  end\n  if (strHeadRight <> nil) then\n    textSymHeadRight = gtxHeadRight.ReturnSymbols.Get (0)\n    textSymHeadRight.SetSize (theSizeHeader)\n    textSymHeadRight.SetFont (theFont)\n  end\n  \n  lytActive.GetGraphics.Add (gtxDoc)\n  lytActive.GetGra
phics.Add (gtxUser)\n  lytActive.GetGraphics.Add (gtxPage)\n  \n  if (strHeadLeft <> nil) then\n    lytActive.GetGraphics.Add (gtxHeadLeft)\n  end\n  \n  if (strHeadRight <> nil) then\n    lytActive.GetGraphics.Add (gtxHeadRight)\n  end\n  theGraphicList = lytActive.GetGraphics\n  \n  '# replace user name with simulated anchor point middle\n  userOrigin = (xOriginCenter - (gtxUser.GetExtent.GetX / 2))@(yOriginBottom + 0.05)\n  theGraphicList.RemoveGraphic(gtxUser)\n  gtxUser = GraphicText.Make (strUser, userOrigin)\n  txtS
ymUser = gtxUser.ReturnSymbols.Get (0)\n  txtSymUser.SetSize (theSizeFooter)\n  txtSymUser.SetColor(theColor)\n  txtSymUser.SetFont (theFont)\n  lytActive.GetGraphics.Add (gtxUser)\n  \n  '# replace page number with simulated anchor point right\n  pageOrigin = (xOriginRight - gtxPage.GetExtent.GetX)@(yOriginBottom + 0.05)\n  theGraphicList.RemoveGraphic(gtxPage)\n  gtxPage = GraphicText.Make (strPage, pageOrigin)\n  txtSymPage = gtxPage.ReturnSymbols.Get (0)\n  txtSymPage.SetSize (theSizeFooter)\n  txtSymPage.SetColor(
theColor)\n  txtSymPage.SetFont (theFont)\n  lytActive.GetGraphics.Add (gtxPage)\n  \n  '# replace right header with simulated anchor point right\n  if (strHeadRight <> nil) then\n    headRightOrigin = (xOriginRight - gtxHeadRight.GetExtent.GetX)@(yOriginTop - 0.12)\n    theGraphicList.RemoveGraphic(gtxHeadRight)\n    gtxHeadRight = GraphicText.Make (strHeadRight, headRightOrigin)\n    textSymHeadRight = gtxHeadRight.ReturnSymbols.Get (0)\n    textSymHeadRight.SetSize (theSizeHeader)\n    textSymHeadRight.SetColor(the
Color)\n    textSymHeadRight.SetFont (theFont)\n    lytActive.GetGraphics.Add (gtxHeadRight)\n  end  \nend"
)

(Script.109
	Name:	"LayoutTools.Text_HeaderAndFooterOne"
	SourceCode:	"'# Name:          LayoutTools.HeaderAndFooterOne\n'#                lyt_head.ave\n'# Author:        Mike Quentel <mquentel@acceleration.net>,\n'#                 <kingofthewood@yahoo.com>\n'# Date:          Fri Dec 10 15:28:27 1999\n'# Revised by:    Adrian Boehlen\n'# Revision Date: 19/12/2017\n'# Purpose:       Creates header (optional) and footer\n'#                of one layout\n'#\n'###################################################################\n\nav.Run(\"LayoutTools.Sub_DefaultValues\", {})  '# Defaultwerte e
inlesen\n\n'########## Variablen initialisieren ##########\ni = 0\ntheAuthor = _autor\ntheSizeFooter = _groesseFusszeile\ntheSizeHeader = _groesseKopfzeile\ntheColor = _schwarzHF\ntheFont = Font.Make (_schriftart, _schriftschnitt)\n\nlytActive = av.GetActiveDoc\nif ((lytActive.is(Layout)) and (lytActive.GetClass.GetClassName <> \"DialogEditor\")) then\n  thePageDisplay = lytActive.GetDisplay\n  thePageExtent = thePageDisplay.ReturnPageExtent\n  theCenter = thePageExtent.ReturnCenter\n  recMargin = thePageDisplay.ReturnMargi
nExtent\n  theOrigin = recMargin.ReturnOrigin\n  xOriginLeft = theOrigin.GetX\n  xOriginCenter = theCenter.GetX\n  xOriginRight = xOriginLeft + recMargin.GetWidth\n  yOriginBottom = theOrigin.GetY\n  yOriginTop = yOriginBottom + recMargin.GetHeight\n  \n  '# creates origins for graphic text (anchor points left)\n  docOrigin = (xOriginLeft + 0.01)@(yOriginBottom + 0.05)\n  userOrigin = (xOriginCenter)@(yOriginBottom + 0.05)\n  pageOrigin = (xOriginRight - 0.01)@(yOriginBottom + 0.05)\n\n  headLeftOrigin = (xOriginLeft + 
0.01)@(yOriginTop - 0.12)\n  headRightOrigin = (xOriginRight - 0.01)@(yOriginTop - 0.12)\n  \n  '# creates names strings for graphic text  \n  strAprName = av.GetProject.GetName\n  strLytName = lytActive.GetWin.GetTitle\n  \n  strUserName = MsgBox.Input (\"Name of the author\",\"Author\",theAuthor)\n \n  strDoc = MsgBox.YesNo (\"Append layout name on project name?\",\"Name\",true)\n  if (strDoc) then\n    strDoc = strAprName + \"/\" + strLytName\n  else\n    strDoc = strAprName\n  end\n  strUser = strUserName\n  strPage = MsgBox.Inp
ut (\"Insert text bottom right\", \"Footer right\", \"1\")\n  if (strPage = nil) then\n    return nil\n  end\n  \n  '# defines header (optional)\n  if (MsgBox.YesNo(\"Define header ?\",\"Header\",true)) then\n    strHeadLeft = MsgBox.Input(\"Insert text top left:\",\n    \"Header left\",\" \")\n    strHeadRight = MsgBox.Input(\"Insert text top right:\",\n    \"Header right\",\" \")\n  else\n    strHeadLeft = nil\n    strHeadRight = nil\n  end\n  \n  gtxDoc = GraphicText.Make (strDoc, docOrigin)  \n  gtxUser = GraphicText.Make (strUser, userOrigi
n)\n  gtxPage = GraphicText.Make (strPage, pageOrigin)\n  \n  if (strHeadLeft <> nil) then\n    gtxHeadLeft = GraphicText.Make (strHeadLeft, headLeftOrigin)\n  end\n  if (strHeadRight <> nil) then\n    gtxHeadRight = GraphicText.Make (strHeadRight, headRightOrigin)\n  end\n  \n  txtSymDoc = gtxDoc.ReturnSymbols.Get (0)\n  txtSymDoc.SetSize (theSizeFooter)\n  txtSymDoc.SetColor(theColor)\n  txtSymDoc.SetFont (theFont)\n\n  txtSymUser = gtxUser.ReturnSymbols.Get (0)\n  txtSymUser.SetSize (theSizeFooter)\n  txtSymUser.SetFont 
(theFont)\n    \n  txtSymPage = gtxPage.ReturnSymbols.Get (0)\n  txtSymPage.SetSize (theSizeFooter)\n  txtSymPage.SetFont (theFont)\n  \n  if (strHeadLeft <> nil) then\n    textSymHeadLeft = gtxHeadLeft.ReturnSymbols.Get (0)\n    textSymHeadLeft.SetSize (theSizeHeader)\n    textSymHeadLeft.SetColor(theColor)\n    textSymHeadLeft.SetFont (theFont)\n  end\n  if (strHeadRight <> nil) then\n    textSymHeadRight = gtxHeadRight.ReturnSymbols.Get (0)\n    textSymHeadRight.SetSize (theSizeHeader)\n    textSymHeadRight.SetFont (th
eFont)\n  end\n  \n  lytActive.GetGraphics.Add (gtxDoc)\n  lytActive.GetGraphics.Add (gtxUser)\n  lytActive.GetGraphics.Add (gtxPage)\n  \n  if (strHeadLeft <> nil) then\n    lytActive.GetGraphics.Add (gtxHeadLeft)\n  end\n  \n  if (strHeadRight <> nil) then\n    lytActive.GetGraphics.Add (gtxHeadRight)\n  end\n  theGraphicList = lytActive.GetGraphics\n  \n  '# replace user name with simulated anchor point middle\n  userOrigin = (xOriginCenter - (gtxUser.GetExtent.GetX / 2))@(yOriginBottom + 0.05)\n  theGraphicList.RemoveGra
phic(gtxUser)\n  gtxUser = GraphicText.Make (strUser, userOrigin)\n  txtSymUser = gtxUser.ReturnSymbols.Get (0)\n  txtSymUser.SetSize (theSizeFooter)\n  txtSymUser.SetColor(theColor)\n  txtSymUser.SetFont (theFont)\n  lytActive.GetGraphics.Add (gtxUser)\n  \n  '# replace page number with simulated anchor point right\n  pageOrigin = (xOriginRight - gtxPage.GetExtent.GetX)@(yOriginBottom + 0.05)\n  theGraphicList.RemoveGraphic(gtxPage)\n  gtxPage = GraphicText.Make (strPage, pageOrigin)\n  txtSymPage = gtxPage.ReturnSymb
ols.Get (0)\n  txtSymPage.SetSize (theSizeFooter)\n  txtSymPage.SetColor(theColor)\n  txtSymPage.SetFont (theFont)\n  lytActive.GetGraphics.Add (gtxPage)\n  \n  '# replace right header with simulated anchor point right\n  if (strHeadRight <> nil) then\n    headRightOrigin = (xOriginRight - gtxHeadRight.GetExtent.GetX)@(yOriginTop - 0.12)\n    theGraphicList.RemoveGraphic(gtxHeadRight)\n    gtxHeadRight = GraphicText.Make (strHeadRight, headRightOrigin)\n    textSymHeadRight = gtxHeadRight.ReturnSymbols.Get (0)\n    tex
tSymHeadRight.SetSize (theSizeHeader)\n    textSymHeadRight.SetColor(theColor)\n    textSymHeadRight.SetFont (theFont)\n    lytActive.GetGraphics.Add (gtxHeadRight)\n  end\n\nelse\n  MsgBox.Warning (\"This script is meant for an Active Layout only.  Exiting.\",\"\")\n  exit\nend"
)

(Script.110
	Name:	"LayoutTools.Text_ImportText"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_ImportText.ave\n'# Author:       Adrian Boehlen\n'# Date:         10.03.2019\n'# Version:      0.25\n'#\n'# Purpose:      Liest Text ein und bildet daraus einen Textblock\n'#               der definierten maximalen Breite in mm\n'#               bestehende Zeilenumbrueche bleiben erhalten\n'#               bei den Kommandos \"fi\", \"ti\", \"ul und \"ol\" muessen \n'#               Schriftart, -groesse und -farbe defi
niert werden,\n'#               bei den Kommandos \"fis\", \"tis\", \"uls\" und \"ols\" werden \n'#               die Defaultwerte \"DejaVu Sans Condensed Black\n'#               gesetzt.\n'#\n'#               je nach Kommando wird ein gesamtes Textfile eingelesen\n'#               oder Text, der ueber eine Inputbox eingegeben wird.\n'#\n'#               erwartet eine selektierte Textbox im Layout,\n'#               an der Stelle, wo dann der neue Text erscheinen soll.\n'#               Die Textbox kann leer sein, oder schon 
mit Text gefuellt,\n'#               wobei dieser dann geloescht wird\n'#               Der neue Text beginnt an der linken oberen Ecke der \n'#               bestehenden Textbox.\n'#\n'#               Bei den Kommandos \"ul\", \"ol\", \"uls\" und \"ols\" wird \n'#               zugleich eine Spalte mit Aufzaehlungszeichen gesetzt. Die\n'#               Position der Aufzaehlungszeichen muss im importierten Text\n'#               mit dem Zeichen \"¬\" gekennzeichnet werden.\n'#\n'#               Sonderzeichen koennen ueber ihre
n dreistelligen dezimalen\n'#               ASCII-Code im Textdokument deklariert werden, wenn das\n'#               Zeichen \\ davor gesetzt wird. z.B: \\036 wird dann zu $\n'#\n'#               erfordert:\n'#               - LayoutTools.Sub_DefaultValues\n'#               - LayoutTools.Sub_SetASCII_Char\n'#               - LayoutTools.Sub_SubstituteAll\n'#\n'#########################################################################\n\nnullstring = \"\"\nav.Run(\"LayoutTools.Sub_DefaultValues\", {})   '# Defaultwerte einlese
n\ntheLayout = av.GetActiveDoc \n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\n'########## Benutzereingaben aufnehmen ##########\n\n'# ganze Textfiles importieren\nif ((_command = \"fi\") or (_command = \"fis\")) then\n  theFile = FileDialog.Show(\"*.txt\",\"text files\",\"Choose text file\")\n  if (theFile = nil) then\n    return nil\n  end\n\n'# normalen Text ueber die Inputbox importieren\nelseif ((_command = \"ti\")  or (_command = \"tis\")) then\n  textstrin
g = MsgBox.Input(\"\",\"Import Text\",\"\")\n  if (textstring = nil) then\n    return nil\n  end\n  theFile = FileName.Make(\"tmp.txt\")\n  if (File.Exists(theFile)) then\n    File.Delete(theFile)\n  end\n  tmpFile = LineFile.Make(theFile,#FILE_PERM_WRITE)\n  tmpFile.WriteElt(textstring)\n  tmpFile.close\n\n'# Text fuer Liste ueber die Inputbox importieren\nelseif ((_command = \"ul\")  or (_command = \"uls\")) then\n  textstring = MsgBox.Input(\"\",\"Import Text for Unordered List\",\"\")\n  if (textstring = nil) then\n    return nil\n  end\n
  theFile = FileName.Make(\"tmp.txt\")\n  if (File.Exists(theFile)) then\n    File.Delete(theFile)\n  end\n  tmpFile = LineFile.Make(theFile,#FILE_PERM_WRITE)\n  tmpFile.WriteElt(textstring)\n  tmpFile.close\n  \nelseif ((_command = \"ol\")  or (_command = \"ols\")) then\n  textstring = MsgBox.Input(\"\",\"Import Text for Ordered List\",\"\")\n  if (textstring = nil) then\n    return nil\n  end\n  theFile = FileName.Make(\"tmp.txt\")\n  if (File.Exists(theFile)) then\n    File.Delete(theFile)\n  end\n  tmpFile = LineFile.Make(theFile,#FI
LE_PERM_WRITE)\n  tmpFile.WriteElt(textstring)\n  tmpFile.close\n\nend\n\n\n'# Breite des Textblocks definieren\nmaxLength = MsgBox.Input(\"Insert the width of the new textblock in mm\",\"Width\",_breiteTextbl.AsString)\n\nif (maxLength = nil) then\n  return nil\nelseif (maxLength.IsNumber.Not) then\n  MsgBox.Warning(\"Invalid input\",\"Abort\")\n  return nil\nend\nmaxLength = maxLength.AsNumber\n\n'########## Schrift bestimmen ##########\n\n'# Schriftart definieren\nif ((_command = \"fi\") or (_command = \"ti\") or (_command = \"ul\") or (_
command = \"ol\")) then\n  schriftartListe = {\"DejaVu Sans\", \"DejaVu Sans Mono\", \"DejaVu Serif\", \"Khalid\", \"Segoe UI\", \"Courier New\"}\n  schriftart = MsgBox.ListAsString(schriftartListe, \"Choose font\", \"Font\")\n  if (schriftart = nil) then \n    return nil\n  end\nelse\n  schriftart = _schriftart\nend\n\n'# Schriftschnitt definieren\nif ((_command = \"fi\") or (_command = \"ti\") or (_command = \"ul\") or (_command = \"ol\")) then\n  if (schriftart = \"DejaVu Sans\") then\n    schriftschnittListe = {\"Condensed\", \"Condensed Bold\", \"
Condensed Oblique\", \"Condensed Bold Oblique\"}\n    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Choose font style\", \"Font Style\")\n    if (schriftschnitt = nil) then \n      return nil\n    end\n  elseif (schriftart = \"DejaVu Sans Mono\") then\n    schriftschnittListe = {\"Book\", \"Bold\", \"Oblique\", \"Bold Oblique\"}\n    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Choose font style\", \"Font Style\")\n    if (schriftschnitt = nil) then \n      return nil\n    end\n  elseif (schriftart = \"DejaVu S
erif\") then\n    schriftschnittListe = {\"Book\", \"Bold\", \"Condensed\", \"Condensed Bold\", \"Condensed Italic\", \"Condensed Bold Italic\", \"Italic\", \"Bold Italic\"}\n    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Choose font style\", \"Font Style\")\n    if (schriftschnitt = nil) then \n      return nil\n    end\n  elseif (schriftart = \"Khalid\") then\n    schriftschnittListe = {\"Normal\"}\n    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Choose font style\", \"Font Style\")\n    if (schriftschnitt = n
il) then \n      return nil\n    end\n  elseif (schriftart = \"Segoe UI\") then\n    schriftschnittListe = {\"Standard\", \"Kursiv\", \"Fett\", \"Fett Kursiv\"}\n    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Choose font style\", \"Font Style\")\n    if (schriftschnitt = nil) then \n      return nil\n    end\n  elseif (schriftart = \"Courier New\") then\n    schriftschnittListe = {\"Standard\"}\n    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Choose font style\", \"Font Style\")\n    if (schriftschnitt = nil
) then \n      return nil\n    end\n  end\nelse\n  schriftschnitt = _schriftschnitt\nend\n\n'# Schriftfarbe definieren\nif ((_command = \"fi\") or (_command = \"ti\") or (_command = \"ul\") or (_command = \"ol\")) then\n  theColorList = {\"Black\", \"Grey\", \"Red\", \"Green\", \"Blue\", \"User defined\"}\n  theColor = MsgBox.ListAsString(theColorList, \"Choose font colour\", \"Font Colour\")\n  if (theColor = nil) then \n    return nil\n  elseif (theColor = \"User defined\") then\n    theRGB = MsgBox.MultiInput(\"Define RGB\", \"RGB\",\n    {\"Red\", \"G
reen\", \"Blue\"}, {\"0\", \"0\", \"0\"})\n    if (theRGB = nil) then\n      return nil\n    end\n    rot = theRGB.Get(0)\n    gruen = theRGB.Get(1)\n    blau = theRGB.Get(2)\n  end\nelse\n  theColor = _schwarzT\nend\n\n'# Schriftgroesse definieren\ntheSize = MsgBox.Input(\"Insert font size\", \"Font Size\",_schriftgroesse.AsString)\n\nif (theSize = nil) then\n  return nil\nelseif (theSize.IsNumber.Not) then\n  MsgBox.Warning(\"Invalid input\",\"Abort\")\n  return nil\nend\ntheSize = theSize.AsNumber\n\n'# Abstand der Aufzaehlungszeichen festlege
n\nif ((_command = \"ol\") or (_command = \"ols\")) then\n  abst = MsgBox.Input(\"Define the space between the marker and the text in mm\",\n    \"List: Space between marker and text\",_abstList.AsString)\n  if (abst = nil) then\n    return nil\n  elseif (abst.IsNumber.Not) then\n    MsgBox.Warning(\"Invalid input\",\"Abort\")\n    return nil\n  end\n  abst = abst.AsNumber\nend\n\nif ((_command = \"ul\") or (_command = \"uls\")) then\n  abst = MsgBox.Input(\"Define the space between the bullets and the text in mm\",\n    \"List: Space betwe
en bullets and text\",_abstList.AsString)\n  if (abst = nil) then\n    return nil\n  elseif (abst.IsNumber.Not) then\n    MsgBox.Warning(\"Invalid input\",\"Abort\")\n    return nil\n  end\n  abst = abst.AsNumber\nend\n\n'# Aufzaehlungszeichen definieren\nif (_command = \"ul\") then\n  _bullet = MsgBox.Input(\"Define the character for the bullet (Default: Halbgeviertstrich)\",\n    \"List: Bullet character\",_bullet.AsString)\n  if (_bullet = nil) then\n    return nil\n  elseif (_bullet.IsNumber.Not) then\n    MsgBox.Warning(\"Invalid 
input\",\"Abort\")\n    return nil\n  end\n  _bullet = _bullet.AsNumber\nend\n\n'########## Text einlesen, formatieren, symbolisieren und platzieren ##########\n\n'# LineFile erzeugen und Anzahl Zeilen ermitteln\ntheLineFile = LineFile.Make(theFile,#FILE_PERM_READ)\nelementCount = theLineFile.GetSize\n\n'# Variablen initialisieren\ntheTextBlock = \"\"\ntheNewLine = \" \"\ntheNewLineT = \"\"\ntheWordT = \"\"\ni = 0\n\n'# Farben zuweisen\nif (theColor = \"Black\") then\n  theColor = Color.GetBlack\nelseif (theColor = \"Grey\") then\n  theColor = 
Color.GetGray\nelseif (theColor = \"Red\") then\n  theColor = Color.Make\n  theColor.SetRGBList({210,35,45})\nelseif (theColor = \"Green\") then\n  theColor = Color.GetGreen\nelseif (theColor = \"Blue\") then\n  theColor = Color.Make\n  theColor.SetRGBList({0,137,207})\nelseif (theColor = \"User defined\") then\n  theColor = Color.Make\n  theColor.SetRGBList({rot.AsNumber,gruen.AsNumber,blau.AsNumber})\nend\n\nschriftart = Font.Make (schriftart, schriftschnitt)\ntheGraphicList = theLayout.GetGraphics\ntheSelected = theGraphicList.
GetSelected.Get(0)\ntheOrigin = theSelected.GetOrigin                               '# Nullpunkt unten links bestimmen\n\n'# Input-Text in neue Zeilen der gewuenschten Laenge umformatieren\n\nfor each i in 1..elementCount                                   '# zeilenweise durchgehen\n  theLine = theLineFile.ReadElt                                 '# aktuelle Zeile\n  if (theLine.Count > 0) then                                   '# alle nicht leeren Zeilen\n    i = 0\n    for each word in theLine.AsList                
             '# Zeile in Woerter auftrennen\n      i = i + 1\n      word = av.Run(\"LayoutTools.Sub_SetASCII_Char\", word)      '# uebersetzen der ASCII-Codes in entsprechende Zeichen\n      theGraphicText = GraphicText.Make (theNewLine, theOrigin)\n      theSymbol = theGraphicText.ReturnSymbols.Get(0)\n      theSymbol.SetColor(theColor)\n      theSymbol.SetFont(schriftart)\n      theSymbol.SetSize(theSize)\n      theLayout.GetGraphics.Add(theGraphicText)\n      theWidth = theGraphicText.GetBounds.GetWidth\n      theWi
dth = theWidth * 25.4                                '# inch to mm\n      theGraphicList.RemoveGraphic(theGraphicText)\n      \n      if (theWidth > maxLength) then                            '# wenn laenger als maxLength Laenge...\n        theTextBlock = theTextBlock + theNewLineT.Trim + NL     '# ...setze temporaere Zeile an Textblock an und schliesse mit Newline ab\n        theNewLine = theWordT                                   '# starte neue Zeile mit letztem Wort aus letztem Durchgang\n      end\n      if (t
heLine.AsList.Count = i) then                        '# beim letzten Wort der Zeile...\n        theNewLine = theNewLine ++ word + NL                    '# ...Woerter zusammensetzen und mit Newline abschliessen\n        theTextBlock = theTextBlock + theNewLine.Trim + NL      '# setze an Textblock an und schliesse mit Newline ab\n        theNewLine = \"\"                                         '# temporaere Zeile loeschen\n      else\n        theWordT = word                                         '# aktuelles Wort
 in temporaerer Variable speichern\n        theNewLineT = theNewLine                                '# aktuelle Zeile in temporaerer Variable speichern\n        theNewLine = theNewLine ++ word                         '# Woerter zu neuer Zeile zusammensetzen\n      end\n    end\n  else                                                          '# alle leeren Zeilen\n    if (theNewLine.Count > 0) then                              '# wenn neue Zeile nicht leer ist... \n      theTextBlock = theTextBlock + theNewLine.Tri
m + NL        '# ...setze an Textblock an und schliesse mit Newline ab\n      theNewLine = \"\"                                           '# Inhalt der neuen Zeile loeschen\n    end\n    theTextBlock = theTextBlock + NL                            '# wenn neue Zeile nicht leer ist, schliesse mit Newline ab\n  end\nend\n\ntheTextBlock = theTextBlock + theNewLine.Trim                   '# fuege Rest der letzten Zeile noch an\ntheTextBlock = theTextBlock.BasicTrim(\"\",NL)                    '# entferne ueberschuessiges Ne
wline am Ende\n\n'# ungeordnete Listen\nif ((_command = \"ul\") or (_command = \"uls\")) then             '# fuer eine nicht geordnete Liste...\n  theTextBlock = av.Run(\"LayoutTools.Sub_UnorderedList\", {theTextBlock})\nend\n\n'# geordnete Listen\nif ((_command = \"ol\") or (_command = \"ols\")) then             '# fuer eine geordnete Liste...\n  theTextBlock = av.Run(\"LayoutTools.Sub_OrderedList\", {theTextBlock})\nend\n\ntheLineFile.Close\n\n'# Text symbolisieren und temporaer in Layout platzieren\ntheGraphicList = theLayout.GetG
raphics\ntheSelected = theGraphicList.GetSelected.Get(0)\ntheOrigin = theSelected.GetOrigin                                        '# Nullpunkt unten links bestimmen\ntheOrigin = theOrigin.GetX@(theOrigin.GetY + theSelected.GetExtent.GetY) '# Nullpunkt oben links ableiten\ntheGraphicText = GraphicText.Make (theTextBlock, theOrigin)\ntheSymbol = theGraphicText.ReturnSymbols.Get (0)\ntheSymbol.SetColor(theColor)\ntheSymbol.SetFont(schriftart)\ntheSymbol.SetSize(theSize)\n\ntheLayout.GetGraphics.Add (theGraphicText)\nthe
GraphicList.RemoveGraphic (theSelected)                     '# urspruenglich selektierte Textbox loeschen\n\n'# Hoehe des Textblocks bestimmen und Nullpunkt so umrechnen, dass der Text oben links\n'# mit dem bestehenden uebereinstimmt. Bei Listen Textblock entsprechend einruecken\n\nif ((_command = \"ul\") or (_command = \"uls\") or (_command = \"ol\") or (_command = \"ols\")) then\n  abst = abst / 25.4     '# mm to inch\n  theOrigin = (theOrigin.GetX + abst)@(theOrigin.GetY - theGraphicText.GetExtent.GetY) \n  theGraphicL
ist.RemoveGraphic(theGraphicText)                 '# temporaeren Text loeschen\n  theGraphicText = GraphicText.Make (theTextBlock, theOrigin)\n  theSymbol = theGraphicText.ReturnSymbols.Get(0)\n  theSymbol.SetColor(theColor)\n  theSymbol.SetFont(schriftart)\n  theSymbol.SetSize(theSize)\n  theLayout.GetGraphics.Add (theGraphicText)\n  '# Aufzaehlungszeichen ergaenzen\n  theOrigin = (theOrigin.GetX - abst)@theOrigin.GetY\n  theGraphicText = GraphicText.Make (_theMarks, theOrigin)\n  if ((_command = \"ol\") or (_command 
= \"ols\")) then \n    theGraphicText.SetAlignment(#TEXTCOMPOSER_JUST_RIGHT)\n  else\n    theGraphicText.SetAlignment(#TEXTCOMPOSER_JUST_LEFT)\n  end\n  theSymbol = theGraphicText.ReturnSymbols.Get(0)\n  theSymbol.SetColor(theColor)\n  theSymbol.SetFont(schriftart)\n  theSymbol.SetSize(theSize)\n  theLayout.GetGraphics.Add (theGraphicText)\nelse\n  theOrigin = theOrigin.GetX@(theOrigin.GetY - theGraphicText.GetExtent.GetY) \n  theGraphicList.RemoveGraphic(theGraphicText)                 '# temporaeren Text loeschen\n  the
GraphicText = GraphicText.Make (theTextBlock, theOrigin)\n  theSymbol = theGraphicText.ReturnSymbols.Get(0)\n  theSymbol.SetColor(theColor)\n  theSymbol.SetFont(schriftart)\n  theSymbol.SetSize(theSize)\n  theLayout.GetGraphics.Add (theGraphicText)\nend\n\ntheLayout.Invalidate\n\n'# bei Import ueber Textbox temporaer erzeugtes File loeschen\nif (theFile.AsString.Contains(\"tmp.txt\")) then\n  File.Delete(theFile)\nend"
)

(Script.111
	Name:	"LayoutTools.Text_InsertText"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_InsertText.ave\n'# Author:       Adrian Boehlen\n'# Date:         10.09.2017\n'# Version:      0.6\n'#\n'# Purpose:      Basiert auf Layout.Text mit folgenden Erweiterungen:\n'#               - Standardschrift wird vordefiniert\n'#               - der Nullpunkt ist oben statt unten, wenn bestehender\n'#                 Text editiert wird\n'#               Einschraenkungen:\n'#               - wenn Text editiert 
werden soll, muss das Textobjekt\n'#                 selektiert sein\n'#               - funktioniert nur mit Flattersatz linksbuendig und\n'#                 Standard-Zeilenabstand 1.0\n'#\n'#               erfordert:\n'#               - LayoutTools.Sub_DefaultValues\n'#               - LayoutTools.Sub_ReturnColor\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc\ntheGraphicList = theLayout.GetGraphics\nif (theGraphicList.HasSelected = TRUE) then\n  theSelecte
d = theGraphicList.GetSelected.Get(0)\n  '# urspruengliche Hoehe der Textbox bestimmen, sofern vorhanden\n  theOriY = theSelected.GetExtent.GetY\nend\n\nav.Run(\"LayoutTools.Sub_DefaultValues\", {})   '# Defaultwerte einlesen\n\nCPC = av.FindDialog(\"Graphic.Label Defaults\")\nIconList = CPC.FindByName(\"CalloutIcons\")\nthePrefs = IconList.GetObjectTag.Get(\"Ttool1\")\n\nthePrefs.Set(0, _schriftart)\nthePrefs.Set(1, _schriftschnitt)\nthePrefs.Set(2, _schriftgroesse)\n\n      '(0) Font Family    (String) \n      '(1) Font Style   
  (String)\n      '(2) Font Size      (Number)\n      '(3) Font Color     (String)\n      '(10) UseDefFont    (Boolean)\n\nCFont =      thePrefs.Get(0)\nCStyle =     thePrefs.Get(1)\nCSize =      thePrefs.Get(2)\nUseDef =     thePrefs.Get(10)\nif (thePrefs.Get(3) = \"Unnamed Color\") then\n  CColor = av.GetSymbolwin.ReturnCurrentSymbol(#SYMBOL_TEXT).Clone.GetColor\nelse \n  CColor = av.Run(\"LayoutTools.Sub_ReturnColor\",thePrefs.Get(3))\nend\n\n'# neues Textobjekt platzieren\nif (theLayout.GetGraphics.EditText.Not) then\n  pt 
= theLayout.GetDisplay.ReturnUserPoint\n  theGraphicText = GraphicText.Make(\"\", pt)\n  theGraphicText.SetDisplay(theLayout.GetDisplay)\n  theLayout.GetGraphics.UnselectAll\n  theGraphicText.SetSelected(TRUE)\n  if (theGraphicText.EditText) then\n    theLayout.GetGraphics.AddName(theGraphicText)\n    av.GetProject.SetModified(TRUE)\n  end\n  theString = theGraphicText.GetText\n  theGraphicText.GetSymbol.SetFont(Font.make(CFont,CStyle))\n  theGraphicText.GetSymbol.SetSize(CSize)\n  theGraphicText.GetSymbol.SetColor(CColo
r)\n  \n'# bestehendes Textobjekt editieren\nelse\n  if (theGraphicList.HasSelected = FALSE) then\n    MsgBox.Warning(\"Please select a text object\",\"\")\n    return nil\n  end \n  theSelected = theGraphicList.GetSelected.Get(0)\n  theString = theSelected.GetText\n  CColor = theSelected.ReturnSymbols.Get(0).GetColor\n  CSize = theSelected.ReturnSymbols.Get(0).GetSize\n  theOrigin = theSelected.GetOrigin\n  theNewY = theSelected.GetExtent.GetY  '# Hoehe der editierten Textbox bestimmen\n  theOrigin = theOrigin.GetX@(theOrig
in.GetY - (theNewY - theOriY))\n  theGraphicList.RemoveGraphic(theSelected)\n  theGraphicText = GraphicText.Make (theString, theOrigin) \n  theSymbol = theGraphicText.ReturnSymbols.Get (0)\n  theSymbol.SetColor(CColor)\n  theSymbol.SetFont(Font.make(CFont,CStyle))\n  theSymbol.SetSize(CSize) \n  theLayout.GetGraphics.Add (theGraphicText)  \nend"
)

(Script.112
	Name:	"LayoutTools.Text_Silbentrennung"
	SourceCode:	"'######################################################################\n'#\n'# Filename:     LayoutTools.Text_Silbentrennung.ave\n'# Author:       Adrian Boehlen\n'# Date:         09.11.2018\n'# Version:      0.2\n'#\n'# Purpose:      einfacher Algorithmus zur Silbentrennung deutscher \n'#               Woerter\n'#               basiert auf Open-Script von:\n'#               http://www.wer-weiss-was.de/t/silbentrennung/544436/4\n'#\n'#               erfordert:\n'#               - LayoutTools.Sub_IstIn\n'#\n'#############
#########################################################\n\nwelchesWort = \"Donaudampfschifffahrskapitän\"\n\n'# Variablen initialisieren\nzeichenAnzahl = 0\ntrennenErlaubt = true\nz = \"\"\nz0 = \"\"\nz1 = \"\"\nv = \"\"\ntrennPositionen = {}\nistInR = false\n\nzeichenAnzahl = welchesWort.Count\n\nif (zeichenAnzahl > 2) then\n  trennenErlaubt = false\n  vokale = {\"a\",\"e\",\"i\",\"o\",\"u\",\"ä\",\"ü\",\"ö\"}\n  verbindungen = {\"sch\",\"ch\",\"ph\",\"ck\",\"pf\",\"br\",\"pl\",\"tr\",\"st\",\"gr\"}\n  trennungen = {\"-\",\"/\",\"\\\",\"*\",\"#\",\";\",\".\",\"+\",\"=\",\")\",\"(\",\"&\",\"!\",\"
?\",\",\",\":\",\" \",\"_\",\"~\"}\n  for each i in 2..(zeichenAnzahl - 1)\n    z0 = welchesWort.Middle((i - 1),1)\n    char = z0\n    liste = vokale\n    istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n    if ((trennenErlaubt = false) and (istInR = true)) then\n      trennenErlaubt = true\n    end\n    \n    if (trennenErlaubt = true) then\n      z = welchesWort.Middle(i,1)\n      z1 = welchesWort.Middle((i + 1),1)\n      v = z0 + z\n      if ((v = \"ch\") and (i > 2) and (welchesWort.Middle((i - 2),1) = \"s\")) then\n        
v = \"sch\"\n      end\n      liste = vokale\n      char = z1\n      istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n      if (istInR = true) then\n        char = z\n        istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n        if (istInR = false) then\n          liste = trennungen\n          istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n          if (istInR = false) then\n            char = z0\n            istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n            if (istInR = fals
e) then\n              char = v\n              liste = verbindungen\n              istInR = av.Run(\"LayoutTools.Sub_IstIn\", {char, liste})\n              if (istInR = true) then\n                trennPositionen.Add((i - (v.Count + 1)))\n              else\n                trennPositionen.Add(i)\n              end\n            end\n          end\n        end\n      end\n    end\n  end\nend\n\nfor each pos in trennPositionen\n  silbe = welchesWort.Left(pos)\n  rest = welchesWort.Middle(pos,(welchesWort.Count - 2))\n  MsgBox.Info
(silbe + \"-\" + NL + rest,\"Moegliche Trennungen\")\nend\n\n"
)

(Script.113
	Name:	"LayoutTools.View_RefreshLayout"
	SourceCode:	"theLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Info(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\ntheLayout.GetDisplay.ZoomIn(110)\ntheLayout.GetDisplay.ZoomOut(111)\n"
)

(Script.114
	Name:	"LayoutTools.View_SetQuality"
	SourceCode:	"'########################################################\n'#\n'# Filename:     SetQuality.ave\n'# Author:       Adrian Boehlen\n'# Date:         21.10.2014\n'# Version:      0.1\n'#\n'# Purpose:      aendert auf Knopfdruck bei allen Bildern\n'#               eines Layouts die Qualitaet von \"Draft\"\n'#               auf \"Presentation\" oder umgekehrt.             \n'#\n'########################################################\n\ntheLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this 
script from an active Layout.\",\"\")\n  return nil\nend\n\ntheGraphicsList = theLayout.GetGraphics\n\nfor each theObject in theGraphicsList\n  if (theObject.Is(PictureFrame)) then\n    if (theObject.GetQuality = #FRAME_QUALITY_PRESENTATION) then\n      theObject.SetQuality(#FRAME_QUALITY_DRAFT)\n    else\n      theObject.SetQuality(#FRAME_QUALITY_PRESENTATION)\n    end\n  end\nend\n\ntheLayout.Invalidate"
)

(Script.115
	Name:	"LayoutTools.View_UndoZoom"
	SourceCode:	"theLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\ntheLayout.GetDisplay.UndoZoom\n"
)

(Script.116
	Name:	"LayoutTools.View_ZoomToExportview"
	SourceCode:	"theLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Info(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\ntheLayout.GetDisplay.ZoomToActual\ntheLayout.GetDisplay.ZoomIn(300)"
)

(Script.117
	Name:	"Ext_Unload"
	SourceCode:	"Dialog.DetachFromExtension(self)\n"
)

(Script.118
	Name:	"Ext_Inst"
	SourceCode:	"if (av.GetProject = nil) then\n  return nil\nend\n\nSack=self 'Der Sack vom makescript, wo alles Benötigte drin ist\n\nSchaltflaeche=Sack.get(0)\nviewGUI = av.GetProject.FindGUI( \"Layout\" )\nif (viewGUI <> nil) then\n    'prüfen, ob die Schaltfläche schon existiert\n    if(viewGUI.GetButtonBar.findbyscript(Schaltflaeche.getclick)=nil)then\n      'Schaltfläche an der 2. Stelle einfügen\n      viewGUI.GetButtonBar.Add( Schaltflaeche, 2)\n    end\nend\n\nav.getproject.Adddialog( Sack.get(1))\n\n\n\n"
)

(Script.119
	Name:	"Ext_Unin"
	SourceCode:	"if (av.GetProject = nil) then\n  return nil\nend\n\nif (av.GetProject.IsClosing) then\n  return nil\nend\n\nlayoutGUI = av.GetProject.FindGUI( \"Layout\" )\n\nlayoutGUI.GetButtonBar.remove(layoutGUI.GetButtonBar.findbyscript( \"LayoutTools.start\"))\n\nav.GetProject.removedialog(\"LayoutTools\")"
)

