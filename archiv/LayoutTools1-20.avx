(Script.72
	Name:	"___LayoutTools.DefaultFont"
	SourceCode:	"'##########################################################\n'#\n'# Filename:     LayoutTools_DefaultFont.ave\n'# Author:       Adrian Boehlen\n'# Date:         24.01.2016\n'# Version:      0.1\n'#\n'# Purpose:      Definition globaler Variablen\n'#               fuer die Standardschrift\n'#\n'##########################################################\n\n_defFont =    \"DejaVu Sans\"\n_defSchnitt = \"Condensed\"\n_defColor =   Color.GetBlack"
)

(Script.73
	Name:	"___LayoutTools.UpdateText"
	SourceCode:	"theExt = Extension.GetExtensions.Get(\"Label & Text Tools\")\nSELF.SetEnabled(theExt <> nil)\n"
)

(Script.74
	Name:	"LayoutTools.DisplayFontPanel"
	SourceCode:	"if ((av.GetSymbolWin.GetPanel = #SYMBOLWIN_PANEL_COLOR).not) then\n  av.GetSymbolWin.SetPanel(#SYMBOLWIN_PANEL_FONT)\nend"
)

(Script.75
	Name:	"LayoutTools.EnterCommand"
	SourceCode:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_Enter_command.ave\n'# Author:       Adrian Boehlen\n'# Date:         10.03.2019\n'# Version:      0.18\n'#\n'# Purpose:      loest diverse Funktionen durch Kommandos aus\n'#\n'#               erfordert \n'#               - LayoutTools.General_Documentation\n'#               - alle Tools, die ueber Kommandos aufgerufen werden\n'#\n'###########################################################################\n\n\n'##
######## Help messages ##########\n\nav.Run(\"LayoutTools.General_Documentation\", _uebersicht)\nav.Run(\"LayoutTools.General_Documentation\", _helpnew)\nav.Run(\"LayoutTools.General_Documentation\", _helpcopy)\nav.Run(\"LayoutTools.General_Documentation\", _helphlon)\nav.Run(\"LayoutTools.General_Documentation\", _helphlonm)\nav.Run(\"LayoutTools.General_Documentation\", _helphloff)\nav.Run(\"LayoutTools.General_Documentation\", _helphloffm)\nav.Run(\"LayoutTools.General_Documentation\", _helpheado)\nav.Run(\"LayoutTools.General_Doc
umentation\", _helpheadm)\nav.Run(\"LayoutTools.General_Documentation\", _helpdelhead)\nav.Run(\"LayoutTools.General_Documentation\", _helplytimp)\nav.Run(\"LayoutTools.General_Documentation\", _helplytexp)\nav.Run(\"LayoutTools.General_Documentation\", _helpfi)\nav.Run(\"LayoutTools.General_Documentation\", _helpfis)\nav.Run(\"LayoutTools.General_Documentation\", _helpoli)\nav.Run(\"LayoutTools.General_Documentation\", _helpolis)\nav.Run(\"LayoutTools.General_Documentation\", _helpuli)\nav.Run(\"LayoutTools.General_Documentation\", _
helpulis)\nav.Run(\"LayoutTools.General_Documentation\", _helpti)\nav.Run(\"LayoutTools.General_Documentation\", _helptis)\nav.Run(\"LayoutTools.General_Documentation\", _helpregm)\nav.Run(\"LayoutTools.General_Documentation\", _helpselall)\nav.Run(\"LayoutTools.General_Documentation\", _helpunselall)\nav.Run(\"LayoutTools.General_Documentation\", _helpmx)\nav.Run(\"LayoutTools.General_Documentation\", _helpmy)\n\n_command = Self.GetDialog.FindByName(\"EnterCommand\").GetText\nSelf.SetText(\"\")\n\n'########## execute functions ########
##\n\n'# New\nif (_command = \"new\") then\n  av.Run(\"LayoutTools.General_NewLayout\", {})\nelseif (_command = \"help new\") then\n  MsgBox.Report(_helpnew,\"Help new\")\n\n'# Copy\nelseif (_command = \"copy\") then\n  av.Run(\"LayoutTools.General_CopyLayout\", {})\nelseif (_command = \"help copy\") then\n  MsgBox.Report(_helpcopy,\"Help copy\")\n\n'# Hilfslinien\nelseif (_command = \"hlon\") then\n  av.Run(\"LayoutTools.Ruler_TurnRulersOnOne\", {})\nelseif (_command = \"help hlon\") then\n  MsgBox.Report(_helphlon,\"Help hlon\")\nelseif (_command 
= \"hloff\") then\n  av.Run(\"LayoutTools.Ruler_TurnRulersOffOne\", {})\nelseif (_command = \"help hloff\") then\n  MsgBox.Report(_helphloff,\"Help hloff\")\nelseif (_command = \"hlonm\") then\n  av.Run(\"LayoutTools.Ruler_TurnRulersOnMany\", {})\nelseif (_command = \"help hlonm\") then\n  MsgBox.Report(_helphlonm,\"Help hlonm\")\nelseif (_command = \"hloffm\") then\n  av.Run(\"LayoutTools.Ruler_TurnRulersOffMany\", {})\nelseif (_command = \"help hloffm\") then\n  MsgBox.Report(_helphloff,\"Help hloffm\")\n\n'# Header and Footer\nelseif (_comma
nd = \"heado\") then\n  av.Run(\"LayoutTools.Text_HeaderAndFooterOne\", {})\nelseif (_command = \"help heado\") then\n  MsgBox.Report(_helpheado,\"Help heado\")\nelseif (_command = \"headm\") then\n  av.Run(\"LayoutTools.Text_HeaderAndFooterMany\", {})\nelseif (_command = \"help headm\") then\n  MsgBox.Report(_helpheadm,\"Help headm\")\nelseif (_command = \"delhead\") then\n  av.Run(\"LayoutTools.Text_DeleteHeaderAndFooter\", {})\nelseif (_command = \"help delhead\") then\n  MsgBox.Report(_helpdelhead, \"Help delhead\")\n  \n'# Import and Expo
rt\nelseif (_command = \"lytimp\") then\n  av.Run(\"LayoutTools.ImpExp_LoadODB\", {})\nelseif (_command = \"help lytimp\") then\n  MsgBox.Report(_helplytimp,\"Help lytimp\")\nelseif (_command = \"lytexp\") then\n  av.Run(\"LayoutTools.ImpExp_CreateODB\", {})\nelseif (_command = \"help lytexp\") then\n  MsgBox.Report(_helplytexp,\"Help lytexp\")\n  \n'# Import Text\nelseif ((_command = \"fi\") or (_command = \"fis\")) then\n  av.Run(\"LayoutTools.Text_ImportText\", {})\nelseif (_command = \"help fi\") then\n  MsgBox.Report(_helpfi,\"Help fi\")\nels
eif (_command = \"help fis\") then\n  MsgBox.Report(_helpfis,\"Help fis\")\nelseif ((_command = \"ol\") or (_command = \"ols\")) then\n  av.Run(\"LayoutTools.Text_ImportText\", {})\nelseif (_command = \"help ol\") then\n  MsgBox.Report(_helpoli,\"Help ol\")\nelseif (_command = \"help ols\") then\n  MsgBox.Report(_helpolis,\"Help ols\")\nelseif ((_command = \"ul\") or (_command = \"uls\")) then\n  av.Run(\"LayoutTools.Text_ImportText\", {})\nelseif (_command = \"help ul\") then\n  MsgBox.Report(_helpuli,\"Help ui\")\nelseif (_command = \"help uls\")
 then\n  MsgBox.Report(_helpulis,\"Help uls\")\nelseif ((_command = \"ti\") or (_command = \"tis\")) then\n  av.Run(\"LayoutTools.Text_ImportText\", {})\nelseif (_command = \"help ti\") then\n  MsgBox.Report(_helpti,\"Help ti\")\nelseif (_command = \"help tis\") then\n  MsgBox.Report(_helptis,\"Help tis\")\n\n'# Schnittmarken\nelseif (_command = \"regm\") then\n  av.Run(\"LayoutTools.General_MakeRegistrationMarks\", {})\nelseif (_command = \"help regm\") then\n  MsgBox.Report(_helpregm,\"Help regm\")\n  \n'# Select elements\nelseif (_command = \"s
elall\") then\n  av.Run(\"LayoutTools.Sel_SelectAll\", {})\nelseif (_command = \"help selall\") then\n  MsgBox.Report(_helpselall, \"Help selall\")\nelseif (_command = \"unselall\") then\n  av.Run(\"LayoutTools.Sel_UnselectAll\", {})\nelseif (_command = \"help unselall\") then\n  MsgBox.Report(_helpunselall, \"Help unselall\")\n  \n'# Move features\nelseif (_command.Left(2) = \"mx\") then\n  av.Run(\"LayoutTools.General_MoveFeature\", {})\nelseif (_command = \"help mx\") then\n  MsgBox.Report(_helpmx, \"Help mx\")\nelseif (_command.Left(2) = \"
my\") then\n  av.Run(\"LayoutTools.General_MoveFeature\", {})\nelseif (_command = \"help my\") then\n  MsgBox.Report(_helpmy, \"Help my\")\n  \n'# Help / Misc\nelseif (_command = \"help\") then\n  MsgBox.Report(_uebersicht,\"\")\nelseif (_command = \"zoomex\") then\n  av.Run(\"LayoutTools.View_ZoomToExportview\", {})\nelseif ((_command = \"quit\") or (_command = \"exit\")) then\n  self.GetDialog.Close\nelseif (_command = nil) then\n  return nil\nelse\n  MsgBox.Info(\"Command not found\",\"\")\nend"
)

(Script.76
	Name:	"LayoutTools.General_Close"
	SourceCode:	"self.GetDialog.Close"
)

(Script.77
	Name:	"LayoutTools.General_CopyLayout"
	SourceCode:	"'Copies a Layout and renames it...\n'Created by Fred J. Calef III, CH2M Hill\n'Date:  4/6/1999\n\n'Gets the Layout...\nmyProj = av.GetProject\nsomeLayouts = myProj.GetDocswithGui(av.FindGui(\"Layout\"))\nalayoutChoice = MsgBox.ChoiceAsString( someLayouts, \"Choose a Layout to copy:\", \"Copy Layout\")\nif (alayoutChoice = nil) then\n  return nil\nend\ntheLayout = myProj.FindDoc( alayoutChoice.AsString )\n\n'Copies the Layout and renames it...\nnewLayoutName = MsgBox.Input( \"Enter a new name for the layout:\", \"New Layout Name\",
 \"New Layout\" )\nif (newLayoutName = nil) then   'Cancels if the there is no Layout name\n  return nil\nend\nif (av.FindDoc(newLayoutName).AsString = newLayoutName.AsString) then\n  'Cancels if the Layout name already exists\n  MsgBox.Error(\"That layout name already exists! Press the Copy Layout button again...\",\"Layout Already Exists\")\n  return nil\nelse\n  newLayout = theLayout.Clone\n  newLayout.SetName ( newLayoutName )\n  myProj.AddDoc ( newLayout )\n  newLayout.GetWin.Open\nend\n\n'End of script..."
)

(Script.78
	Name:	"LayoutTools.General_Documentation"
	SourceCode:	"'#################################################################\n'#\n'# Filename:     LayoutTools.Documentation.ave\n'# Author:       Adrian Boehlen\n'# Date:         10.03.2019\n'# Version:      0.10\n'#\n'# Purpose:      enthaelt den Text fuer die Hilfeseiten\n'#\n'#################################################################\n\n\n_uebersicht = \n\"===============================================\"+NL+\n\"                        Commands and their functions\"+NL+\n\"===============================================\"+NL+N
L+\n\"new                 Creates a new layout document\"+NL+\n\"copy                Copies a layout\"+NL+\n\"fi                      Imports textfiles\"+NL+\n\"fis                    Imports textfiles preformatted\"+NL+\n\"help                 Shows this help page\"+NL+\n\"help <cmd>     Shows the help for the chosen command\"+NL+\n\"hlon                 Switches guides on (for the active layout)\"+NL+\n\"hlonm              Switches guides on (for many layouts)\"+NL+\n\"hloff                 Switches guides off (for the active layo
ut)\"+NL+\n\"hloffm              Switches guides off (for many layouts)\"+NL+\n\"heado              Creates header and footer for the active layout\"+NL+\n\"headm             Creates header and footer for many layouts\"+NL+\n\"delhead           Deletes header and footer for the chosen layouts\"+NL+\n\"mx<value>       Moves the selected elements on the x axis\"+NL+\n\"my<value>       Moves the selected elements on the y axis\"+NL+\n\"lytimp               Imports a layout from an ODB file \"+NL+\n\"lytexp               Exports one o
r more layouts into an ODB file\"+NL+\n\"ol                      Imports text for ordered list\"+NL+\n\"ols                    Imports text preformatted for ordered list\"+NL+\n\"regm                Creates registration marks\"+NL+\n\"selall                Selects all elements on the active layout\"+NL+\n\"ti                      Imports text\"+NL+\n\"tis                     Imports text preformatted\"+NL+\n\"ul                      Imports text for unordered list\"+NL+\n\"uls                    Imports text preformatted for unord
ered list\"+NL+\n\"unselall            Unselect all selected elements\"+NL+\n\"zoomex            Zoom to exportview\"+NL\n\n_helpnew =\n\"Creates a new layout\"+NL+\n\"---------------------------------\"+NL+NL+\n\"1. Define the parameters for the new layout document\"+NL+\n\"2. ...or take over the predefined ones\"+NL+NL+\n\"The new layout will be added and opened\"\n\n\n_helpcopy =\n\"Copies a layout\"+NL+\n\"------------------------\"+NL+NL+\n\"1. Choose a layout to copy\"+NL+\n\"2. Enter a name for the new layout\"+NL+NL+\n\"The new layout will
 be added and opened\"\n\n\n_helphlon =\n\"Switch guides on (for the active layout)\"+NL+\n\"-------------------------------------------------------------\"+NL+NL+\n\"\"\"hlon\"\" stands for \"\"Hilfslinie (German for guide) on\"\" \"+NL+NL+\n\"In the active layout, switches previously turned off guides on again.\"\n\n_helphlonm =\n\"Switch guides on (for many layouts)\"+NL+\n\"-------------------------------------------------------\"+NL+NL+\n\"\"\"hlon\"\" stands for \"\"Hilfslinie (German for guide) on\"\" \"+NL+NL+\n\"In the chosen layouts, switche
s previously turned off guides on again.\"\n\n_helphloff =\n\"Switch guides off (for the active layout)\"+NL+\n\"-------------------------------------------------------------\"+NL+NL+\n\"\"\"hloff\"\" stands for \"\"Hilfslinie (German for guide) off\"\" \"+NL+NL+\n\"In the active layout, switches guides, created with the horizontal/vertical lines tool, off.\"\n\n_helphloffm =\n\"Switch guides off (for many layouts)\"+NL+\n\"------------------------------------------------------\"+NL+NL+\n\"\"\"hloff\"\" stands for \"\"Hilfslinie (German for guid
e) off\"\" \"+NL+NL+\n\"In the chosen layouts, switches guides, created with the horizontal/vertical lines tool, off.\"\n\n_helpheado =\n\"Creates header and footer for the active layout\"+NL+\n\"-------------------------------------------------------------------------\"+NL+NL+\n\"\"\"heado\"\" stands for \"\"header (and footer) for one (layout)\"\" \"+NL+NL+\n\"The following parameters are predefined:\"+NL+NL+\n\"Header (optional):\"+NL+\n\"- a text on the left and/or a text on the right\"+NL+\n\"Footer:\"+NL+\n\"- left: filename with or withou
t the layoutname\"+NL+\n\"- centre: the author's name\"+NL+\n\"- right: a text, e.g. the date or the page number\"\n\n_helpheadm =\n\"Creates header and footer for many layouts\"+NL+\n\"--------------------------------------------------------------------\"+NL+NL+\n\"\"\"headm\"\" stands for \"\"header (and footer) for many (layouts)\"\" \"+NL+NL+\n\"At least one layout has to be chosen.\"+NL+\n\"The following parameters are predefined:\"+NL+NL+\n\"Header (optional):\"+NL+\n\"- a text on the left and/or a text on the right\"+NL+\n\"Footer:\"+NL+\n\"-
 left: the filename\"+NL+\n\"- centre: the author's name\"+NL+\n\"- right: the number of the actual page and the total number of pages\"\n\n_helpdelhead =\n\"Deletes header and footer for the chosen layouts\"+NL+\n\"----------------------------------------------------------------------------\"+NL+NL+\n\"\"\"delhead\"\" stands for \"\"delete header (and footer)\"\" \"+NL+NL+\n\"Header and footer for the chosen layouts will be deleted.\"\n\n_helplytimp =\n\"Imports a layout from an ODB file\"+NL+\n\"---------------------------------------------
------\"+NL+NL+\n\"\"\"lytimp\"\" stands for \"\"layout import\"\" \"+NL+NL+\n\"Select an ODB file which will be imported into one or more new layout documents.\"\n\n_helplytexp =\n\"Exports one or more layouts into an ODB file\"+NL+\n\"----------------------------------------------------------------------\"+NL+NL+\n\"\"\"lytexp\"\" stands for \"\"layout export\"\" \"+NL+NL+\n\"Select one or more layouts to write them into an ODB file.\"\n\n_helpfi =\n\"Imports a textfile\"+NL+\n\"-------------------------\"+NL+NL+\n\"\"\"fi\"\" stands for \"\"file import\"\" \"
+NL+NL+\n\"Imports the full content of a text file into the layout. There must be a selected textbox (with or without content). This will be the upper left corner of the new textbox.\"+NL+NL+\n\"1. Select the text file to import\"+NL+\n\"2. Define the width of the new textblock.\"+NL+\n\"3. Choose the font, the font style and the font colour. Some colours are predefined, but it's possible to mix any colour by it's RGB value.\"+NL+\n\"4. Define the font size\"+NL+\n\"The content of the chosen text file will then be visible i
nside the still selected textbox.\"+NL+\n\"Note: Special characters can be given by their triple-digit ASCII code, prefixed with \\\"\n\n_helpfis =\n\"Imports a textfile preformatted\"+NL+\n\"----------------------------------------------\"+NL+NL+\n\"\"\"fis\"\" stands for \"\"file import simple\"\" \"+NL+NL+\n\"Imports the full content of a text file into the layout. The font definition ist predefined (DejaVu Sans, Condensed, black), except the size. There must be a selected textbox (with or without content). This will be the upper
 left corner of the new textbox.\"+NL+NL+\n\"1. Select the text file to import\"+NL+\n\"2. Define the width of the new textblock.\"+NL+\n\"3. Define the font size\"+NL+\n\"The content of the chosen text file will then be visible inside the still selected textbox.\"+NL+\n\"Note: Special characters can be given by their triple-digit ASCII code, prefixed with \\\"\n\n_helpoli =\n\"Imports text for ordered list\"+NL+\n\"-----------------------------------------\"+NL+NL+\n\"\"\"ol\"\" stands for \"\"ordered list import\"\" \"+NL+NL+\n\"Imports the c
ontent of a text window into the layout for building an ordered list. There must be a selected textbox (with or without content). This will be the upper left corner of the new textbox.\"+NL+NL+\n\"1. Type or paste text into the new window \"\"Import Text\"\". The beginning of each list element must be marked with the character \"\"¬\"\"\"+NL+\n\"2. Define the width of the new textblock.\"+NL+\n\"3. Choose the font, the font style and the font colour. Some colours are predefined, but it's possible to mix any colour by it's R
GB value.\"+NL+\n\"4. Define the font size\"+NL+\n\"5. Define the space between the marker and the text\"+NL+\n\"The content of the text window will then be visible inside the still selected textbox. The markers belonging to it will appear at the given distance to the left.\"+NL+\n\"Note: Special characters can be given by their triple-digit ASCII code, prefixed with \\\"\n\n_helpolis =\n\"Imports text for ordered list preformatted\"+NL+\n\"--------------------------------------------------------------\"+NL+NL+\n\"\"\"ols\"\" stands f
or \"\"ordered list import simple\"\" \"+NL+NL+\n\"Imports the content of a text window into the layout for building an ordered list. The font definition ist predefined (DejaVu Sans, Condensed, black), except the size. There must be a selected textbox (with or without content). This will be the upper left corner of the new textbox.\"+NL+NL+\n\"1. Type or paste text into the new window \"\"Import Text\"\". The beginning of each list element must be marked with the character \"\"¬\"\"\"+NL+\n\"2. Define the width of the new textb
lock.\"+NL+\n\"3. Define the font size\"+NL+\n\"The content of the text window will then be visible inside the still selected textbox. The markers belonging to it will appear at the given distance to the left.\"+NL+\n\"Note: Special characters can be given by their triple-digit ASCII code, prefixed with \\\"\n\n_helpuli =\n\"Imports text for unordered list\"+NL+\n\"---------------------------------------------\"+NL+NL+\n\"\"\"ul\"\" stands for \"\"unordered list import\"\" \"+NL+NL+\n\"Imports the content of a text window into the layout 
for building an unordered list. There must be a selected textbox (with or without content). This will be the upper left corner of the new textbox.\"+NL+NL+\n\"1. Type or paste text into the new window \"\"Import Text\"\". The beginning of each list element must be marked with the character \"\"¬\"\"\"+NL+\n\"2. Define the width of the new textblock.\"+NL+\n\"3. Choose the font, the font style and the font colour. Some colours are predefined, but it's possible to mix any colour by it's RGB value.\"+NL+\n\"4. Define the font siz
e\"+NL+\n\"5. Define the space between the bullets and the text\"+NL+\n\"6. Define the character for the bullet (ASCII decimal)\"+NL+\n\"The content of the text window will then be visible inside the still selected textbox. The bullets belonging to it will appear at the given distance to the left.\"+NL+\n\"Note: Special characters can be given by their triple-digit ASCII code, prefixed with \\\"\n\n_helpulis =\n\"Imports text for unordered list preformatted\"+NL+\n\"--------------------------------------------------------------
----\"+NL+NL+\n\"\"\"uls\"\" stands for \"\"unordered list import simple\"\" \"+NL+NL+\n\"Imports the content of a text window into the layout for building an unordered list. The font definition ist predefined (DejaVu Sans, Condensed, black), except the size. There must be a selected textbox (with or without content). This will be the upper left corner of the new textbox.\"+NL+NL+\n\"1. Type or paste text into the new window \"\"Import Text\"\". The beginning of each list element must be marked with the character \"\"¬\"\"\"+NL+\n\"2.
 Define the width of the new textblock.\"+NL+\n\"3. Define the font size\"+NL+\n\"The content of the text window will then be visible inside the still selected textbox. The bullets belonging to it will appear at the given distance to the left.\"+NL+\n\"Note: Special characters can be given by their triple-digit ASCII code, prefixed with \\\"\n\n_helpti =\n\"Imports text\"+NL+\n\"------------------\"+NL+NL+\n\"\"\"ti\"\" stands for \"\"text import\"\" \"+NL+NL+\n\"Imports the content of a text window into the layout. There must be a select
ed textbox (with or without content). This will be the upper left corner of the new textbox.\"+NL+NL+\n\"1. Type or paste text into the new window \"\"Import Text\"\"\"+NL+\n\"2. Define the width of the new textblock.\"+NL+\n\"3. Choose the font, the font style and the font colour. Some colours are predefined, but it's possible to mix any colour by it's RGB value.\"+NL+\n\"4. Define the font size\"+NL+\n\"The content of the text window will then be visible inside the still selected textbox.\"+NL+\n\"Note: Special characters can 
be given by their triple-digit ASCII code, prefixed with \\\"\n\n_helptis =\n\"Imports text preformatted\"+NL+\n\"---------------------------------------\"+NL+NL+\n\"\"\"tis\"\" stands for \"\"text import simple\"\" \"+NL+NL+\n\"Imports the content of a text window into the layout. The font definition ist predefined (DejaVu Sans, Condensed, black), except the size. There must be a selected textbox (with or without content). This will be the upper left corner of the new textbox.\"+NL+NL+\n\"1. Type or paste text into the new window \"
\"Import Text\"\"\"+NL+\n\"2. Define the width of the new textblock.\"+NL+\n\"3. Define the font size\"+NL+\n\"The content of the text window will then be visible inside the still selected textbox.\"+NL+\n\"Note: Special characters can be given by their triple-digit ASCII code, prefixed with \\\"\n\n_helpregm =\n\"Creates registration marks\"+NL+\n\"----------------------------------------\"+NL+NL+\n\"\"\"regm\"\" stands for \"\"registration marks\"\" \"+NL+NL+\n\"Creates registration marks at all 4 corners of the layout.\"+NL+\n\"Note that the pa
ge size defined in \"\"Layout -> Page Setup\"\" must be larger than the size entered in this tool, otherwise the registration marks will be outside the layout. The default size is DIN A4.\"\n\n_helpselall =\n\"Selects all elements on the active layout\"+NL+\n\"---------------------------------------------------------------\"+NL+NL+\n\"\"\"selall\"\" stands for \"\"select all\"\" \"+NL+NL+\n\"Selects all graphic elements on the layout.\"\n\n_helpunselall =\n\"Unselects all selected elements\"+NL+\n\"------------------------------------------
-------\"+NL+NL+\n\"\"\"unselall\"\" stands for \"\"unselect all\"\" \"+NL+NL+\n\"Unselects all selected graphic elements on the layout.\"\n\n_helpmx =\n\"Moves the selected element(s) on the x axis\"+NL+\n\"--------------------------------------------------------------------\"+NL+NL+\n\"\"\"mx\"\" stands for \"\"move x\"\" \"+NL+NL+\n\"Moves the selected element(s) on the x axis.\"+NL+NL+\n\"1. Select the feature(s) that has to be moved.\"+NL+\n\"2. Type \"\"mx\"\" and the amount in mm without any blank between. Use positive values for moving to the r
ight and negative ones for moving to the left.\"+NL+\n\"e.g. \"\"mx50\"\" moves the selected element(s) 50 mm to the right.\"+NL+\n\"       \"\"mx-50\"\" moves the selected element(s) 50 mm to the left.\"\n\n_helpmy =\n\"Moves the selected element(s) on the y axis\"+NL+\n\"--------------------------------------------------------------------\"+NL+NL+\n\"\"\"my\"\" stands for \"\"move y\"\" \"+NL+NL+\n\"Moves the selected element(s) on the y axis.\"+NL+NL+\n\"1. Select the feature(s) that has to be moved.\"+NL+\n\"2. Type \"\"my\"\" and the amount in mm 
without any blank between. Use positive values for moving upwards and negative ones for moving downwards.\"+NL+\n\"e.g. \"\"my50\"\" moves the selected element(s) 50 mm upwards.\"+NL+\n\"       \"\"my-50\"\" moves the selected element(s) 50 mm downwards.\"\n\n"
)

(Script.79
	Name:	"LayoutTools.General_GraphicTable"
	SourceCode:	"' Name:   Layout.GraphicTable\n' Title:  Places a Graphic of the table you specify into a layout\n'\n' Topics : Layouts\n' Version: 3.0a.02\n' Source : ArcView Sample scripts\n' Changed: 07-30-98\n' By     : Rob Buurman\n'          rbuurman@isis.nl\n'          ISIS BENELUX\n'          \n'\n' Description:  Use the tool with this script attached as the \n' apply event to drag a rectangle in a layout.  You will be prompted\n' to choose which table you want to make the representation of \n' and which fields to show.\n' When th
e table has an selection, you will be asked if you want to display\n' only the selected records. You can bypass this question by pressing the\n' shift-key when you drag the rectangle in a layout.\n' The script will populatate rows with cell values of those fields until the \n' bottom of the rectangle you specified is reached.\n' If you choose more fields than would fit within the width of the rectangle,\n' those will be included.\n'\n' This script gets around several annoying limitations in ArcView's\n' TableFrame g
raphic:\n' \n' 1) With this script you can make a table that is wider than 80\n'    text columns. (Great for landscape docs).\n' 2) You change the font of this table.\n' 3) Since this table is graphicgroup, you can ungroup it and\n'    change the symbols for individual parts.\n' 4) This table will always print correctly - on some printers\n'    printing directly from the table doc & from table frames,\n'    there were gross formating errors\n' 5) You can resize this table and the text just gets resized,\n'    rather t
han including more data like the tableframe does.\n' \n' This script cannot produce the representation of the table if\n' it is sorted - you will get the unsorted version.  Additionally,\n' since this representation is just a dumb graphic, it does not\n' automatically update itself in any way, shape, or form.\n'\n' Additionally, you can use the symbol window to change the button \n' color by using the foreground, change the table background by using\n' the background color, or change the text and outline color as we
ll.\n' If you want to highlight a particular column, ungroup the graphic\n' table and then you can select the column by clicking on its border,\n' then change its background color or text color by using background\n' or text from the color palette.\n'\n' Requires:  Place this script as the apply event for a tool in \n' your Layout GUI.  There must be at least one table document in \n' the current project.\n'\n' Self:  \n'\n' Returns:  \n\ntheLayout = av.GetActiveDoc\ngl = theLayout.GetGraphics\nbRect = theLayout.ReturnUser
Rect\nif (bRect.GetWidth < 0.1) then\n  return nil\nend\n\nif (System.IsShiftKeyDown) then\n  SelectedOnly = true\nelse\n  SelectedOnly = false\nend\n\nTableDocNames = {}\nfor each d in av.GetProject.GetDocs\n  if(d.Is(Table)) then\n    TableDocNames.Add(d.GetName)\n  end\nend\n\nif (TableDocNames.Count = 0) then\n  Msgbox.Error(\"You must have a table document in the Project\",\"Buh!\")\n  return nil\nend\ngl.UnSelectAll\n\nTableName = Msgbox.ChoiceAsString(TableDocNames,\"Choose a table:\",\"Smart Table\")\nif (TableName = nil) then\n  re
turn nil\nend\n\ntheTable = av.GetProject.FindDoc(TableName)\ntheVTab = theTable.GetVTab\ntheFieldNames = {}\nfor each f in theVTab.GetFields\n  if (f.IsTypeShape.Not) then\n    theFieldNames.Add(f.GetAlias)\n  end\nend\n\n\nFieldsToShow = Msgbox.MultiListAsString(theFieldNames,\"Choose the Fields to Show\",\"Smart Table\")\nif (FieldsToShow = nil) then return nil end\nif (FieldsToShow.Count = 0) then\n  return nil\nend\n\n  if (SelectedOnly) then\n    theBitmap = theVTab.GetSelection\n  else\n    theBitmap = theVTab.GetDefBitmap\n  
  if (theVTab.GetSelection.Count <> 0) then\n      if (Msgbox.YesNo(\"Use only the selected records\",\"Smart Table\", true)) then\n        theBitmap = theVTab.GetSelection\n      end\n    end\n  end\n\n' Background color for field names\nbc = Color.Make\nbc.SetRGBList({255,255,225})\nftbf = RasterFill.Make\nftbf.SetStyle(#RASTERFILL_STYLE_SOLID)\nftbf.SetColor(bc)\n\nbRectO = bRect.ReturnOrigin\nbRectH = bRect.GetHeight\nbRectW = bRect.GetWidth\nbRectT = bRect.GetTop\nbrectB = bRect.GetBottom\nbRectR = bRect.GetRight\nHeightLeft 
= bRect.GetHeight\n\ntbo = bRectO + (0@bRectH)\ncspace = 0\n\nfor each f in FieldsToShow\n  \n  'Make Field Title\n  fl = GraphicText.Make(f,(tbo +(0.1@0)) )\n  fl.GetSymbol.SetSize(12)\n  fl.SetDisplay(theLayout.GetDisplay)\n  tbo = tbo - (0@(fl.GetBounds.GetHeight + 0.05))\n  fl.SetSelected(true)\n  \n  gl.AddBatch(fl)\n  HeightLeft = HeightLeft - fl.GetBounds.GetHeight - 0.05\n  HbarHeight = HeightLeft\n\n  \n  'Now do the column of values\n  counter = -1\n  ColStr = \"\"\n  vst = GraphicText.Make(ColStr,(0@0))\n  vst.SetDisplay
(theLayout.GetDisplay)\n  vst.GetSymbol.SetSize(10)\n  While (HeightLeft <> 0)\n    rec = theBitmap.GetNextSet(counter)\n    counter = rec\n    ValStr = theVTab.ReturnValueString(theVTab.FindField(f),rec)\n    ColStr = ColStr + ValStr\n    vst.SetText(ColStr)\n    'Check to see if column has exceeded Height\n    if (HeightLeft < vst.GetBounds.GetHeight) then\n      HeightLeft = 0\n    end \n    if (theBitmap.GetNextSet(counter) = -1) then\n      HeightLeft = 0\n    end\n    ColStr = ColStr + nl\n  end\n  \n  vst.SetOrigin(tb
o - (0@(vst.getBounds.GetHeight)) )\n  \n  'Check to see if the Column is wider than the Title\n  if (fl.GetBounds.GetWidth > vst.GetBounds.GetWidth) then\n    'Title is wider, so move column\n    if (theVTab.FindField(f).IsTypeNumber) then\n      vst.SetAlignment(#TEXTCOMPOSER_JUST_RIGHT)\n      vst.GetBounds.Move((fl.GetBounds.GetWidth - vst.GetBounds.GetWidth + 0.1),0.1)\n      gl.AddBatch(vst)\n    elseif(theVTab.FindField(f).IsTypeString) then\n      vst.SetAlignment(#TEXTCOMPOSER_JUST_LEFT)\n      vst.GetBounds.
Move(0.1,0.1)\n      gl.AddBatch(vst)\n    end  \n  else\n    'Column is wider so move  & justify title\n    if (theVTab.FindField(f).IsTypeNumber) then\n      vst.SetAlignment(#TEXTCOMPOSER_JUST_RIGHT)\n      vst.GetBounds.Move(0.1, 0.1)\n      gl.AddBatch(vst)\n    elseif (theVTab.FindField(f).IsTypeString) then\n      vst.SetAlignment(#TEXTCOMPOSER_JUST_LEFT)\n      vst.GetBounds.Move(0.1, 0.1)\n      gl.AddBatch(vst)\n    end    \n    fl.GetBounds.Move( ( (vst.GetBounds.GetWidth - fl.GetBounds.GetWidth) /2 ) ,0)\n  en
d  \n  vst.SetSelected(true)\n  \n  cbr = gl.ReturnSelectedExtent.clone\n  cbr.ExpandBy(0.05)\n  cbp = GraphicShape.Make(cbr)\n  cbp.GetSymbol.SetOLWidth(0.1)\n  gl.AddBatch(cbp)\n  cbp.SetSelected(true)  \n  gl.GroupSelected\n  gl.GetSelected.Get(0).SetObjectTag(\"col\")\n  cspace = cspace + gl.ReturnSelectedExtent.GetWidth  \n  gl.UnSelectAll\n  HeightLeft = bRectH\n  tbo = bRectO + (cspace@bRectH)\nend\n\n\nfor each g in gl.FindAllByObjectTag(\"col\")\n  g.SetSelected(true)\nend\n\nse = gl.ReturnSelectedExtent\nseO = se.ReturnOrig
in\nftr = Rect.Make(SeO + (0@(se.GetHeight - 0.275)),(se.GetWidth@0.275))\n\ncoltits = {}\nfor each g in gl.FindAllByObjectTag(\"col\")\n  colTitleRect = ftr.IntersectWith(g.GetBounds.Clone)\n  coltits.Add(colTitleRect)\n  g.SetSelected(false)\nend\ntc = Color.Make\ntc.SetTransParent(true)\n\n\n\n\nfor each ftr in coltits\n  bp = ftr.Clone.InsetBy(0.0125)\n  bpd = Polygon.Make({{ftr.ReturnOrigin,(ftr.GetRight@ftr.GetBottom),(ftr.GetRight@ftr.GetTop),(bp.GetRight@bp.GetTop),(bp.GetLeft@bp.GetBottom),ftr.ReturnOrigin}})\n  bpl =
 Polygon.Make({{ftr.ReturnOrigin,(bp.ReturnOrigin),(bp.GetRight@bp.GetTop),(ftr.GetRight@ftr.GetTop),(ftr.GetLeft@ftr.GetTop),ftr.ReturnOrigin}})\n  gbp = GraphicShape.Make(bp)\n  gbpd = GraphicShape.Make(bpd)\n  gbpl = GraphicShape.Make(bpl)\n  gbp.SetSymbol(ftbf.Clone)\n  gbpd.SetSymbol(ftbf.Clone)\n  gbpl.SetSymbol(ftbf.Clone)\n  lg = Color.Make\n  lg.SetRGBList({220,220,220})\n  dg = Color.Make\n  dg.SetRGBList({120,120,120})\n  gbpd.GetSymbol.SetColor(dg.Clone)\n  gbpl.GetSymbol.SetColor(lg.Clone)\n  gbpl.GetSymbol
.SetOLWidth(0)\n  gbpd.GetSymbol.SetOLWidth(0)\n  gbpl.GetSymbol.SetColorLock(true)\n  gbpd.GetSymbol.SetColorLock(true)\n  gbp.GetSymbol.SetOLWidth(0)\n  gbpl.GetSymbol.SetOLColor(tc.Clone)\n  gbpd.GetSymbol.SetOLColor(tc.Clone)\n  gbp.GetSymbol.SetOLColor(tc.Clone)\n  gl.AddBatch(gbpd)\n  gl.AddBatch(gbpl)\n  gl.AddBatch(gbp)\n  gbpd.SetSelected(true)\n  gbpl.SetSelected(true)\n  gbp.SetSelected(True)\nend\ngl.GroupSelected\ngl.MoveSelectedToBack\ngl.GetSelected.Get(0).SetObjectTag(\"buttons\")\ngl.UnSelectAll  \n\nfor each g 
in gl.FindAllByObjectTag(\"col\")\n  g.SetSelected(true)\n  gl.MoveSelectedToFront\nend\ngl.FindByObjectTag(\"buttons\").SetSelected(true)\n\nNeatRect = gl.ReturnSelectedExtent.Clone\nnrgs = GraphicShape.Make(NeatRect)\nnrgs.GetSymbol.SetOLWidth(0.6)\ntheLayout.GetGraphics.AddBatch(nrgs)\n\ngl.UnSelectAll\n\nbp = GraphicShape.Make(NeatRect)\nbw = Color.GetWhite\nbpf = RasterFill.Make\nbpf.SetStyle(#RASTERFILL_STYLE_OPAQUESTIPPLE)\nbp.SetSymbol(bpf)\nbp.GetSymbol.SetColor(tc.Clone)\nbp.GetSymbol.SetBGColor(Color.GetWhite)\ntheLayou
t.GetGraphics.AddBatch(bp)\nbp.SetSelected(True)\ngl.MoveSelectedToBack\n\nfor each g in gl.FindAllByObjectTag(\"col\")\n  g.SetSelected(true)\nend\ngl.FindByObjectTag(\"buttons\").SetSelected(true)\nnrgs.SetSelected(true)\ngl.GroupSelected\n\n\ntheLayout.GetGraphics.EndBatch\n"
)

(Script.80
	Name:	"LayoutTools.General_MakeRegistrationMarks"
	SourceCode:	"'##################################################################\n'#  Name:          Layout.MakeRegistrationMarks\n'#  Author:        Adam Hyer\n'#                 ashyer@syr.edu, ashyer@hotmail.com\n'#\n'#  Date Written:  2.24.99\n'#\n'#  Description:   Puts registration marks on a layout for printing.\n'#                 This is intended for plotters when you need to\n'#                 make the page size larger in order to show the \n'#                 entire layout.  The registration marks allow you\n'#        
         to cut paper to it's originally intended page\n'#                 size.\n'#\n'#  Instructions:  Add a new button to the active layout add this\n'#                 script to the new button's click property.  Click\n'#                 the button when you want to add the marks and\n'#                 specify the desired dimensions for the marks.\n'#\n'#  Revision:      A.Boehlen 16/07/2017\n'#\n'#                 erfordert:\n'#                 - LayoutTools.Sub_DefaultValues\n'#\n'#################################
#################################\n\nav.Run(\"LayoutTools.Sub_DefaultValues\", {})   '# Defaultwerte einlesen\ntheLayout = av.GetActiveDoc  \n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\nh=MsgBox.Input(\"Enter the page height in mm:\",\" \",_seitenhoehe.AsString)\nif (h = nil) then\n  return nil\nend\nw=MsgBox.Input(\"Enter the page width in mm:\",\" \",_seitenbreite.AsString)\nif (w = nil) then\n  return nil\nend\nheight=h.AsNumber * 0.03937    ' converts 
mm to inches\nwidth=w.AsNumber * 0.03937     ' converts mm to inches\n\nd = av.GetActiveDoc.GetDisplay\nr = d.ReturnPageExtent\nrc = r.ReturnCenter\nlf = rc.GetX-(width/2)\nrt = rc.GetX+(width/2)\ntp = rc.GetY+(height/2)\nbm = rc.GetY-(height/2)\nlfL = lf-0.2\nlfR = lf-0.02 \nrtL = rt+0.02\nrtR = rt+0.2\ntpU = tp+0.2\ntpD = tp+0.02\nbmU = bm-0.02\nbmD = bm-0.2\n\naPen = BasicPen.Make\naPen.SetColor(Color.GetBlack)\naPen.SetSize(1)\n\nTL1 = Line.Make( lf@tpU, lf@tpD)\nTL2 = Line.Make( lfL@tp, lfR@tp)\nTR1 = Line.Make( rt@tpU, rt@tpD
)\nTR2 = Line.Make( rtL@tp, rtR@tp)\nBL1 = Line.Make( lf@bmU, lf@bmD)\nBL2 = Line.Make( lfL@bm, lfR@bm)\nBR1 = Line.Make( rt@bmU, rt@bmD)\nBR2 = Line.Make( rtL@bm, rtR@bm)\n\ngTL1 = GraphicShape.Make(TL1)\ngTL1.SetSymbol(aPen)\ngTL2 = GraphicShape.Make(TL2)\ngTL2.SetSymbol(aPen)\ngTR1 = GraphicShape.Make(TR1)\ngTR1.SetSymbol(aPen)\ngTR2 = GraphicShape.Make(TR2)\ngTR2.SetSymbol(aPen)\ngBL1 = GraphicShape.Make(BL1)\ngBL1.SetSymbol(aPen)\ngBL2 = GraphicShape.Make(BL2)\ngBL2.SetSymbol(aPen)\ngBR1 = GraphicShape.Make(BR1)\ngBR1.Set
Symbol(aPen)\ngBR2 = GraphicShape.Make(BR2)\ngBR2.SetSymbol(aPen)\n\ntheLayout.GetGraphics.UnselectAll\ngTL1.SetSelected(TRUE)\ngTL2.SetSelected(TRUE)\ngTR1.SetSelected(TRUE)\ngTR2.SetSelected(TRUE)\ngBL1.SetSelected(TRUE)\ngBL2.SetSelected(TRUE)\ngBR1.SetSelected(TRUE)\ngBR2.SetSelected(TRUE)\n\ntheLayout.GetGraphics.Add(gTL1)\ntheLayout.GetGraphics.Add(gTL2)\ntheLayout.GetGraphics.Add(gTR1)\ntheLayout.GetGraphics.Add(gTR2)\ntheLayout.GetGraphics.Add(gBL1)\ntheLayout.GetGraphics.Add(gBL2)\ntheLayout.GetGraphics.Add(gBR1)\ntheL
ayout.GetGraphics.Add(gBR2)\nav.GetProject.SetModified(TRUE)\n\n"
)

(Script.81
	Name:	"LayoutTools.General_Measure"
	SourceCode:	"theLayout = av.GetActiveDoc\np = theLayout.ReturnUserPolyLine"
)

(Script.82
	Name:	"LayoutTools.General_MoveFeature"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_MoveFeature.ave\n'# Author:       Adrian Boehlen\n'# Date:         27.08.2017\n'# Version:      0.2\n'#\n'# Purpose:      verschiebt die selektierten Features um den eingegeben\n'#               Wert in mm\n'#               Das Kommando wird mit mx (move x) oder my (move y)\n'#               ausgeloest\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc\n\ni
f (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\nwert = _command.Middle(2,5)\nwert = wert.AsNumber\nwert = wert / 25.4     '# mm to inch\ntheGraphicList = theLayout.GetGraphics\nif (theGraphicList.HasSelected = TRUE) then\n  for each theSelected in theGraphicList.GetSelected\n    theOrigin = theSelected.GetOrigin\n    theX = theOrigin.GetX\n    theY = theOrigin.GetY\n    if (_command.Left(2) = \"mx\") then\n      theX = theX + wert\n    else\n      theY =
 theY + wert\n    end\n    theSelected.SetOrigin(theX@theY)\n  end\nend\n\ntheLayout.Invalidate\n\n"
)

(Script.83
	Name:	"LayoutTools.General_NewLayout"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_NewLayout.ave\n'# Author:       Adrian Boehlen\n'# Date:         10.09.2017\n'# Version:      0.2\n'#\n'# Purpose:      erstellt ein neues Layout-Dokument\n'#               Parameter koennen ueber den Dialog eingegeben werden\n'#               Default: A4 hoch\n'#\n'#########################################################################\n\n'# Variablen initialisieren\n\nparam = MsgBox.MultiInput(\"\",\"Define the La
yout's Parameters\",\n{\"Name                                  :\",\n \"Length (mm)                        :\",\n \"Hight (mm)                          :\",\n \"Margin left/right (mm)          :\",\n \"Margin top/bottom (mm)      :\",\n \"Grid spacing horizontal (mm):\",\n \"Grid spacing vertical (mm)   :\"},\n{\"01\", \"210\", \"297\", \"15\", \"18\", \"2\", \"5\"})\n\nif (param.Count = 0) then\n  MsgBox.Warning(\"Cancel Pressed: No Data Entered\", \"Canceling the Dialog\")\n  return nil\nend\n\ntheProject =   av.GetProject\ntheLayout =    Layout.Make\nth
eLayout.SetName(param.Get(0))\ntheLayoutDpy = theLayout.GetDisplay\ntheLayoutGL =  theLayout.GetGraphics\n\n'# convert millimeters to inches\nlaenge =       param.Get(1).AsNumber / 25.4\nbreite =       param.Get(2).AsNumber / 25.4\nabst_hoehe =   param.Get(3).AsNumber / 25.4\nabst_breite =  param.Get(4).AsNumber / 25.4\ngitter_h =     param.Get(5).AsNumber / 25.4\ngitter_b =     param.Get(6).AsNumber / 25.4\n\nPageManager.GetUnits(#PAGEMANAGER_SIZE_A4)\n\n'# Parameter setzen\nmarginRect = Rect.MakeXY(abst_breite, abst_hoe
he, abst_breite, abst_hoehe)\ntheLayoutDpy.SetUsingPrinterPageSize(false)\ntheLayoutDpy.SetUsingPrinterMargins(false)\ntheLayoutDpy.SetUnits(#UNITS_LINEAR_MILLIMETERS)\ntheLayoutDpy.SetMargin(marginRect)\ntheLayoutDpy.SetMarginVisible(true)\ntheLayoutDpy.SetPageSize(Point.Make(laenge, breite))\ntheLayoutDpy.SetGridActive(false)\ntheLayoutDpy.SetGridVisible(true)\ntheLayoutDpy.SetGridMesh(Point.Make(gitter_h, gitter_b))\n\n'# Dokument oeffnen\ntheLayoutWin = theLayout.GetWin\ntheLayoutWin.Open\ntheLayoutDpy.ZoomToPage"
)

(Script.84
	Name:	"LayoutTools.ImpExp_BatchExport"
	SourceCode:	"'NAME:     LayoutBatchExport\n'DATE:     160801\n'AUTHOR:   Sebastian Hofer - shofer@gmx.de\n\n'DESCRIPTION:\n'LayoutBatchExport is for fast export of multiple Layouts out of a project into eps (new) or jpg.\n'Other formats will not be implemented by me. Feel Free to do it.\n'After selecting the export parameters (file type, resolution, compression) and the LayoutdDocs\n'the user is prompted to chose the export filenames by Dialog.\n'It is not necessary to open the Layouts in a window before of the export!\n\n' REQUIR
ES:   ---\n\n' LayoutBatchExport eignet sich zum schnellen Export von mehreren Layouts \n' im selben Datenformat und mit den selben Parametern.\n' Meinen Bedürfnissen nach wird nur eps (new) und jpg unterstützt. Wer andere \n' Formate unterstuetzen will darf die gerne einbauen. \n' Es ist nicht noetig die zu exportierenden Layouts als Fenster zu oeffnen!\n\n\ntheFormatL={\"eps (New)\", \"jpg\"}\ntheFormatChoice=msgBox.ListAsString(theFormatL, \"Choose the LayoutBatchExport format:\", \"LayoutBatchExport\")\nif  (theFormatChoi
ce=Nil) then return Nil\nelseif (theFormatChoice=\"eps (New)\") then theShortFormat=3 \n  theResL={300,360,600,720,900}\n  theResolution=msgBox.ListAsString(theResL, \"Choose the LayoutBatchExport resolution:\", \"LayoutBatchExport\")\nif  (theResolution=Nil) then return Nil end\nelseif (theFormatChoice=\"jpg\") then theShortFormat=9 \n  theResL={72,90,120,144}\n  theResolution=msgBox.ListAsString(theResL, \"Choose the LayoutBatchExport resolution:\", \"LayoutBatchExport\")\nif  (theResolution=Nil) then return Nil end\n  theCom
pressL={20,40,60,80,100}\n  theCompression=msgBox.ListAsString(theCompressL, \"Choose the LayoutBatchExport compression (jpg):\", \"LayoutBatchExport\")\nif  (theCompression=Nil) then return Nil end\nend\ntheProject=av.GetProject\ntheDocL=theProject.GetDocs\ntheLayoutL={}\nfor each theEntry in theDocL\n  if (theEntry.Is(Layout)) then\n    theLayoutL.Add(theEntry)\n  end\nend\nif (theLayoutL.Count=0) then\n  MsgBox.Error(\"No LayoutBatchExport possible. There are no Layouts to export. You have to create Layouts first!\", \"\")\n 
 return nil\nelse\n  theBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose the Layouts to be exported:\", \"LayoutBatchExport\")\n  if (theBatchLayoutL=Nil) then \n    return nil\n  end\n  while (theBatchLayoutL.Count=0) \n    MsgBox.Error(\"No LayoutBatchExport possible. You must choose at least 1 Layout or press cancel to quit:\", \"\")\n    theBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose the Layouts to be exported:\", \"LayoutBatchExport\")\n    if (theBatchLayoutL=Nil) then\n      return nil\n    end\n  end\nend\n\n\ntheFirs
tLayout=theBatchLayoutL.Get(0)\ntheFirstLayout.GetWin.open\ntheFormatL = theBatchLayoutL.Get(0).GetDisplay.ReturnExportFormats\ntheFirstLayout.GetWin.close   '# Layout nach Export schliessen\n\n\ntheFormat = theFormatL.Get(theShortFormat)  \nif (theShortFormat=3) then\n  theFileExt=\"eps\"\nelseif (theShortFormat=9) then\n  theFileExt=\"jpg\"\nend\n\nfor each theBatchLayout in theBatchLayoutL\n  defaultFileName=FileName.Make(theBatchLayout.GetName +\".\"+theFileExt)\n  theFN=FileDialog.Put(defaultFileName, \"*.\"+theFileExt, \"Exp
ort «\"+theBatchLayout.getName+\"» to:\" )\n\n  if (theFN=nil) then\n    return nil\n  end\n  if (theShortFormat=3) then\n    theBatchLayout.ExportToFile(theFN, theFormat, {theResolution})\n  elseif (theShortFormat=9) then\n    theBatchLayout.ExportToFile(theFN, theFormat, {theResolution,theCompression})\n  end\nend\nreturn nil\n"
)

(Script.85
	Name:	"LayoutTools.ImpExp_CreateODB"
	SourceCode:	"\n' NAME: mm_docODBCreate\n\n' HERKUNFT: Harald (neu auf Grundlage von FSA)\n\n' EINBINDUNG MTOOLS: Menueeintrag im Projektmenue (Label: Dokumentauswahl exportieren (ODB))\n\n' HILFE: Oeffnet eine Auswahlliste zur Speicherung von Dokumenten in einem einzelnen ODB-File  (s. STRG-Klick Info)\n\n'*******************************************\n\n' CTRL-KLICK Info (erscheint, wenn das Skript bei gedrueckter Strg- bzw. Ctrl-Taste aufgerufen wird)\n \nif (System.IsControlKeyDown) then\n\n  message =  \" \"+nl+\n    \n    \"SCRIPTNAME: 
   mm_DocODBCreate \"+nl+nl+\n  \n    \"ORIGIN:   Harald (new on FSA Basis). \"+nl+nl+\n    \n    \"Opens a MultiList to write the selected documents to a single ODB file.\"+nl+nl+\n    \n    \"The dependencies of the project (as e.g. extensions) will be listet to annotate them \"+\n    \"in the ODB if desired. In this case they are loaded automatically when the ODB is imported into a blanc project. \"+\n    \"If you don't feel safe upon what extensions your ODB is dependent, it is advisable, to add all obligatory \"+\n    \"ex
tensions of the project at least (find them labeld with ''- fix -'' in the dialog box or with a transparent \"+\n    \"check in the extensions dialog. Extensions that are not obligatory (that you can unload) are labeled with \"+\n    \"''- lax -'' in the dialog box. If the ODB to export contains a grid for example, Spatial- or 3D Analyst are \"+\n    \"obligatory.\"+nl+nl+\n    \n    \"The string  '$'  inheres a split function in this script. Documents, with names containing this sign \"+\n    \"can not be exported. Rename
 this documents or change the split string in the system script called \"+\n    \"''mm_docODBCreate''. \"+nl\n    \n  msgbox.report(message,\"INFO: Export Documents (*.ODB) ...\")\n  \n  return nil\nend\n\n'-------------------------------------------------------\n\ntheProject = av.GetProject\n\nif (theProject = NIL) then\n  return NIL\nend\n\n'-------------------------------------------------------------------------------\n' CREATE DOCLIST \n\ntheDocList = List.Make\n\nfor each d in theProject.GetDocs\n  if (d.Is(Layout)) then  \n    
theGUIString = d.GetGUI\n    theLString = theGUIString.UCase+\" :  \"+d.AsString\n    theDocList.Add(theLString)\n  end\nend\n\nif (theDocList.count = 0) then\n  MsgBox.Info(\"No Docs to be found...\",\"\")\n  return NIL\nend\n\ntheDocList.sort(TRUE)\n\n'-------------------------------------------------------------------------------\n' LET THE USER CHOOSE\n\ntheSelDocs = MsgBox.MultiListAsString(theDocList, \"Select documents to write to the ODB file: \"+\n             \"\", \" Write Docs to ODB\")\n\n\nif ((theSelDocs = NIL) or (theSelDo
cs.Count = 0)) then return NIL end\n\n\n'-------------------------------------------------------------------------------\n' CREATE ODB-FILE, ASK FOR NAME AND PATH, CWD AND \"Docs\" AS DEFAULT\n\ntheCWD = FileName.getCWD\n\nif (File.isWritable(theCWD).not) then\n  av.GetProject.GetWorkDIR.setCWD\n  theCWD = FileName.getCWD\nend\n  \ndefaultName = FileName.Make(theCWD.AsString).MakeTmp(\"Docs\", \"odb\")\ntheDocODB = FileDialog.Put(defaultName, \"*.odb\", \" Save ODB-File as\")\n\nif (theDocODB = NIL) then\n  return NIL\nend\n\ntheODBFile
 = ODB.Make(theDocODB)\n\n'-------------------------------------------------------------------------------\n' ASK FOR DEPENDENCIES\n\ntheProjDepends = av.GetProject.GetDependencies\n\nif (theProjDepends.count > 0) then\n\n  dctExts = Extension.GetExplicitExtensions\n  \n  theExt = {}\n  \n  for each oKey in dctExts.ReturnKeys\n    if (dctExts.Get(oKey).CanUnload.not) then\n      theExt.Add(oKey+\" (- fix -)\")\n    end\n  end\n  \n\n  for each fKey in dctExts.ReturnKeys\n    if (fKey <> \"Memo Tools 6.5  (English)\") then\n      if 
(dctExts.Get(fKey).CanUnload) then\n        theExt.Add(fKey+\" (- lax -)\")\n      end\n    end\n  end\n\n  if (theExt.count > 0) then\n    theODBDepends = Msgbox.multiListAsString(theExt,\"Select extensions that should be loaded when the ODB will be imported  (OK to empty List = None):\",\" Extensions of the Project\")\n  \n    if (theOdbDepends = NIL) then\n      return NIL\n    end\n    \n    theFileNames = List.Make\n    for each E in theODBDepends\n      sExt = E\n      theExt = dctExts.Get(sExt.Left(sExt.count-10))\n      t
heFN = theExt.GetFileName\n      theFileNames.Add(theFN)\n    end\n    \n    theODBDependencies = theODBFile.getDependencies\n  \n    for each dep in theFileNames\n      theODBDependencies.Add(dep)\n    end\n  end\nend\n\n'msgbox.multilistasstring(theODBDependencies,\"\",\"ODB-Depp\")\n  \n'-------------------------------------------------------------------------------\n' WE'VE TAKEN THE DOC-GUIS IN THE LINE FOR CLARITY; NOW WE HAVE TO SPLIT THE LINE\n' AND CREATE A SPLITSIGN '$' FOR THIS PURPOSE. CONSEQUENTIAL NO DOCS WITH TH
AT SIGN COULD\n' BE EXPORTED... LOOK IF WE FIND SUCH DOCS AND SHOW IF WE HAD SUCCEEDED\n\ntheSelDokList = List.Make\ntheUnableList = List.Make\n\nfor each selDok in theSelDocs\n  if (selDok.AsString.contains(\"$\")) then\n    theUnableList.Add(selDok)\n  end\n  theSplit = selDok.Substitute(\" :  \",\"$\")\n  theSplit = theSplit.AsTokens(\"$\")\n  for each selDokString in theSplit\n    theSelDokList.Add(selDokString)\n  end\nend\n\n'-------------------------------------------------------------------------------\n' ODB MIT LISTE FUELL
EN\n\nfor each d in theSelDokList\n  theClose = theProject.FindDoc(d)\n  if (theClose = NIL) then continue end\n  theODBFile.Add(theClose)\nend\n\n'-------------------------------------------------------------------------------\n' COMMIT UND SCHREIBEN\n\ntheODBFile.Commit\n\nif (theODBFile.Commit = FALSE) then\n  MsgBox.Info(\"Could not commit...\",\"\")\n  return NIL\nend\n\ntheDocsCount = theODBFile.Count\n\n'-------------------------------------------------------------------------------\n' GIVE SOME INFOS IN THE STATUS BAR\n\nif (
theDocsCount <> 1) then\n  MsgBox.Info (\"Written \"+theDocsCount.AsString + \" Documents to  ''\"+theDocODB.AsString +\"''\", \"ODB-File\")\n  av.showMSG(\"llll llll llll llll llll   llll llll llll    Written \"+theDocsCount.AsString + \" documents to  ''\"+theDocODB.AsString +\"''\")\nelse\n  MsgBox.Info (\"Written \"+theDocsCount.AsString + \" Document to  ''\"+theDocODB.AsString +\"''\", \"ODB-File\")\n  av.showMSG(\"llll llll llll llll llll   llll llll llll    Written \"+theDocsCount.AsString + \" document to  ''\"+theDocODB.AsStrin
g +\"''\")\nend\n\nif (theUnableList.count > 0) then\n  MsgBox.Info(\"The string  '$'  inheres a split function in the 'Sort'  part of this script. \"+theUnableList.count.AsString+\" Doc(s) \"+\n  \"named using this string could not be processed.\",\"\")\nend\n\n'-------------------------------------------------------------------------------\n\n' END OF FILE\n\n"
)

(Script.86
	Name:	"LayoutTools.ImpExp_LoadODB"
	SourceCode:	"\n' NAME: mm_docODBLoad\n\n' HERKUNFT: FSA, veraendert : H.\n\n' EINBINDUNG MTOOLS: Menueeintrag im Projektmenue (Label: Dokumentauswahl aus ODB importieren...)\n\n' HILFE: Oeffnet eine Auswahlliste zum Laden von Dokumenten aus einem ODB-File  (s. STRG-Klick Info)\n\n'*******************************************\n\n' CTRL-KLICK Info (erscheint, wenn das Skript bei gedrueckter Strg- bzw. Ctrl-Taste aufgerufen wird)\n \nif (System.IsControlKeyDown) then\n\n  message =  \" \"+nl+\n    \n    \"SCRIPTNAME:    mm_DocODBLoad \"+nl+nl+\n
  \n    \"ORIGIN:   FSA, modified \"+nl+nl+\n    \n    \"Opens a MultiList to select documents from a single ODB file to import. \"+nl+\n    \n    \"Extensions that are listed in the dependencies will be loaded if necessary. \"+nl\n            \n  msgbox.report(message,\"INFO: Import ODB ...\")\n  \n  return nil\nend\n\n'-------------------------------------------------------\n\ntheProject = av.GetProject\n\nODBName = FileDialog.Show(\"*.odb\",\"ODB-Files\",\" Choose ODB-File\")\n\nif (ODBName = NIL) then\n  return NIL\nend\n\ntheODB = ODB.Op
enAndInstall(ODBName)\n\nif (theODB = NIL) then\n  MsgBox.Info(\"Can not import ODB File.\",\" Info\")\n  return NIL\nend  \n\ntheODBDepends = theODB.GetDependencies\n\ndeps = \"\"\n\nif (theODBDepends.count > 0) then\n  for each dep in theODBDepends\n    deps = deps+\" ''\"+dep.asString+\"'', \"\n  end \n  MsgBox.Info(\"Have loaded if wasn't already: \"+deps.left(deps.count-2),\" Info\")\nend\n\n\ntheCount = theODB.count - 1\n\ntheDict = Dictionary.Make(50)\n\n\nfor each d in 0..theCount\n  theDict.Add(theODB.Get(d).GetClass.GetClassName.UCase 
++ \" : \" ++ theODB.Get(d).GetName,d)\nend\n\ntheDictList = theDict.ReturnKeys\ntheDictList.Sort(TRUE)\ntheLCount = 0\ntheObj = theODB.Get(0)\n\nif (theDictList.Count > 1) then\n  theDocList = MsgBox.MultiListAsString(theDictList,\"Select Docs to import (see that the DocNames are unique): \",\"Doc Type and Name\")\n  if ((theDocList = nil) or (theDocList.Count = 0)) then\n    return nil\n  end\nelseif (theDictList.Count = 1) then\n  theClassName = theObj.GetClass.GetClassName\n  if (theClassName = \"Dictionary\") then\n    theKey
List = theObj.ReturnKeys\n    if (theKeyList.Count = 1) then\n      theKey = theKeyList.Get (0)\n    else\n      theKey = msgBox.ListAsString (theKeyList, \"Select Docs to import (see that the DocNames are unique): \", \"Import ODB\")\n    end\n  \n    theDoc = theObj.Get(theKey)\n    \n    if (av.FindDoc(theDoc.AsString).AsString = theDoc.AsString) then\n      MsgBox.Info(\"A Document with the Name '\"+theDoc.AsString+\"' already exists. Enter \"+\n                  \"another Name!\",\"'\"+theDoc.AsString+\"' already exists...\")\n
\n      theNDoc = MsgBox.Input( \"Enter a Name for ''\"+theDoc.AsString+\"'':\", \"New \"+\n                              \"Name for '\"+theDoc.AsString+\"'\", theDoc.AsString+\"_b\" )\n      if ((theNDoc = NIL) or (theNDoc = \"\")) then\n        return NIL\n      end\n      theDoc.SetName ( theNDoc )\n    end\n\n    if (theDoc.is(Doc)) then\n      av.GetProject.AddDoc(theDoc)\n      theLCount = theLCount + 1\n    end\n    \n    if (theKeyList.Count = 1) then\n      if (theDoc.AsString <> NIL) then\n        theName = \"''\"+theDoc.AsStrin
g+\"'' \"\n      else\n        theName = \"Object\"\n      end\n      if (theLCount > 0) then\n        MsgBox.Info(theName+\" imported.\",\"\")\n        av.showMsg(\"llll llll llll llll llll   llll llll llll    \"+theName+\" imported\")\n      else\n        MsgBox.Info(\"Nothing imported.\",\"\")\n        av.showMsg(\"llll llll llll llll llll   llll llll llll    Imported nothing\")\n      end\n    else\n      if (theLCount > 0) then\n        MsgBox.Info(theKeyList.Count.AsString+\" Objects imported.\",\"\")\n        av.showMsg(\"llll llll llll
 llll llll   llll llll llll    \"+theKeyList.Count.AsString+\" Objects imported\")\n      else\n        MsgBox.Info(\"Nothing imported.\",\"\")\n        av.showMsg(\"llll llll llll llll llll   llll llll llll    Imported nothing\")\n      end\n    end      \n    return NIL\n  else\n'    msgbox.info(av.FindDoc(theObj.AsString).AsString+theObj.AsString,\"\")\n    if (av.FindDoc(theObj.AsString).AsString = theObj.AsString) then\n      MsgBox.Info(\"A document with the name '\"+theObj.AsString+\"' already exists. Enter \"+\n             
     \"another name!\",\"'\"+theObj.AsString+\"' already exists...\")\n\n      theNDoc = MsgBox.Input( \"Enter a name for ''\"+theObj.AsString+\"'':\", \"New \"+\n                              \"name for '\"+theObj.AsString+\"'\", theObj.AsString+\"_b\" )\n      if ((theNDoc = NIL) or (theNDoc = \"\")) then\n        return NIL\n      end\n      theObj.SetName ( theNDoc )\n    end\n\n    if (theObj.is(Doc)) then\n      av.GetProject.AddDoc(theObj)\n      theLCount = theLCount + 1\n    end\n    if (theObj.GetName <> NIL) then\n      theName = 
\"''\"+theObj.GetName+\"'' \"\n    else\n      theName = \"Objekt\"\n    end\n    if (theLCount > 0) then\n      MsgBox.Info(theName+\" imported.\",\"\")\n      av.showMsg(\"llll llll llll llll llll   llll llll llll    \"+theName+\" imported\")\n    else\n      MsgBox.Info(\"Nothing imported.\",\"\")\n      av.showMsg(\"llll llll llll llll llll   llll llll llll    Imported nothing\")\n    end\n    return NIL\n  end\nelse\n  return NIL\nend\n\n\ntheCheckList = list.make\n\nfor each k in theDocList\n  theCheckList.Add(theDict.Get(k))\nend\n\ndd = 0\n\nfo
r each i in theCheckList\n  t = theODB.Get(i)\n  if (t.GetClass.GetClassName = \"DialogEditor\") then\n    names = extension.GetExplicitExtensions\n    dd = 0\n    for each j in names.ReturnKeys\n      if (j = \"Dialog Designer\") then\n        dd = 1\n      end\n    end\n  end\n  if (dd = 1) then\n    extension.open(\"$AVEXT/dialog.avx\".AsFileName)\n  end\n  if (av.FindDoc(t.AsString).AsString = t.AsString) then\n    MsgBox.Info(\"A document with the name  '\"+t.AsString+\"' already exists. Enter \"+\n                \"another name
!\",\"'\"+t.AsString+\"' already exists...\")\n\n    theNDoc = MsgBox.Input( \"Enter a name for ''\"+t.AsString+\"'':\", \"New \"+\n                            \"name for '\"+t.AsString+\"'\", t.AsString+\"_b\" )\n    if ((theNDoc = NIL) or (theNDoc = \"\")) then\n      return NIL\n    end\n    t.SetName ( theNDoc )\n  end\n  if (t.is(Doc)) then\n    av.GetProject.AddDoc(t)\n    theLCount = theLCount + 1\n  end\nend\n\ntheProject.SetModified(TRUE)\n\nif (theLCount = 1) then\n  theGram = \"Object\"\nelse\n  theGram = \"Objects\"\nend\n\nMsgBox.Info(\"Imp
orted \"+theLCount.AsString++theGram,\"\")\nav.showMsg(\"llll llll llll llll llll   llll llll llll     Imported \"+theLCount.AsString++theGram)\n\n'END OF SCRIPT\n\n"
)

(Script.87
	Name:	"LayoutTools.Ruler_DrawRulers"
	SourceCode:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_DrawRulers.ave\n'# Author:       Adrian Boehlen\n'# Date:         02.12.2015\n'# Version:      0.2\n'#\n'# Purpose:      Zieht horizontale und vertikale Hilfslinien am Clickpunkt\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc  \n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this tool from an active Layout.\",\"\")\n  return nil\nend\n\n'# Lay
out-Geometrie ermitteln\nthePageDisplay = av.GetActiveDoc.GetDisplay\nrecMargin = thePageDisplay.ReturnMarginExtent\ntheOrigin = recMargin.ReturnOrigin\nxOriginLeft = theOrigin.GetX\nxOriginRight = xOriginLeft + recMargin.GetWidth\nyOriginBottom = theOrigin.GetY\nyOriginTop = yOriginBottom + recMargin.GetHeight\n\nif (System.IsShiftKeyDown) then\n  '# vertikale Linie aus Clickpunkt ableiten\n  pt = theLayout.GetDisplay.ReturnUserPoint\n\n  xU = pt.GetX\n  yU = yOriginTop + 1\n  xD = pt.GetX\n  yD = yOriginBottom - 1\n\n  '# 
Strichstil definieren\n  thePen = BasicPen.Make\n  theColor = Color.Make\n  theColor.SetRGBList({240,40,200})\n  thePen.SetColor(theColor)\n  thePen.SetSize(0.5)\n\n  '# Linie zeichnen\n  theLine = Line.Make( xU@yU, xD@yD)\n  theGraphicLine = GraphicShape.Make(theLine)\n  theGraphicLine.SetSymbol(thePen)\n\n  theLayout.GetGraphics.UnselectAll\n  theGraphicLine.SetSelected(TRUE)\n  theLayout.GetGraphics.Add(theGraphicLine)\n  av.GetProject.SetModified(TRUE)\n  \nelse\n  '# horizontale Linie aus Clickpunkt ableiten\n  pt = theL
ayout.GetDisplay.ReturnUserPoint\n\n  xL = xOriginLeft - 1\n  yL = pt.GetY\n  xR = xOriginRight + 1\n  yR = pt.GetY\n\n  '# Strichstil definieren\n  thePen = BasicPen.Make\n  theColor = Color.Make\n  theColor.SetRGBList({240,40,200})\n  thePen.SetColor(theColor)\n  thePen.SetSize(0.5)\n\n  '# Linie zeichnen\n  theLine = Line.Make( xL@yL, xR@yR)\n  theGraphicLine = GraphicShape.Make(theLine)\n  theGraphicLine.SetSymbol(thePen)\n\n  theLayout.GetGraphics.UnselectAll\n  theGraphicLine.SetSelected(TRUE)\n  theLayout.GetGraphics.Add
(theGraphicLine)\n  av.GetProject.SetModified(TRUE)\nend\n"
)

(Script.88
	Name:	"LayoutTools.Ruler_TurnRulersOffMany"
	SourceCode:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_TurnRulersOffMany.ave\n'# Author:       Adrian Boehlen\n'# Date:         02.11.2018\n'# Version:      0.2\n'#\n'# Purpose:      schaltet durch DrawRulers erzeugte Hilfslinien fuer\n'#               mehrere Layouts aus\n'#\n'###########################################################################\n\ntheProject=av.GetProject\ntheDocL=theProject.GetDocs\ntheLayoutL={}\nfor each theEntry in theDocL\n  if (theEntry.
Is(Layout)) then\n    theLayoutL.Add(theEntry)\n  end\nend\ntheBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Turn Rulers Off\")\nif (theBatchLayoutL=Nil) then \n  return nil\nend\nwhile (theBatchLayoutL.Count=0) \n  MsgBox.Error(\"Please choose one oder more layout(s)\"+NL+\"Cancel for abort\", \"\")\n  theBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Turn Rulers Off\")\n  if (theBatchLayoutL=Nil) then\n    return nil\n  end\nend\n\nfor each theLayout in theBatchLayoutL\n  farbeStr = \"\"\n  hilfslF
arbeStr = \"24040200\"          '# RGB-Wert der Hilfslinie...\n  hilfslFarbe = Color.Make\n  hilfslFarbe.SetRGBList({240,40,200}) '# ...gemaess Definition in DrawRulers\n  weissStr = \"255255255\"\n  weiss = Color.Make\n  weiss.SetRGBList({255,255,255})      '# RGB weiss\n\n  for each g in theLayout.GetGraphics\n    if (g.Is(GraphicGroup).Not) then\n      symb = g.GetSymbol\n      rgb = symb.GetColor.GetRGBList\n      for each farbe in rgb\n        farbeStr = farbeStr + farbe.AsString\n      end\n      if (farbeStr = hilfslF
arbeStr) then\n        g.SetSelected(TRUE)\n        g.GetSymbol.SetColor(weiss)\n      end\n      farbeStr = \"\"\n    end\n  end\n\n  theGraphicsList = theLayout.GetGraphics\n  theGraphicsList.MoveSelectedToBack\n  theGraphicsList.UnselectAll\n  theLayout.GetDisplay.Invalidate(true)\nend"
)

(Script.89
	Name:	"LayoutTools.Ruler_TurnRulersOffOne"
	SourceCode:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_TurnRulersOff.ave\n'# Author:       Adrian Boehlen\n'# Date:         02.11.2018\n'# Version:      0.3\n'#\n'# Purpose:      schaltet durch DrawRulers erzeugte Hilfslinien aus\n'#\n'###########################################################################\n\ntheLayout = av.GetActiveDoc\nfarbeStr = \"\"\nhilfslFarbeStr = \"24040200\"          '# RGB-Wert der Hilfslinie...\nhilfslFarbe = Color.Make\nhilfslFarbe.SetRGB
List({240,40,200}) '# ...gemaess Definition in DrawRulers\nweissStr = \"255255255\"\nweiss = Color.Make\nweiss.SetRGBList({255,255,255})      '# RGB weiss\n\nfor each g in theLayout.GetGraphics\n  if (g.Is(GraphicGroup).Not) then\n    symb = g.GetSymbol\n    rgb = symb.GetColor.GetRGBList\n    for each farbe in rgb\n      farbeStr = farbeStr + farbe.AsString\n    end\n    if (farbeStr = hilfslFarbeStr) then\n      g.SetSelected(TRUE)\n      g.GetSymbol.SetColor(weiss)\n    end\n    farbeStr = \"\"\n  end\nend\n\ntheGraphicsList = 
theLayout.GetGraphics\ntheGraphicsList.MoveSelectedToBack\ntheGraphicsList.UnselectAll\ntheLayout.GetDisplay.Invalidate(true)\n"
)

(Script.90
	Name:	"LayoutTools.Ruler_TurnRulersOnMany"
	SourceCode:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_TurnRulersOnMany.ave\n'# Author:       Adrian Boehlen\n'# Date:         02.11.2018\n'# Version:      0.2\n'#\n'# Purpose:      schaltet durch DrawRulers erzeugte Hilfslinien fuer\n'#               mehrere Layouts ein\n'#\n'###########################################################################\n\ntheProject=av.GetProject\ntheDocL=theProject.GetDocs\ntheLayoutL={}\nfor each theEntry in theDocL\n  if (theEntry.I
s(Layout)) then\n    theLayoutL.Add(theEntry)\n  end\nend\ntheBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Turn Rulers On\")\nif (theBatchLayoutL=Nil) then \n  return nil\nend\nwhile (theBatchLayoutL.Count=0) \n  MsgBox.Error(\"Please choose one oder more layout(s)\"+NL+\"Cancel for abort\", \"\")\n  theBatchLayoutL=MsgBox.MultiList(theLayoutL, \"Choose layout(s):\", \"Turn Rulers On\")\n  if (theBatchLayoutL=Nil) then\n    return nil\n  end\nend\n\nfor each theLayout in theBatchLayoutL\n  farbeStr = \"\"\n  hilfslFarb
eStr = \"24040200\"          '# RGB-Wert der Hilfslinie...\n  hilfslFarbe = Color.Make\n  hilfslFarbe.SetRGBList({240,40,200}) '# ...gemaess Definition in DrawRulers\n  weissStr = \"255255255\"\n  weiss = Color.Make\n  weiss.SetRGBList({255,255,255})      '# RGB weiss\n\n  for each g in theLayout.GetGraphics\n    if (g.Is(GraphicGroup).Not) then\n      symb = g.GetSymbol\n      rgb = symb.GetColor.GetRGBList\n      for each farbe in rgb\n        farbeStr = farbeStr + farbe.AsString '# RGB-String bilden\n      end\n      if (
farbeStr = weissStr) then\n        g.SetSelected(TRUE)\n        g.GetSymbol.SetColor(hilfslFarbe)\n      end\n      farbeStr = \"\"\n    end\n  end\n  theGraphicsList = theLayout.GetGraphics\n  theGraphicsList.MoveSelectedToBack\n  theGraphicsList.UnselectAll\n  theLayout.GetDisplay.Invalidate(true)\nend"
)

(Script.91
	Name:	"LayoutTools.Ruler_TurnRulersOnOne"
	SourceCode:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_TurnRulersOn.ave\n'# Author:       Adrian Boehlen\n'# Date:         02.11.2018\n'# Version:      0.3\n'#\n'# Purpose:      schaltet durch DrawRulers erzeugte Hilfslinien ein\n'#\n'###########################################################################\n\ntheLayout = av.GetActiveDoc\nfarbeStr = \"\"\nhilfslFarbeStr = \"24040200\"          '# RGB-Wert der Hilfslinie...\nhilfslFarbe = Color.Make\nhilfslFarbe.SetRGBL
ist({240,40,200}) '# ...gemaess Definition in DrawRulers\nweissStr = \"255255255\"\nweiss = Color.Make\nweiss.SetRGBList({255,255,255})      '# RGB weiss\n\nfor each g in theLayout.GetGraphics\n  if (g.Is(GraphicGroup).Not) then\n    symb = g.GetSymbol\n    rgb = symb.GetColor.GetRGBList\n    for each farbe in rgb\n      farbeStr = farbeStr + farbe.AsString '# RGB-String bilden\n    end\n    if (farbeStr = weissStr) then\n      g.SetSelected(TRUE)\n      g.GetSymbol.SetColor(hilfslFarbe)\n    end\n    farbeStr = \"\"\n  end\nend
\ntheGraphicsList = theLayout.GetGraphics\ntheGraphicsList.MoveSelectedToBack\ntheGraphicsList.UnselectAll\ntheLayout.GetDisplay.Invalidate(true)\n"
)

(Script.92
	Name:	"LayoutTools.Sel_Select"
	SourceCode:	"theLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\ntheLayout.Select"
)

(Script.93
	Name:	"LayoutTools.Sel_SelectAll"
