(SEd.108
	Name:	"LayoutTools.SelectAll"
	Creator:	"adrian"
	CreationDate:	"Sam 25 Okt 2014 16:26:10 CEST"
	GUIName:	"Script"
	Win:	109
	CSMgr:	110
	DocExts:	111
	Source:	"theLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\ntheGraphicsList = theLayout.GetGraphics\ntheGraphicsList.SelectAll"
)

