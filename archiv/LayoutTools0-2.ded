(SEd.112
	Name:	"LayoutTools.SetQuality"
	Creator:	"adrian"
	CreationDate:	"Sam 25 Okt 2014 16:26:48 CEST"
	GUIName:	"Script"
	Win:	113
	CSMgr:	114
	DocExts:	115
	Source:	"'########################################################\n'#\n'# Filename:     SetQuality.ave\n'# Author:       Adrian Boehlen\n'# Date:         21.10.2014\n'# Version:      0.1\n'#\n'# Purpose:      aendert auf Knopfdruck bei allen Bildern\n'#               eines Layouts die Qualitaet von \"Draft\"\n'#               auf \"Presentation\" oder umgekehrt.             \n'#\n'########################################################\n\ntheLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this 
script from an active Layout.\",\"\")\n  return nil\nend\n\ntheGraphicsList = theLayout.GetGraphics\n\nfor each theObject in theGraphicsList\n  if (theObject.Is(PictureFrame)) then\n    if (theObject.GetQuality = #FRAME_QUALITY_PRESENTATION) then\n      theObject.SetQuality(#FRAME_QUALITY_DRAFT)\n    else\n      theObject.SetQuality(#FRAME_QUALITY_PRESENTATION)\n    end\n  end\nend\n\ntheLayout.Invalidate"
)

(DocWin.113
	Owner:	112
	X:	268
	Y:	57
	W:	728
	H:	510
)

(CSMgr.114
)

(DocAct.115
	Doc:	112
)

