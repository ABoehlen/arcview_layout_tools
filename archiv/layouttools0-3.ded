(SEd.126
	Name:	"LayoutTools.HeaderAndFooter"
	Creator:	"adrian"
	CreationDate:	"Mon 20 Apr 2015 19:59:04 CEST"
	GUIName:	"Script"
	Win:	127
	CSMgr:	128
	DocExts:	129
	Source:	"'' Name: LYT.Header \n'       lyt_head.ave\n' Author: Mike Quentel <mquentel@acceleration.net>,\n'                      <kingofthewood@yahoo.com>\n' Date: Fri Dec 10 15:28:27 1999\n' Revised by: Adrian Boehlen\n' Revision Date: 20/04/2015\n' Revisions: \n' -------------------------------------------------------------------\n\nlytActive = av.GetActiveDoc\nif ((lytActive.is(Layout)) and (lytActive.GetClass.GetClassName <> \"DialogEditor\")) then\n  thePageDisplay = lytActive.GetDisplay\n  thePageExtent = thePageDisplay.Retu
rnPageExtent\n  theCenter = thePageExtent.ReturnCenter\n  recMargin = thePageDisplay.ReturnMarginExtent\n  theOrigin = recMargin.ReturnOrigin\n  xOriginLeft = theOrigin.GetX\n  xOriginCenter = theCenter.GetX\n  xOriginRight = xOriginLeft + recMargin.GetWidth\n  yOrigin = theOrigin.GetY\n  \n  ' creates origins for graphic text (anchor points left)\n  docOrigin = (xOriginLeft + 0.01)@(yOrigin + 0.05)\n  userOrigin = (xOriginCenter)@(yOrigin + 0.05)\n  pageOrigin = (xOriginRight - 0.01)@(yOrigin + 0.05)\n  \n  ' REMOVES PR
EVIOUS GRAPHIC TEXT\n  lGraphics = lytActive.GetGraphics\n  numLCount = lGraphics.Count\n  if (numLCount > 0) then\n    lGraphicsRemove = {}\n    for each g in lGraphics\n      if ((g.GetOrigin = docOrigin) or (g.GetOrigin = userOrigin)) then\n        lGraphicsRemove.Add (g)\n      end 'if ((g...\n    end 'for each g...\n    for each remove in lGraphicsRemove\n      lGraphics.RemoveGraphic (remove)\n    end 'for each remove...\n  end 'if (numLCount...\n  \n  ' creates names strings for graphic text  \n  strAprName = av.Get
Project.GetName\n  strLytName = lytActive.GetWin.GetTitle\n  fnUserName = (\"$AVEXT/user_name.odb\").AsFileName\n  strUserName = MsgBox.Input (\"Enter your name.\",\"Layout User\",\"Adrian Boehlen\")\n  strDoc = (strAprName)\n  strUser = (strUserName)\n  'dtNow = Date.Now\n  'dtNow.SetFormat (\"yyyyy-MM-dd  hhh:m\")\n  'dtNow.SetFormat (\"ddd dd MMM yyyyy    hhh:m\")\n  'strDate = dtNow.AsString\n  strPage = MsgBox.Input (\"Enter page number\", \"Page Number\", \"1\")\n  \n  ' creates, adjusts and adds graphic text to layout\n  theSize =
 8\n  theColor = Color.GetBlack\n  theFont = Font.Make (\"DejaVu Sans\", \"Condensed\")\n\n  gtxDoc = GraphicText.Make (strDoc, docOrigin)  \n  gtxUser = GraphicText.Make (strUser, userOrigin)\n  gtxPage = GraphicText.Make (strPage, pageOrigin)\n  \n  txtSymDoc = gtxDoc.ReturnSymbols.Get (0)\n  txtSymDoc.SetSize (theSize)\n  txtSymDoc.SetColor(theColor)\n  txtSymDoc.SetFont (theFont)\n\n  txtSymUser = gtxUser.ReturnSymbols.Get (0)\n  txtSymUser.SetSize (theSize)\n  txtSymUser.SetFont (theFont)\n    \n  txtSymPage = gtxPage.Retu
rnSymbols.Get (0)\n  txtSymPage.SetSize (theSize)\n  txtSymPage.SetFont (theFont)\n  \n  lytActive.GetGraphics.Add (gtxDoc)\n  lytActive.GetGraphics.Add (gtxUser)\n  lytActive.GetGraphics.Add (gtxPage)\n  theGraphicList = lytActive.GetGraphics\n  \n  ' replace user name with simulated anchor point middle\n  userOrigin = (xOriginCenter - (gtxUser.GetExtent.GetX / 2))@(yOrigin + 0.05)\n  theGraphicList.RemoveGraphic(gtxUser)\n  gtxUser = GraphicText.Make (strUser, userOrigin)\n  txtSymUser = gtxUser.ReturnSymbols.Get (0)\n
  txtSymUser.SetSize (theSize)\n  txtSymUser.SetColor(theColor)\n  txtSymUser.SetFont (theFont)\n  lytActive.GetGraphics.Add (gtxUser)\n  \n  ' replace page number with simulated anchor point right\n  pageOrigin = (xOriginRight - gtxPage.GetExtent.GetX)@(yOrigin + 0.05)\n  theGraphicList.RemoveGraphic(gtxPage)\n  gtxPage = GraphicText.Make (strPage, pageOrigin)\n  txtSymPage = gtxPage.ReturnSymbols.Get (0)\n  txtSymPage.SetSize (theSize)\n  txtSymPage.SetColor(theColor)\n  txtSymPage.SetFont (theFont)\n  lytActive.GetGr
aphics.Add (gtxPage)\n\nelse\n  MsgBox.Warning (\"This script is meant for an Active Layout only.  Exiting.\",\"\")\n  exit\nend  \n  \n\n\n"
	SearchStr:	"fntArial"
)

