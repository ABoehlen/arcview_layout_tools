(SEd.169
	Name:	"LayoutTools.Footnote"
	Creator:	"adrian"
	CreationDate:	"Don 31 Dez 2015 16:49:11 CET"
	GUIName:	"Script"
	Win:	170
	CSMgr:	171
	DocExts:	172
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_Footnote.ave\n'# Author:       Adrian Boehlen\n'# Date:         24.01.2016\n'# Version:      0.2\n'#\n'# Purpose:      erzeugt Fussnoten\n'#\n'###################################################################\n\n_theLayout = av.GetActiveDoc  \n\nif (_theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this tool from an active Layout.\",\"\")\n  return nil\nend\n\n'# Schriftgroesse definieren\n_textSize = MsgBox.Inpu
t(\"Schriftgroesse eingeben\", \"Schriftgroesse\",10.AsString)\n\nif (_textSize = nil) then\n  return nil\nelseif (_textSize.IsNumber.Not) then\n  MsgBox.Warning(\"Ungueltige Eingabe\",\"Abbruch\")\n  return nil\nend\n_textSize = _textSize.AsNumber\n\n'########## Layout-Geometrie ermitteln ##########\n\nthePageDisplay = av.GetActiveDoc.GetDisplay\nrecMargin = thePageDisplay.ReturnMarginExtent\ntheOrigin = recMargin.ReturnOrigin\nxOriginLeft = theOrigin.GetX\nxOriginRight = xOriginLeft + recMargin.GetWidth\n\n'########## horizontale 
Linie aus Clickpunkt ableiten ##########\n\npt = _theLayout.GetDisplay.ReturnUserPoint\n\nxL = xOriginLeft + 0.01\nyL = pt.GetY\nxR = (xOriginRight - xOriginLeft) / 3 + xOriginLeft\nyR = pt.GetY\n\n'# Strichstil definieren\nthePen = BasicPen.Make\nschwarz = Color.GetBlack\nthePen.SetColor(schwarz)\nthePen.SetSize(1)\n\n'# Linie zeichnen\ntheLine = Line.Make( xL@yL, xR@yR)\ntheGraphicLine = GraphicShape.Make(theLine)\ntheGraphicLine.SetSymbol(thePen)\n\n_theLayout.GetGraphics.UnselectAll\ntheGraphicLine.SetSelected(TRUE)\n_theLay
out.GetGraphics.Add(theGraphicLine)\nav.GetProject.SetModified(TRUE)\n\n'########## Text definieren und platzieren ##########\n\n_textFont = Font.Make (_defFont, _defSchnitt)\n_textString = \"Text\"\n_textOrigin = (xOriginLeft)@(pt.GetY - 0.25)\n_textColor = _defColor\nav.Run(\"LayoutTools.PlaceText\", {_textString, _textOrigin})\n\n"
	SearchStr:	"Black"
)

