(SEd.201
	Name:	"LayoutTools.PlaceText"
	Creator:	"adrian"
	CreationDate:	"Don 31 Dez 2015 16:57:55 CET"
	GUIName:	"Script"
	Win:	202
	CSMgr:	203
	DocExts:	204
	Source:	"'##########################################################\n'#\n'# Filename:     LayoutTools_PlaceText.ave\n'# Author:       Adrian Boehlen\n'# Date:         02.06.2015\n'# Version:      0.1\n'#\n'# Purpose:      Subroutine zur Platzierung von Text\n'#\n'##########################################################\n\n_gtxText = GraphicText.Make (_textString, _textOrigin)\ntheText = _gtxText.ReturnSymbols.Get (0)\ntheText.SetSize(_textSize)\ntheText.SetColor(_textColor)\ntheText.SetFont(_textFont)\n_theLayout.GetGraphics.Add
 (_gtxText)\n"
)

