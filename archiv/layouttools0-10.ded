(SEd.165
	Name:	"LayoutTools.EnterCommand"
	Creator:	"adrian"
	CreationDate:	"Mon 01 Feb 2016 19:36:43 CET"
	GUIName:	"Script"
	Win:	166
	CSMgr:	167
	DocExts:	168
	Source:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_Enter_command.ave\n'# Author:       Adrian Boehlen\n'# Date:         03.02.2016\n'# Version:      0.3\n'#\n'# Purpose:      loest diverse Funktionen durch Kommandos aus\n'#\n'###########################################################################\n\ntheLayout = av.GetActiveDoc\n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Info(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\nhelpmessage = \n
\"Befehle und ihre Funktionen\"+NL+\n\"---------------------------------------------\"+NL+NL+\n\"copy             Kopiert das ausgewaehlte Layout\"+NL+\n\"fileimp           Importiert Textfiles\"+NL+\n\"help              Zeigt diese Hilfeseite\"+NL+\n\"hlon              Schaltet Hilfslinien ein\"+NL+\n\"hloff              Schaltet Hilfslinien aus\"+NL+\n\"headone      Erzeugt Kopf- und Fusszeile fuer das aktive Layout\"+NL+\n\"headmany    Erzeugt Kopf- und Fusszeile fuer mehrere Layouts\"+NL+\n\"regmarks      Setzt Schnittmarken\"+NL+\n
\"selall            Selektiert alle Elemente auf dem aktiven Layout\"+NL+\n\"textimp         Importiert eingegebenen Text\"+NL+\n\"unselall        Hebt alle Selektionen auf\"+NL\n\n_command = Self.GetDialog.FindByName(\"EnterCommand\").GetText\nSelf.SetText(\"\")\n\n'# Copy\nif (_command = \"copy\") then\n  av.Run(\"LayoutTools.CopyLayout\", {})\n\n'# Hilfslinien\nelseif (_command = \"hlon\") then\n  av.Run(\"LayoutTools.TurnRulersOn\", {})\nelseif (_command = \"hloff\") then\n  av.Run(\"LayoutTools.TurnRulersOff\", {})\n\n'# Header and Footer\ne
lseif (_command = \"headone\") then\n  av.Run(\"LayoutTools.HeaderAndFooterOne\", {})\nelseif (_command = \"headmany\") then\n  av.Run(\"LayoutTools.HeaderAndFooterMany\", {})\n  \n'# Import Text\nelseif (_command = \"fileimp\") then\n  av.Run(\"LayoutTools.ImportText\", {})\nelseif (_command = \"textimp\") then\n  av.Run(\"LayoutTools.ImportText\", {})\n  \n'# Schnittmarken\nelseif (_command = \"regmarks\") then\n  av.Run(\"LayoutTools.MakeRegistrationMarks\", {})\n  \n'# Select elements\nelseif (_command = \"selall\") then\n  av.Run(\"LayoutToo
ls.SelectAll\", {})\nelseif (_command = \"unselall\") then\n  av.Run(\"LayoutTools.UnselectAll\", {})\n  \n'# Help\nelseif (_command = \"help\") then\n    MsgBox.Report(helpmessage,\"\")\nelseif (_command = nil) then\n  return nil\nelse\n  MsgBox.Info(\"_command not found\",\"\")\nend"
	SearchStr:	"command"
)

