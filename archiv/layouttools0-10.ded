(SEd.229
	Name:	"LayoutTools.TurnRulersOff"
	Creator:	"adrian"
	CreationDate:	"Mon 01 Feb 2016 19:46:30 CET"
	GUIName:	"Script"
	Win:	230
	CSMgr:	231
	DocExts:	232
	Source:	"'###########################################################################\n'#\n'# Filename:     LayoutTools_TurnRulersOff.ave\n'# Author:       Adrian Boehlen\n'# Date:         03.12.2015\n'# Version:      0.2\n'#\n'# Purpose:      schaltet durch DrawRulers erzeugte Hilfslinien aus\n'#\n'###########################################################################\n\ntheLayout = av.GetActiveDoc\nfarbeStr = \"\"\nhilfslFarbeStr = \"24040200\"          '# RGB-Wert der Hilfslinie...\nhilfslFarbe = Color.Make\nhilfslFarbe.SetRGB
List({240,40,200}) '# ...gemaess Definition in DrawRulers\nweissStr = \"255255255\"\nweiss = Color.Make\nweiss.SetRGBList({255,255,255})      '# RGB weiss\n\nfor each g in theLayout.GetGraphics\n  symb = g.GetSymbol\n  rgb = symb.GetColor.GetRGBList\n  for each farbe in rgb\n    farbeStr = farbeStr + farbe.AsString\n  end\n  if (farbeStr = hilfslFarbeStr) then\n    g.SetSelected(TRUE)\n    g.GetSymbol.SetColor(weiss)\n  end\n  farbeStr = \"\"\nend\n\ntheGraphicsList = theLayout.GetGraphics\ntheGraphicsList.MoveSelectedToBack\ntheG
raphicsList.UnselectAll\ntheLayout.GetDisplay.Invalidate(true)\n"
)

