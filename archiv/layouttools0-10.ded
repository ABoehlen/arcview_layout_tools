(SEd.189
	Name:	"LayoutTools.InsertText"
	Creator:	"adrian"
	CreationDate:	"Sam 09 Jan 2016 11:00:24 CET"
	GUIName:	"Script"
	Win:	190
	CSMgr:	191
	DocExts:	192
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_InsertText.ave\n'# Author:       Adrian Boehlen\n'# Date:         24.01.2016\n'# Version:      0.3\n'#\n'# Purpose:      Basiert auf Layout.Text mit folgenden Erweiterungen:\n'#               - Standardschrift wird vordefiniert\n'#               - der Nullpunkt ist oben statt unten, wenn bestehender\n'#                 Text editiert wird\n'#               Einschraenkungen:\n'#               - wenn Text editiert 
werden soll, muss das Textobjekt\n'#                 selektiert sein\n'#               - funktioniert nur mit Flattersatz linksbuendig und\n'#                 Standard-Zeilenabstand 1.0\n'#\n'#########################################################################\n\ntheLayout = av.GetActiveDoc\ntheGraphicList = theLayout.GetGraphics\nif (theGraphicList.HasSelected = TRUE) then\n  theSelected = theGraphicList.GetSelected.Get(0)\n  '# urspruengliche Hoehe der Textbox bestimmen, sofern vorhanden\n  theOriY = theSelected
.GetExtent.GetY\nend\n\nCPC = av.FindDialog(\"Graphic.Label Defaults\")\nIconList = CPC.FindByName(\"CalloutIcons\")\nthePrefs = IconList.GetObjectTag.Get(\"Ttool1\")\n\nthePrefs.Set(0, _defFont)\nthePrefs.Set(1, _defSchnitt)\nthePrefs.Set(2, 10)\n\n      '(0) Font Family    (String) \n      '(1) Font Style     (String)\n      '(2) Font Size      (Number)\n      '(3) Font Color     (String)\n      '(10) UseDefFont    (Boolean)\n\nCFont =      thePrefs.Get(0)\nCStyle =     thePrefs.Get(1)\nCSize =      thePrefs.Get(2)\nUseDef =     t
hePrefs.Get(10)\nif (thePrefs.Get(3) = \"Unnamed Color\") then\n  CColor = av.GetSymbolwin.ReturnCurrentSymbol(#SYMBOL_TEXT).Clone.GetColor\nelse \n  CColor = av.Run(\"LayoutTools.ReturnColor\",thePrefs.Get(3))\nend\n\n'# neues Textobjekt platzieren\nif (theLayout.GetGraphics.EditText.Not) then\n  pt = theLayout.GetDisplay.ReturnUserPoint\n  theGraphicText = GraphicText.Make(\"\", pt)\n  theGraphicText.SetDisplay(theLayout.GetDisplay)\n  theLayout.GetGraphics.UnselectAll\n  theGraphicText.SetSelected(TRUE)\n  if (theGraphicTex
t.EditText) then\n    theLayout.GetGraphics.AddName(theGraphicText)\n    av.GetProject.SetModified(TRUE)\n  end\n  theString = theGraphicText.GetText\n  theGraphicText.GetSymbol.SetFont(Font.make(CFont,CStyle))\n  theGraphicText.GetSymbol.SetSize(CSize)\n  theGraphicText.GetSymbol.SetColor(CColor)\n  \n'# bestehendes Textobjekt editieren\nelse\n  if (theGraphicList.HasSelected = FALSE) then\n    MsgBox.Warning(\"Please select a text object\",\"\")\n    return nil\n  end \n  theSelected = theGraphicList.GetSelected.Get(0)\n  th
eString = theSelected.GetText\n  CColor = theSelected.ReturnSymbols.Get(0).GetColor\n  theOrigin = theSelected.GetOrigin\n  theNewY = theSelected.GetExtent.GetY  '# Hoehe der editierten Textbox bestimmen\n  theOrigin = theOrigin.GetX@(theOrigin.GetY - (theNewY - theOriY))\n  theGraphicList.RemoveGraphic(theSelected)\n  theGraphicText = GraphicText.Make (theString, theOrigin) \n  theSymbol = theGraphicText.ReturnSymbols.Get (0)\n  theSymbol.SetColor(CColor)\n  theSymbol.SetFont(Font.make(CFont,CStyle))\n  theSymbol.Se
tSize(CSize) \n  theLayout.GetGraphics.Add (theGraphicText)  \nend"
	SearchStr:	"Color"
)

