(SEd.185
	Name:	"LayoutTools.ImportText"
	Creator:	"adrian"
	CreationDate:	"Son 03 Mai 2015 15:24:59 CEST"
	GUIName:	"Script"
	Win:	186
	CSMgr:	187
	DocExts:	188
	Source:	"'#########################################################################\n'#\n'# Filename:     LayoutTools_TextFormatter.ave\n'# Author:       Adrian Boehlen\n'# Date:         03.02.2016\n'# Version:      0.8\n'#\n'# Purpose:      Liest Text ein und bildet daraus einen Textblock\n'#               der definierten Anzahl Zeichen\n'#               bestehende Zeilenumbrueche bleiben erhalten\n'#               Schriftart, -groesse und -farbe muessen definiert werden\n'#\n'#               je nach Kommando wird ein gesamtes
 Textfile eingelesen\n'#               oder Text, der ueber eine Inputbox eingegeben wird.\n'#\n'#               erwartet eine selektierte Textbox im Layout,\n'#               an der Stelle, wo dann der neue Text erscheinen soll.\n'#               Die Textbox kann leer sein, oder schon mit Text gefuellt,\n'#               wobei dieser dann geloescht wird\n'#               Der neue Text beginnt an der linken oberen Ecke der \n'#               bestehenden Textbox \n'#\n'#               Bei proportionalen Fonts werden e
inzelne Zeichen nicht\n'#               gezaehlt, um einen ausgewogeneren Flattersatz zu erzeugen\n'#\n'#########################################################################\n\nnullstring = \"\"\ntheLayout = av.GetActiveDoc \n\nif (theLayout.Is(layout).Not) then\n  MsgBox.Warning(\"Start this script from an active Layout.\",\"\")\n  return nil\nend\n\n'########## Benutzereingaben aufnehmen ##########\n\n'# ganze Textfiles importieren\nif (_command = \"fileimp\") then\n  theFile = FileDialog.Show(\"*.txt\",\"text files\",\"Textdatei 
auswaehlen\")\n  if (theFile = nil) then\n    return nil\n  end\n\n'# Text ueber die Inputbox importieren\nelseif (_command = \"textimp\") then\n  textstring = MsgBox.Input(\"\",\"Import Text\",\"\")\n  theFile = FileName.Make(\"tmp.txt\")\n  if (File.Exists(theFile)) then\n    File.Delete(theFile)\n  end\n  tmpFile = LineFile.Make(theFile,#FILE_PERM_WRITE)\n  tmpFile.WriteElt(textstring)\n  tmpFile.close\nend\n\n'# Maximale Anzahl Zeichen pro Zeile definieren\nmaxLength = MsgBox.Input(\"Maximale Anzahl Zeichen pro Zeile eingeben\",\n  \"A
nzahl Zeichen\",50.AsString)\n\nif (maxLength = nil) then\n  return nil\nelseif (maxLength.IsNumber.Not) then\n  MsgBox.Warning(\"Ungueltige Eingabe\",\"Abbruch\")\n  return nil\nend\nmaxLength = maxLength.AsNumber\n\n'# Schriftart definieren\nschriftartListe = {\"DejaVu Sans\", \"DejaVu Sans Mono\", \"DejaVu Serif\", \"Arial\", \"Courier New\"}\nschriftart = MsgBox.ListAsString(schriftartListe, \"Schriftart auswaehlen\", \"Schriftart\")\nif (schriftart = nil) then \n  return nil\nend\n\n'# Schriftschnitt definieren\nif (schriftart = \"DejaVu S
ans\") then\n  schriftschnittListe = {\"Condensed\", \"Condensed Bold\", \"Condensed Oblique\", \"Condensed Bold Oblique\", \"Oblique\", \"Bold Oblique\", \"Book\", \"Bold\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nelseif (schriftart = \"DejaVu Sans Mono\") then\n  schriftschnittListe = {\"Book\", \"Bold\", \"Oblique\", \"Bold Oblique\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt aus
waehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nelseif (schriftart = \"DejaVu Serif\") then\n  schriftschnittListe = {\"Book\", \"Bold\", \"Condensed\", \"Condensed Bold\", \"Condensed Italic\", \"Condensed Bold Italic\", \"Italic\", \"Bold Italic\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nelseif (schriftart = \"Arial\") then\n  schriftschnittListe = {\"Standard\", \"Kursiv\", \"
Fett\", \"Fett Kursiv\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nelseif (schriftart = \"Courier New\") then\n  schriftschnittListe = {\"Standard\"}\n  schriftschnitt = MsgBox.ListAsString(schriftschnittListe, \"Schriftschnitt auswaehlen\", \"Schriftschnitt\")\n  if (schriftschnitt = nil) then \n    return nil\n  end\nend\n\n'# Schriftfarbe definieren\ntheColorList = {\"Schwarz\", \"Grau\", \"Rot\", \"Gruen\", \"Blau
\", \"benutzerdefiniert\"}\ntheColor = MsgBox.ListAsString(theColorList, \"Schriftfarbe auswaehlen\", \"Schriftfarbe\")\nif (theColor = nil) then \n  return nil\nelseif (theColor = \"benutzerdefiniert\") then\n  theRGB = MsgBox.MultiInput(\"RGB-Wert definieren\", \"RGB\",\n  {\"Rot\", \"Gruen\", \"Blau\"}, {\"0\", \"0\", \"0\"})\n  if (theRGB = nil) then\n    return nil\n  end\n  rot = theRGB.Get(0)\n  gruen = theRGB.Get(1)\n  blau = theRGB.Get(2)\nend\n\n'# Schriftgroesse definieren\ntheSize = MsgBox.Input(\"Schriftgroesse eingeben\", \"Schriftgroes
se\",10.AsString)\n\nif (theSize = nil) then\n  return nil\nelseif (theSize.IsNumber.Not) then\n  MsgBox.Warning(\"Ungueltige Eingabe\",\"Abbruch\")\n  return nil\nend\ntheSize = theSize.AsNumber\n\n'########## Text einlesen, formatieren, symbolisieren und platzieren ##########\n\n'# LineFile erzeugen und Anzahl Zeilen ermitteln\ntheLineFile = LineFile.Make(theFile,#FILE_PERM_READ)\nelementCount = theLineFile.GetSize\n\n'# Variablen initialisieren\ntheTextBlock = \"\"\ntheNewLine = \"\"\ntheNewLineC = \"\"\ni = 0\n\n'# Farben zuweisen\nif (
theColor = \"Schwarz\") then\n  theColor = Color.GetBlack\nelseif (theColor = \"Grau\") then\n  theColor = Color.GetGray\nelseif (theColor = \"Rot\") then\n  theColor = Color.Make\n  theColor.SetRGBList({210,35,45})\nelseif (theColor = \"Gruen\") then\n  theColor = Color.GetGreen\nelseif (theColor = \"Blau\") then\n  theColor = Color.Make\n  theColor.SetRGBList({0,137,207})\nelseif (theColor = \"benutzerdefiniert\") then\n  theColor = Color.Make\n  theColor.SetRGBList({rot.AsNumber,gruen.AsNumber,blau.AsNumber})\nend\n\n'# Input-Text i
n neue Zeilen der gewuenschten Laenge umformatieren\n\n'# bei nicht proportionalen Fonts jedes Zeichen gleich behandeln\nif ((schriftart = \"DejaVu Sans Mono\") or (schriftart = \"Courier New\")) then\n  schriftart = Font.Make (schriftart, schriftschnitt)\n  for each i in 1..elementCount                                '# zeilenweise durchgehen\n    theLine = theLineFile.ReadElt                              '# aktuelle Zeile\n    if (theLine.Count > 0) then                                '# alle nicht leeren Zeilen\n   
   i = 0\n      for each word in theLine.AsList                          '# Zeile in Woerter auftrennen\n        i = i + 1  \n        if (theNewLine.Count + word.Count > maxLength) then    '# wenn laenger als maxLength Zeichen...\n          theTextBlock = theTextBlock + theNewLine.Trim + NL   '# ...setze an Textblock an und schliesse mit Newline ab\n          theNewLine = \"\"                                      '# temporaere Zeile loeschen\n        end\n        if (theLine.AsList.Count = i) then                   
  '# beim letzten Wort der Zeile...\n          theNewLine = theNewLine ++ word + NL                 '# ...Woerter zusammensetzen und mit Newline abschliessen\n          theTextBlock = theTextBlock + theNewLine.Trim + NL   '# setze an Textblock an und schliesse mit Newline ab\n          theNewLine = \"\"                                      '# temporaere Zeile loeschen\n        else\n          theNewLine = theNewLine ++ word                      '# Woerter zu temporaerer Zeile zusammensetzen\n        end\n      end\n 
   else                                                       '# alle leeren Zeilen\n      if (theNewLine.Count > 0) then                           '# wenn temporaere Zeile nicht leer ist... \n        theTextBlock = theTextBlock + theNewLine.Trim + NL     '# ...setze an Textblock an und schliesse mit Newline ab\n        theNewLine = \"\"                                        '# temporaere Zeile loeschen\n      end\n      theTextBlock = theTextBlock + NL                         '# wenn temporaere Zeile nicht leer 
ist, schliesse mit Newline ab\n    end\n  end\nelse\n  '# bei proportionalen Fonts einzelne Zeichen nicht zaehlen\n  schriftart = Font.Make (schriftart, schriftschnitt)\n  for each i in 1..elementCount                                '# zeilenweise durchgehen\n    theLine = theLineFile.ReadElt                              '# aktuelle Zeile\n    if (theLine.Count > 0) then                                '# alle nicht leeren Zeilen\n      i = 0\n      for each word in theLine.AsList                          '# Zeile in 
Woerter auftrennen\n        i = i + 1\n        wordC = word                                           '# damit proportionale Fonts korrekter...\n        wordC = wordC.Substitute(\"i\",\"\")                       '# ...umbrochen werden, werden folgende...\n        wordC = wordC.Substitute(\"j\",\"\")                       '# ...Zeichen nicht gezaehlt:...\n        wordC = wordC.Substitute(\"l\",\"\")                       '# ...i, j, l, 1\n        wordC = wordC.Substitute(\"1\",\"\")\n        if (theNewLineC.Count + wordC.Count > m
axLength) then  '# wenn laenger als maxLength Zeichen...\n          theTextBlock = theTextBlock + theNewLine.Trim + NL   '# ...setze an Textblock an und schliesse mit Newline ab\n          theNewLine = \"\"                                      '# temporaere definitive Zeile loeschen\n          theNewLineC = \"\"                                     '# temporaere Zaehl-Zeile loeschen\n        end\n        if (theLine.AsList.Count = i) then                     '# beim letzten Wort der Zeile...\n          theNewLineC = t
heNewLineC ++ wordC + NL              '# ...Woerter zusammensetzen und mit Newline abschliessen\n          theNewLine = theNewLine ++ word + NL                 '# ...Woerter zusammensetzen und mit Newline abschliessen\n          theTextBlock = theTextBlock + theNewLine.Trim + NL   '# setze an Textblock an und schliesse mit Newline ab\n          theNewLine = \"\"                                      '# temporaere definitive Zeile loeschen\n          theNewLineC = \"\"                                     '# temporaer
e Zaehl-Zeile loeschen\n        else\n          theNewLine = theNewLine ++ word                      '# Woerter zu temporaerer definitiver Zeile zusammensetzen\n          theNewLineC = theNewLineC ++ wordC                   '# Woerter zu temporaerer Zaehl-Zeile zusammensetzen\n        end\n      end\n    else                                                       '# alle leeren Zeilen\n      if (theNewLine.Count > 0) then                           '# wenn temporaere Zeile nicht leer ist... \n        theTextBlock = t
heTextBlock + theNewLine.Trim + NL     '# ...setze an Textblock an und schliesse mit Newline ab\n        theNewLine = \"\"                                        '# temporaere definitive Zeile loeschen\n        theNewLineC = \"\"                                       '# temporaere Zaehl-Zeile loeschen\n      end\n      theTextBlock = theTextBlock + NL                         '# wenn temporaere Zeile nicht leer ist, schliesse mit Newline ab\n    end\n  end \nend  \ntheTextBlock = theTextBlock + theNewLine.Trim          
        '# fuege Rest der letzten Zeile noch an\ntheTextBlock = theTextBlock.BasicTrim(\"\",NL)                   '# entfernt ueberschuessiges Newline am Ende\n\ntheLineFile.Close\n\n'# Text symbolisieren und temporaer in Layout platzieren\ntheGraphicList = theLayout.GetGraphics\ntheSelected = theGraphicList.GetSelected.Get(0)\ntheOrigin = theSelected.GetOrigin                                        '# Nullpunkt unten links bestimmen\ntheOrigin = theOrigin.GetX@(theOrigin.GetY + theSelected.GetExtent.GetY) '# Nullpunk
t oben links ableiten\ntheGraphicText = GraphicText.Make (theTextBlock, theOrigin)\ntheSymbol = theGraphicText.ReturnSymbols.Get (0)\ntheSymbol.SetColor(theColor)\ntheSymbol.SetFont(schriftart)\ntheSymbol.SetSize(theSize)\n\ntheLayout.GetGraphics.Add (theGraphicText)\ntheGraphicList.RemoveGraphic (theSelected)                   '# urspruenglich selektierte Textbox loeschen\n\n'# Hoehe des Textblocks bestimmen und Nullpunkt so umrechnen, dass der Text oben links\n'# mit dem bestehenden uebereinstimmt\ntheOrigin = theOri
gin.GetX@(theOrigin.GetY - theGraphicText.GetExtent.GetY) \ntheGraphicList.RemoveGraphic(theGraphicText)                 '# temporaerer Text loeschen\ntheGraphicText = GraphicText.Make (theTextBlock, theOrigin)\ntheSymbol = theGraphicText.ReturnSymbols.Get (0)\ntheSymbol.SetColor(theColor)\ntheSymbol.SetFont(schriftart)\ntheSymbol.SetSize(theSize)\ntheLayout.GetGraphics.Add (theGraphicText)\n\ntheLayout.Invalidate\n"
	SearchStr:	"elementCount"
)

