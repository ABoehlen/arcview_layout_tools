' Name:   Layout.GraphicTable
' Title:  Places a Graphic of the table you specify into a layout
'
' Topics : Layouts
' Version: 3.0a.02
' Source : ArcView Sample scripts
' Changed: 07-30-98
' By     : Rob Buurman
'          rbuurman@isis.nl
'          ISIS BENELUX
'          
'
' Description:  Use the tool with this script attached as the 
' apply event to drag a rectangle in a layout.  You will be prompted
' to choose which table you want to make the representation of 
' and which fields to show.
' When the table has an selection, you will be asked if you want to display
' only the selected records. You can bypass this question by pressing the
' shift-key when you drag the rectangle in a layout.
' The script will populatate rows with cell values of those fields until the 
' bottom of the rectangle you specified is reached.
' If you choose more fields than would fit within the width of the rectangle,
' those will be included.
'
' This script gets around several annoying limitations in ArcView's
' TableFrame graphic:
' 
' 1) With this script you can make a table that is wider than 80
'    text columns. (Great for landscape docs).
' 2) You change the font of this table.
' 3) Since this table is graphicgroup, you can ungroup it and
'    change the symbols for individual parts.
' 4) This table will always print correctly - on some printers
'    printing directly from the table doc & from table frames,
'    there were gross formating errors
' 5) You can resize this table and the text just gets resized,
'    rather than including more data like the tableframe does.
' 
' This script cannot produce the representation of the table if
' it is sorted - you will get the unsorted version.  Additionally,
' since this representation is just a dumb graphic, it does not
' automatically update itself in any way, shape, or form.
'
' Additionally, you can use the symbol window to change the button 
' color by using the foreground, change the table background by using
' the background color, or change the text and outline color as well.
' If you want to highlight a particular column, ungroup the graphic
' table and then you can select the column by clicking on its border,
' then change its background color or text color by using background
' or text from the color palette.
'
' Requires:  Place this script as the apply event for a tool in 
' your Layout GUI.  There must be at least one table document in 
' the current project.
'
' Self:  
'
' Returns:  

theLayout = av.GetActiveDoc
gl = theLayout.GetGraphics
bRect = theLayout.ReturnUserRect
if (bRect.GetWidth < 0.1) then
  return nil
end

if (System.IsShiftKeyDown) then
  SelectedOnly = true
else
  SelectedOnly = false
end

TableDocNames = {}
for each d in av.GetProject.GetDocs
  if(d.Is(Table)) then
    TableDocNames.Add(d.GetName)
  end
end

if (TableDocNames.Count = 0) then
  Msgbox.Error("You must have a table document in the Project","Buh!")
  return nil
end
gl.UnSelectAll

TableName = Msgbox.ChoiceAsString(TableDocNames,"Choose a table:","Smart Table")
if (TableName = nil) then
  return nil
end

theTable = av.GetProject.FindDoc(TableName)
theVTab = theTable.GetVTab
theFieldNames = {}
for each f in theVTab.GetFields
  if (f.IsTypeShape.Not) then
    theFieldNames.Add(f.GetAlias)
  end
end


FieldsToShow = Msgbox.MultiListAsString(theFieldNames,"Choose the Fields to Show","Smart Table")
if (FieldsToShow = nil) then return nil end
if (FieldsToShow.Count = 0) then
  return nil
end

  if (SelectedOnly) then
    theBitmap = theVTab.GetSelection
  else
    theBitmap = theVTab.GetDefBitmap
    if (theVTab.GetSelection.Count <> 0) then
      if (Msgbox.YesNo("Use only the selected records","Smart Table", true)) then
        theBitmap = theVTab.GetSelection
      end
    end
  end

' Background color for field names
bc = Color.Make
bc.SetRGBList({255,255,225})
ftbf = RasterFill.Make
ftbf.SetStyle(#RASTERFILL_STYLE_SOLID)
ftbf.SetColor(bc)

bRectO = bRect.ReturnOrigin
bRectH = bRect.GetHeight
bRectW = bRect.GetWidth
bRectT = bRect.GetTop
brectB = bRect.GetBottom
bRectR = bRect.GetRight
HeightLeft = bRect.GetHeight

tbo = bRectO + (0@bRectH)
cspace = 0

for each f in FieldsToShow
  
  'Make Field Title
  fl = GraphicText.Make(f,(tbo +(0.1@0)) )
  fl.GetSymbol.SetSize(12)
  fl.SetDisplay(theLayout.GetDisplay)
  tbo = tbo - (0@(fl.GetBounds.GetHeight + 0.05))
  fl.SetSelected(true)
  
  gl.AddBatch(fl)
  HeightLeft = HeightLeft - fl.GetBounds.GetHeight - 0.05
  HbarHeight = HeightLeft

  
  'Now do the column of values
  counter = -1
  ColStr = ""
  vst = GraphicText.Make(ColStr,(0@0))
  vst.SetDisplay(theLayout.GetDisplay)
  vst.GetSymbol.SetSize(10)
  While (HeightLeft <> 0)
    rec = theBitmap.GetNextSet(counter)
    counter = rec
    ValStr = theVTab.ReturnValueString(theVTab.FindField(f),rec)
    ColStr = ColStr + ValStr
    vst.SetText(ColStr)
    'Check to see if column has exceeded Height
    if (HeightLeft < vst.GetBounds.GetHeight) then
      HeightLeft = 0
    end 
    if (theBitmap.GetNextSet(counter) = -1) then
      HeightLeft = 0
    end
    ColStr = ColStr + nl
  end
  
  vst.SetOrigin(tbo - (0@(vst.getBounds.GetHeight)) )
  
  'Check to see if the Column is wider than the Title
  if (fl.GetBounds.GetWidth > vst.GetBounds.GetWidth) then
    'Title is wider, so move column
    if (theVTab.FindField(f).IsTypeNumber) then
      vst.SetAlignment(#TEXTCOMPOSER_JUST_RIGHT)
      vst.GetBounds.Move((fl.GetBounds.GetWidth - vst.GetBounds.GetWidth + 0.1),0.1)
      gl.AddBatch(vst)
    elseif(theVTab.FindField(f).IsTypeString) then
      vst.SetAlignment(#TEXTCOMPOSER_JUST_LEFT)
      vst.GetBounds.Move(0.1,0.1)
      gl.AddBatch(vst)
    end  
  else
    'Column is wider so move  & justify title
    if (theVTab.FindField(f).IsTypeNumber) then
      vst.SetAlignment(#TEXTCOMPOSER_JUST_RIGHT)
      vst.GetBounds.Move(0.1, 0.1)
      gl.AddBatch(vst)
    elseif (theVTab.FindField(f).IsTypeString) then
      vst.SetAlignment(#TEXTCOMPOSER_JUST_LEFT)
      vst.GetBounds.Move(0.1, 0.1)
      gl.AddBatch(vst)
    end    
    fl.GetBounds.Move( ( (vst.GetBounds.GetWidth - fl.GetBounds.GetWidth) /2 ) ,0)
  end  
  vst.SetSelected(true)
  
  cbr = gl.ReturnSelectedExtent.clone
  cbr.ExpandBy(0.05)
  cbp = GraphicShape.Make(cbr)
  cbp.GetSymbol.SetOLWidth(0.1)
  gl.AddBatch(cbp)
  cbp.SetSelected(true)  
  gl.GroupSelected
  gl.GetSelected.Get(0).SetObjectTag("col")
  cspace = cspace + gl.ReturnSelectedExtent.GetWidth  
  gl.UnSelectAll
  HeightLeft = bRectH
  tbo = bRectO + (cspace@bRectH)
end


for each g in gl.FindAllByObjectTag("col")
  g.SetSelected(true)
end

se = gl.ReturnSelectedExtent
seO = se.ReturnOrigin
ftr = Rect.Make(SeO + (0@(se.GetHeight - 0.275)),(se.GetWidth@0.275))

coltits = {}
for each g in gl.FindAllByObjectTag("col")
  colTitleRect = ftr.IntersectWith(g.GetBounds.Clone)
  coltits.Add(colTitleRect)
  g.SetSelected(false)
end
tc = Color.Make
tc.SetTransParent(true)




for each ftr in coltits
  bp = ftr.Clone.InsetBy(0.0125)
  bpd = Polygon.Make({{ftr.ReturnOrigin,(ftr.GetRight@ftr.GetBottom),(ftr.GetRight@ftr.GetTop),(bp.GetRight@bp.GetTop),(bp.GetLeft@bp.GetBottom),ftr.ReturnOrigin}})
  bpl = Polygon.Make({{ftr.ReturnOrigin,(bp.ReturnOrigin),(bp.GetRight@bp.GetTop),(ftr.GetRight@ftr.GetTop),(ftr.GetLeft@ftr.GetTop),ftr.ReturnOrigin}})
  gbp = GraphicShape.Make(bp)
  gbpd = GraphicShape.Make(bpd)
  gbpl = GraphicShape.Make(bpl)
  gbp.SetSymbol(ftbf.Clone)
  gbpd.SetSymbol(ftbf.Clone)
  gbpl.SetSymbol(ftbf.Clone)
  lg = Color.Make
  lg.SetRGBList({220,220,220})
  dg = Color.Make
  dg.SetRGBList({120,120,120})
  gbpd.GetSymbol.SetColor(dg.Clone)
  gbpl.GetSymbol.SetColor(lg.Clone)
  gbpl.GetSymbol.SetOLWidth(0)
  gbpd.GetSymbol.SetOLWidth(0)
  gbpl.GetSymbol.SetColorLock(true)
  gbpd.GetSymbol.SetColorLock(true)
  gbp.GetSymbol.SetOLWidth(0)
  gbpl.GetSymbol.SetOLColor(tc.Clone)
  gbpd.GetSymbol.SetOLColor(tc.Clone)
  gbp.GetSymbol.SetOLColor(tc.Clone)
  gl.AddBatch(gbpd)
  gl.AddBatch(gbpl)
  gl.AddBatch(gbp)
  gbpd.SetSelected(true)
  gbpl.SetSelected(true)
  gbp.SetSelected(True)
end
gl.GroupSelected
gl.MoveSelectedToBack
gl.GetSelected.Get(0).SetObjectTag("buttons")
gl.UnSelectAll  

for each g in gl.FindAllByObjectTag("col")
  g.SetSelected(true)
  gl.MoveSelectedToFront
end
gl.FindByObjectTag("buttons").SetSelected(true)

NeatRect = gl.ReturnSelectedExtent.Clone
nrgs = GraphicShape.Make(NeatRect)
nrgs.GetSymbol.SetOLWidth(0.6)
theLayout.GetGraphics.AddBatch(nrgs)

gl.UnSelectAll

bp = GraphicShape.Make(NeatRect)
bw = Color.GetWhite
bpf = RasterFill.Make
bpf.SetStyle(#RASTERFILL_STYLE_OPAQUESTIPPLE)
bp.SetSymbol(bpf)
bp.GetSymbol.SetColor(tc.Clone)
bp.GetSymbol.SetBGColor(Color.GetWhite)
theLayout.GetGraphics.AddBatch(bp)
bp.SetSelected(True)
gl.MoveSelectedToBack

for each g in gl.FindAllByObjectTag("col")
  g.SetSelected(true)
end
gl.FindByObjectTag("buttons").SetSelected(true)
nrgs.SetSelected(true)
gl.GroupSelected


theLayout.GetGraphics.EndBatch

