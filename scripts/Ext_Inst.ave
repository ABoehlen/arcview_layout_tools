'# Version:      1.0
'#
'# Purpose:      installiert die Extension 
'#
'#########################################################################

if (av.GetProject = nil) then
  return nil
end

Sack = Self '# Der 'Sack' vom makescript, wo alles Benoetigte drin ist

Schaltflaeche = Sack.Get(0)
viewGUI = av.GetProject.FindGUI( "Layout" )
if (viewGUI <> nil) then
  '# pruefen, ob die Schaltflaeche schon existiert
  if(viewGUI.GetButtonBar.findbyscript(Schaltflaeche.getclick) = nil) then
    '# Schaltflaeche an der 2. Stelle einfügen
    viewGUI.GetButtonBar.Add(Schaltflaeche, 2)
  end
end

av.GetProject.AddDialog(Sack.Get(1)) '# 1. Dialog hinzufuegen
av.GetProject.AddDialog(Sack.Get(2)) '# 2. Dialog hinzufuegen

