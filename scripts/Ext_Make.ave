'#########################################################################
'#
'# Filename:     Ext.Make.ave
'# Author:       Adrian Boehlen
'# Date:         05.01.2026
'# Version:      1.1
'#
'# Purpose:      erstellt die Extension
'#               Zum Erstellen der Extension NUR dieses Script ausfuehren
'#
'#########################################################################

LayoutTools = Extension.Make("$AVHOME\projects\layout_tools\LayoutTools.avx".AsFileName,
"LayoutTools",av.FindScript("Ext.Inst"),av.FindScript("Ext.Unin"), {"$AVBIN/avdlog.dll".AsFileName})

LayoutTools.SetExtVersion(2)

'# Beschreibung (Version jeweils anpassen)
LayoutTools.SetAbout("LayoutTools Toolbar (v2.2) ")

LayoutTools.SetUnloadScript(av.FindScript("ext.Unload"))

'# Schaltflaeche und Dialoge hinzufuegen
Schaltflaeche=( av.FindGUI( "Layout").GetButtonBar.findbyscript("LayoutTools.start"))  
LayoutToolsDialog = av.FindDialog("LayoutTools")
SatzspiegelDialog = av.FindDialog("Satzspiegel")
DefaultValues = av.FindScript("DefaultValues")
LayoutTools.Add( Schaltflaeche)
LayoutTools.Add(LayoutToolsDialog)
LayoutTools.Add(SatzspiegelDialog)

for each aDoc in av.GetProject.GetDocs
  if (aDoc.Is(SEd)) then
    if (aDoc.GetName.Contains("LayoutTools.")) then
      if (aDoc.IsCompiled.Not) then
        aDoc.Compile
      end
      LayoutTools.Add(av.FindScript(aDoc.GetName))
    end
  end
end

LayoutTools.Commit


