'###########################################################################
'#
'# Filename:     LayoutTools_Enter_command.ave
'# Author:       Adrian Boehlen
'# Date:         30.11.2018
'# Version:      0.16
'#
'# Purpose:      loest diverse Funktionen durch Kommandos aus
'#
'#               erfordert 
'#               - LayoutTools.General_Documentation
'#               - alle Tools, die ueber Kommandos aufgerufen werden
'#
'###########################################################################


'########## Help messages ##########

av.Run("LayoutTools.General_Documentation", _uebersicht)
av.Run("LayoutTools.General_Documentation", _helpnew)
av.Run("LayoutTools.General_Documentation", _helpcopy)
av.Run("LayoutTools.General_Documentation", _helphlon)
av.Run("LayoutTools.General_Documentation", _helphlonm)
av.Run("LayoutTools.General_Documentation", _helphloff)
av.Run("LayoutTools.General_Documentation", _helphloffm)
av.Run("LayoutTools.General_Documentation", _helpheado)
av.Run("LayoutTools.General_Documentation", _helpheadm)
av.Run("LayoutTools.General_Documentation", _helpdelhead)
av.Run("LayoutTools.General_Documentation", _helplytimp)
av.Run("LayoutTools.General_Documentation", _helplytexp)
av.Run("LayoutTools.General_Documentation", _helpfi)
av.Run("LayoutTools.General_Documentation", _helpfis)
av.Run("LayoutTools.General_Documentation", _helpli)
av.Run("LayoutTools.General_Documentation", _helplis)
av.Run("LayoutTools.General_Documentation", _helpti)
av.Run("LayoutTools.General_Documentation", _helptis)
av.Run("LayoutTools.General_Documentation", _helpregm)
av.Run("LayoutTools.General_Documentation", _helpselall)
av.Run("LayoutTools.General_Documentation", _helpunselall)
av.Run("LayoutTools.General_Documentation", _helpmx)
av.Run("LayoutTools.General_Documentation", _helpmy)

_command = Self.GetDialog.FindByName("EnterCommand").GetText
Self.SetText("")

'########## execute functions ##########

'# New
if (_command = "new") then
  av.Run("LayoutTools.General_NewLayout", {})
elseif (_command = "help new") then
  MsgBox.Report(_helpnew,"Help new")

'# Copy
elseif (_command = "copy") then
  av.Run("LayoutTools.General_CopyLayout", {})
elseif (_command = "help copy") then
  MsgBox.Report(_helpcopy,"Help copy")

'# Hilfslinien
elseif (_command = "hlon") then
  av.Run("LayoutTools.Ruler_TurnRulersOnOne", {})
elseif (_command = "help hlon") then
  MsgBox.Report(_helphlon,"Help hlon")
elseif (_command = "hloff") then
  av.Run("LayoutTools.Ruler_TurnRulersOffOne", {})
elseif (_command = "help hloff") then
  MsgBox.Report(_helphloff,"Help hloff")
elseif (_command = "hlonm") then
  av.Run("LayoutTools.Ruler_TurnRulersOnMany", {})
elseif (_command = "help hlonm") then
  MsgBox.Report(_helphlonm,"Help hlonm")
elseif (_command = "hloffm") then
  av.Run("LayoutTools.Ruler_TurnRulersOffMany", {})
elseif (_command = "help hloffm") then
  MsgBox.Report(_helphloff,"Help hloffm")

'# Header and Footer
elseif (_command = "heado") then
  av.Run("LayoutTools.Text_HeaderAndFooterOne", {})
elseif (_command = "help heado") then
  MsgBox.Report(_helpheado,"Help heado")
elseif (_command = "headm") then
  av.Run("LayoutTools.Text_HeaderAndFooterMany", {})
elseif (_command = "help headm") then
  MsgBox.Report(_helpheadm,"Help headm")
elseif (_command = "delhead") then
  av.Run("LayoutTools.Text_DeleteHeaderAndFooter", {})
elseif (_command = "help delhead") then
  MsgBox.Report(_helpdelhead, "Help delhead")
  
'# Import and Export
elseif (_command = "lytimp") then
  av.Run("LayoutTools.ImpExp_LoadODB", {})
elseif (_command = "help lytimp") then
  MsgBox.Report(_helplytimp,"Help lytimp")
elseif (_command = "lytexp") then
  av.Run("LayoutTools.ImpExp_CreateODB", {})
elseif (_command = "help lytexp") then
  MsgBox.Report(_helplytexp,"Help lytexp")
  
'# Import Text
elseif ((_command = "fi") or (_command = "fis")) then
  av.Run("LayoutTools.Text_ImportText", {})
elseif (_command = "help fi") then
  MsgBox.Report(_helpfi,"Help fi")
elseif (_command = "help fis") then
  MsgBox.Report(_helpfis,"Help fis")
elseif ((_command = "li") or (_command = "lis")) then
  av.Run("LayoutTools.Text_ImportText", {})
elseif (_command = "help li") then
  MsgBox.Report(_helpli,"Help li")
elseif (_command = "help lis") then
  MsgBox.Report(_helplis,"Help lis")
elseif ((_command = "ti") or (_command = "tis")) then
  av.Run("LayoutTools.Text_ImportText", {})
elseif (_command = "help ti") then
  MsgBox.Report(_helpti,"Help ti")
elseif (_command = "help tis") then
  MsgBox.Report(_helptis,"Help tis")

'# Schnittmarken
elseif (_command = "regm") then
  av.Run("LayoutTools.General_MakeRegistrationMarks", {})
elseif (_command = "help regm") then
  MsgBox.Report(_helpregm,"Help regm")
  
'# Select elements
elseif (_command = "selall") then
  av.Run("LayoutTools.Sel_SelectAll", {})
elseif (_command = "help selall") then
  MsgBox.Report(_helpselall, "Help selall")
elseif (_command = "unselall") then
  av.Run("LayoutTools.Sel_UnselectAll", {})
elseif (_command = "help unselall") then
  MsgBox.Report(_helpunselall, "Help unselall")
  
'# Move features
elseif (_command.Left(2) = "mx") then
  av.Run("LayoutTools.General_MoveFeature", {})
elseif (_command = "help mx") then
  MsgBox.Report(_helpmx, "Help mx")
elseif (_command.Left(2) = "my") then
  av.Run("LayoutTools.General_MoveFeature", {})
elseif (_command = "help my") then
  MsgBox.Report(_helpmy, "Help my")
 
'# Help / Misc
elseif (_command = "help") then
  MsgBox.Report(_uebersicht,"")
elseif (_command = "zoomex") then
  av.Run("LayoutTools.View_ZoomToExportview", {})
elseif (_command = "quit") then
  self.GetDialog.Close
elseif (_command = nil) then
  return nil
else
  MsgBox.Info("Command not found","")
end
