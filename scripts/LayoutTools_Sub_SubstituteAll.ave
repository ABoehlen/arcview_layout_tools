'############################################################
'#
'# Filename:     LayoutTools_Sub_SubstituteAll.ave
'# Author:       Adrian Boehlen
'# Date:         09.11.2018
'# Version:      0.3
'#
'# Purpose:      ersetzt alle Zeichen ausser dem als _bullet
'#               definierten Zeichen durch den Leerstring
'#
'############################################################

'# replace printable characters 32 - 255 except _bullet

str = Self
for each i in 32..(_bullet - 1)
  str = str.Substitute(i.AsChar,"")
end

for each i in (_bullet + 1)..255
  str = str.Substitute(i.AsChar,"")
end

return str
