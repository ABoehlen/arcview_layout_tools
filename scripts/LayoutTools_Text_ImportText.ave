'#########################################################################
'#
'# Filename:     LayoutTools_ImportText.ave
'# Author:       Adrian Boehlen
'# Date:         09.12.2018
'# Version:      0.22
'#
'# Purpose:      Liest Text ein und bildet daraus einen Textblock
'#               der definierten maximalen Breite in mm
'#               bestehende Zeilenumbrueche bleiben erhalten
'#               bei den Kommandos "fi", "ti", "uli und "oli" muessen 
'#               Schriftart, -groesse und -farbe definiert werden,
'#               bei den Kommandos "fis", "tis", "ulis" und "olis" werden 
'#               die Defaultwerte "DejaVu Sans Condensed Black
'#               gesetzt.
'#
'#               je nach Kommando wird ein gesamtes Textfile eingelesen
'#               oder Text, der ueber eine Inputbox eingegeben wird.
'#
'#               erwartet eine selektierte Textbox im Layout,
'#               an der Stelle, wo dann der neue Text erscheinen soll.
'#               Die Textbox kann leer sein, oder schon mit Text gefuellt,
'#               wobei dieser dann geloescht wird
'#               Der neue Text beginnt an der linken oberen Ecke der 
'#               bestehenden Textbox.
'#
'#               Bei den Kommandos "uli", "oli", "ulis" und "olis" wird 
'#               zugleich eine Spalte mit Aufzaehlungszeichen gesetzt. Die
'#               Position der Aufzaehlungszeichen muss im importierten Text
'#               mit dem Zeichen "¬" gekennzeichnet werden.
'#
'#               Sonderzeichen koennen ueber ihren dreistelligen dezimalen
'#               ASCII-Code im Textdokument deklariert werden, wenn das
'#               Zeichen \ davor gesetzt wird. z.B: \036 wird dann zu $
'#
'#               erfordert:
'#               - LayoutTools.Sub_DefaultValues
'#               - LayoutTools.Sub_SetASCII_Char
'#               - LayoutTools.Sub_SubstituteAll
'#
'#########################################################################

nullstring = ""
av.Run("LayoutTools.Sub_DefaultValues", {})   '# Defaultwerte einlesen
theLayout = av.GetActiveDoc 

if (theLayout.Is(layout).Not) then
  MsgBox.Warning("Start this script from an active Layout.","")
  return nil
end

'########## Benutzereingaben aufnehmen ##########

'# ganze Textfiles importieren
if ((_command = "fi") or (_command = "fis")) then
  theFile = FileDialog.Show("*.txt","text files","Choose text file")
  if (theFile = nil) then
    return nil
  end

'# normalen Text ueber die Inputbox importieren
elseif ((_command = "ti")  or (_command = "tis")) then
  textstring = MsgBox.Input("","Import Text","")
  if (textstring = nil) then
    return nil
  end
  theFile = FileName.Make("tmp.txt")
  if (File.Exists(theFile)) then
    File.Delete(theFile)
  end
  tmpFile = LineFile.Make(theFile,#FILE_PERM_WRITE)
  tmpFile.WriteElt(textstring)
  tmpFile.close

'# Text fuer Liste ueber die Inputbox importieren
elseif ((_command = "uli")  or (_command = "ulis")) then
  textstring = MsgBox.Input("","Import Text for Unordered List","")
  if (textstring = nil) then
    return nil
  end
  theFile = FileName.Make("tmp.txt")
  if (File.Exists(theFile)) then
    File.Delete(theFile)
  end
  tmpFile = LineFile.Make(theFile,#FILE_PERM_WRITE)
  tmpFile.WriteElt(textstring)
  tmpFile.close
  
elseif ((_command = "oli")  or (_command = "olis")) then
  textstring = MsgBox.Input("","Import Text for Ordered List","")
  if (textstring = nil) then
    return nil
  end
  theFile = FileName.Make("tmp.txt")
  if (File.Exists(theFile)) then
    File.Delete(theFile)
  end
  tmpFile = LineFile.Make(theFile,#FILE_PERM_WRITE)
  tmpFile.WriteElt(textstring)
  tmpFile.close

end


'# Breite des Textblocks definieren
maxLength = MsgBox.Input("Insert the width of the new textblock in mm","Width",_breiteTextbl.AsString)

if (maxLength = nil) then
  return nil
elseif (maxLength.IsNumber.Not) then
  MsgBox.Warning("Invalid input","Abort")
  return nil
end
maxLength = maxLength.AsNumber

'########## Schrift bestimmen ##########

'# Schriftart definieren
if ((_command = "fi") or (_command = "ti") or (_command = "uli") or (_command = "oli")) then
  schriftartListe = {"DejaVu Sans", "DejaVu Sans Mono", "DejaVu Serif", "Khalid", "Segoe UI", "Courier New"}
  schriftart = MsgBox.ListAsString(schriftartListe, "Choose font", "Font")
  if (schriftart = nil) then 
    return nil
  end
else
  schriftart = _schriftart
end

'# Schriftschnitt definieren
if ((_command = "fi") or (_command = "ti") or (_command = "uli") or (_command = "oli")) then
  if (schriftart = "DejaVu Sans") then
    schriftschnittListe = {"Condensed", "Condensed Bold", "Condensed Oblique", "Condensed Bold Oblique"}
    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, "Choose font style", "Font Style")
    if (schriftschnitt = nil) then 
      return nil
    end
  elseif (schriftart = "DejaVu Sans Mono") then
    schriftschnittListe = {"Book", "Bold", "Oblique", "Bold Oblique"}
    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, "Choose font style", "Font Style")
    if (schriftschnitt = nil) then 
      return nil
    end
  elseif (schriftart = "DejaVu Serif") then
    schriftschnittListe = {"Book", "Bold", "Condensed", "Condensed Bold", "Condensed Italic", "Condensed Bold Italic", "Italic", "Bold Italic"}
    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, "Choose font style", "Font Style")
    if (schriftschnitt = nil) then 
      return nil
    end
  elseif (schriftart = "Khalid") then
    schriftschnittListe = {"Normal"}
    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, "Choose font style", "Font Style")
    if (schriftschnitt = nil) then 
      return nil
    end
  elseif (schriftart = "Segoe UI") then
    schriftschnittListe = {"Standard", "Kursiv", "Fett", "Fett Kursiv"}
    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, "Choose font style", "Font Style")
    if (schriftschnitt = nil) then 
      return nil
    end
  elseif (schriftart = "Courier New") then
    schriftschnittListe = {"Standard"}
    schriftschnitt = MsgBox.ListAsString(schriftschnittListe, "Choose font style", "Font Style")
    if (schriftschnitt = nil) then 
      return nil
    end
  end
else
  schriftschnitt = _schriftschnitt
end

'# Schriftfarbe definieren
if ((_command = "fi") or (_command = "ti") or (_command = "uli") or (_command = "oli")) then
  theColorList = {"Black", "Grey", "Red", "Green", "Blue", "User defined"}
  theColor = MsgBox.ListAsString(theColorList, "Choose font colour", "Font Colour")
  if (theColor = nil) then 
    return nil
  elseif (theColor = "User defined") then
    theRGB = MsgBox.MultiInput("Define RGB", "RGB",
    {"Red", "Green", "Blue"}, {"0", "0", "0"})
    if (theRGB = nil) then
      return nil
    end
    rot = theRGB.Get(0)
    gruen = theRGB.Get(1)
    blau = theRGB.Get(2)
  end
else
  theColor = _schwarzT
end

'# Schriftgroesse definieren
theSize = MsgBox.Input("Insert font size", "Font Size",_schriftgroesse.AsString)

if (theSize = nil) then
  return nil
elseif (theSize.IsNumber.Not) then
  MsgBox.Warning("Invalid input","Abort")
  return nil
end
theSize = theSize.AsNumber

'# Abstand der Aufzaehlungszeichen festlegen
if ((_command = "oli") or (_command = "olis")) then
  abst = MsgBox.Input("Define the space between the marker and the text in mm",
    "List: Space between marker and text",_abstList.AsString)
  if (abst = nil) then
    return nil
  elseif (abst.IsNumber.Not) then
    MsgBox.Warning("Invalid input","Abort")
    return nil
  end
  abst = abst.AsNumber
end

if ((_command = "uli") or (_command = "ulis")) then
  abst = MsgBox.Input("Define the space between the bullets and the text in mm",
    "List: Space between bullets and text",_abstList.AsString)
  if (abst = nil) then
    return nil
  elseif (abst.IsNumber.Not) then
    MsgBox.Warning("Invalid input","Abort")
    return nil
  end
  abst = abst.AsNumber
end

'# Aufzaehlungszeichen definieren
if (_command = "uli") then
  _bullet = MsgBox.Input("Define the character for the bullet (Default: Halbgeviertstrich)",
    "List: Bullet character",_bullet.AsString)
  if (_bullet = nil) then
    return nil
  elseif (_bullet.IsNumber.Not) then
    MsgBox.Warning("Invalid input","Abort")
    return nil
  end
  _bullet = _bullet.AsNumber
end

'########## Text einlesen, formatieren, symbolisieren und platzieren ##########

'# LineFile erzeugen und Anzahl Zeilen ermitteln
theLineFile = LineFile.Make(theFile,#FILE_PERM_READ)
elementCount = theLineFile.GetSize

'# Variablen initialisieren
theTextBlock = ""
theNewLine = " "
theNewLineT = ""
theWordT = ""
i = 0

'# Farben zuweisen
if (theColor = "Black") then
  theColor = Color.GetBlack
elseif (theColor = "Grey") then
  theColor = Color.GetGray
elseif (theColor = "Red") then
  theColor = Color.Make
  theColor.SetRGBList({210,35,45})
elseif (theColor = "Green") then
  theColor = Color.GetGreen
elseif (theColor = "Blue") then
  theColor = Color.Make
  theColor.SetRGBList({0,137,207})
elseif (theColor = "User defined") then
  theColor = Color.Make
  theColor.SetRGBList({rot.AsNumber,gruen.AsNumber,blau.AsNumber})
end

schriftart = Font.Make (schriftart, schriftschnitt)
theGraphicList = theLayout.GetGraphics
theSelected = theGraphicList.GetSelected.Get(0)
theOrigin = theSelected.GetOrigin                               '# Nullpunkt unten links bestimmen

'# Input-Text in neue Zeilen der gewuenschten Laenge umformatieren

for each i in 1..elementCount                                   '# zeilenweise durchgehen
  theLine = theLineFile.ReadElt                                 '# aktuelle Zeile
  if (theLine.Count > 0) then                                   '# alle nicht leeren Zeilen
    i = 0
    for each word in theLine.AsList                             '# Zeile in Woerter auftrennen
      i = i + 1
      word = av.Run("LayoutTools.Sub_SetASCII_Char", word)      '# uebersetzen der ASCII-Codes in entsprechende Zeichen
      theGraphicText = GraphicText.Make (theNewLine, theOrigin)
      theSymbol = theGraphicText.ReturnSymbols.Get (0)
      theSymbol.SetColor(theColor)
      theSymbol.SetFont(schriftart)
      theSymbol.SetSize(theSize)
      theLayout.GetGraphics.Add (theGraphicText)
      theWidth = theGraphicText.GetBounds.GetWidth
      theWidth = theWidth * 25.4                                '# inch to mm
      theGraphicList.RemoveGraphic (theGraphicText)
      
      if (theWidth > maxLength) then                            '# wenn laenger als maxLength Laenge...
        theTextBlock = theTextBlock + theNewLineT.Trim + NL     '# ...setze temporaere Zeile an Textblock an und schliesse mit Newline ab
        theNewLine = theWordT                                   '# starte neue Zeile mit letztem Wort aus letztem Durchgang
      end
      if (theLine.AsList.Count = i) then                        '# beim letzten Wort der Zeile...
        theNewLine = theNewLine ++ word + NL                    '# ...Woerter zusammensetzen und mit Newline abschliessen
        theTextBlock = theTextBlock + theNewLine.Trim + NL      '# setze an Textblock an und schliesse mit Newline ab
        theNewLine = ""                                         '# temporaere Zeile loeschen
      else
        theWordT = word                                         '# aktuelles Wort in temporaerer Variable speichern
        theNewLineT = theNewLine                                '# aktuelle Zeile in temporaerer Variable speichern
        theNewLine = theNewLine ++ word                         '# Woerter zu neuer Zeile zusammensetzen
      end
    end
  else                                                          '# alle leeren Zeilen
    if (theNewLine.Count > 0) then                              '# wenn neue Zeile nicht leer ist... 
      theTextBlock = theTextBlock + theNewLine.Trim + NL        '# ...setze an Textblock an und schliesse mit Newline ab
      theNewLine = ""                                           '# Inhalt der neuen Zeile loeschen
    end
    theTextBlock = theTextBlock + NL                            '# wenn neue Zeile nicht leer ist, schliesse mit Newline ab
  end
end

theTextBlock = theTextBlock + theNewLine.Trim                   '# fuege Rest der letzten Zeile noch an
theTextBlock = theTextBlock.BasicTrim("",NL)                    '# entferne ueberschuessiges Newline am Ende

'# ungeordnete Listen
if ((_command = "uli") or (_command = "ulis")) then             '# fuer eine nicht geordnete Liste...
  theString = theTextBlock                                      '# kopiere Textblock
  theString = theString.Substitute("¬",_bullet.AsChar)          '# ersetze Listenzeichen durch definiertes Aufzaehlungszeichen
  theMarks = av.Run("LayoutTools.Sub_SubstituteAll", {theString, "UL"})  '# loesche uebrige Zeichen und weise neuer Variable zu
  theTextBlock = theTextBlock.Substitute("¬","")                '# entferne Listenzeichen aus Textblock
end

'# geordnete Listen
anzMark = 0
char = 0
zeile = 0
theMarks2 = ""
if ((_command = "oli") or (_command = "olis")) then             '# fuer eine geordnete Liste...
  theString = theTextBlock                                      '# kopiere Textblock
  theString = theString.Substitute("¬",_bullet.AsChar)          '# ersetze Listenzeichen durch definiertes Aufzaehlungszeichen
  theMarks = av.Run("LayoutTools.Sub_SubstituteAll", {theString, "OL"})  '# loesche uebrige Zeichen und weise neuer Variable zu
  for each char in theMarks.AsTokens(NL)                        '# Textblock, welcher nur "Bullets" enthaelt, durchgehen 
    zeile = zeile + 1                                           '# Zeilen zaehlen
    if (char.Contains(_bullet.AsChar)) then
      anzMark = anzMark + 1                                     '# "Bullets" zaehlen
      '# "Bullets" durch aufsteigende Werte ersetzen und einen Punkt dahinter ergaenzen
      theMarks2 = theMarks2 + char.Substitute(_bullet.AsChar, anzMark.AsString + ".")
      theMarks2 = theMarks2 + NL                                '# nach jeder Ersetzung ein Zeilenvorschub einfuegen
    '# bei Zeilen, die Leerzeichen (32) enthalten, einen Zeilenvorschub setzen, ausser bei der letzten
    elseif (char.Contains(32.AsChar) and (zeile < theMarks.AsTokens(NL).Count)) then
      theMarks2 = theMarks2 + NL
    end
  end
  theMarks = theMarks2                                          '# Inhalt wieder urspruenglicher Variable zuweisen
  theMarks = theMarks.Substitute(32.AsChar,"")                  '# alle Leerzeichen entfernen
  theTextBlock = theTextBlock.Substitute("¬","")                '# entferne Listenzeichen aus Textblock
end

theLineFile.Close

'# Text symbolisieren und temporaer in Layout platzieren
theGraphicList = theLayout.GetGraphics
theSelected = theGraphicList.GetSelected.Get(0)
theOrigin = theSelected.GetOrigin                                        '# Nullpunkt unten links bestimmen
theOrigin = theOrigin.GetX@(theOrigin.GetY + theSelected.GetExtent.GetY) '# Nullpunkt oben links ableiten
theGraphicText = GraphicText.Make (theTextBlock, theOrigin)
theSymbol = theGraphicText.ReturnSymbols.Get (0)
theSymbol.SetColor(theColor)
theSymbol.SetFont(schriftart)
theSymbol.SetSize(theSize)

theLayout.GetGraphics.Add (theGraphicText)
theGraphicList.RemoveGraphic (theSelected)                     '# urspruenglich selektierte Textbox loeschen

'# Hoehe des Textblocks bestimmen und Nullpunkt so umrechnen, dass der Text oben links
'# mit dem bestehenden uebereinstimmt. Bei Listen Textblock entsprechend einruecken

if ((_command = "uli") or (_command = "ulis") or (_command = "oli") or (_command = "olis")) then
  abst = abst / 25.4     '# mm to inch
  theOrigin = (theOrigin.GetX + abst)@(theOrigin.GetY - theGraphicText.GetExtent.GetY) 
  theGraphicList.RemoveGraphic(theGraphicText)                 '# temporaeren Text loeschen
  theGraphicText = GraphicText.Make (theTextBlock, theOrigin)
  theSymbol = theGraphicText.ReturnSymbols.Get (0)
  theSymbol.SetColor(theColor)
  theSymbol.SetFont(schriftart)
  theSymbol.SetSize(theSize)
  theLayout.GetGraphics.Add (theGraphicText)
  '# Aufzaehlungszeichen ergaenzen
  theOrigin = (theOrigin.GetX - abst)@theOrigin.GetY
  theGraphicText = GraphicText.Make (theMarks, theOrigin)
  theSymbol = theGraphicText.ReturnSymbols.Get (0)
  theSymbol.SetColor(theColor)
  theSymbol.SetFont(schriftart)
  theSymbol.SetSize(theSize)
  theLayout.GetGraphics.Add (theGraphicText)
else
  theOrigin = theOrigin.GetX@(theOrigin.GetY - theGraphicText.GetExtent.GetY) 
  theGraphicList.RemoveGraphic(theGraphicText)                 '# temporaeren Text loeschen
  theGraphicText = GraphicText.Make (theTextBlock, theOrigin)
  theSymbol = theGraphicText.ReturnSymbols.Get (0)
  theSymbol.SetColor(theColor)
  theSymbol.SetFont(schriftart)
  theSymbol.SetSize(theSize)
  theLayout.GetGraphics.Add (theGraphicText)
end

theLayout.Invalidate

'# bei Import ueber Textbox temporaer erzeugtes File loeschen
if (theFile.AsString.Contains("tmp.txt")) then
  File.Delete(theFile)
end
