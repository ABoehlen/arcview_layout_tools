if (av.GetProject = nil) then
  return nil
end

Sack=self 'Der Sack vom makescript, wo alles Benötigte drin ist

Schaltflaeche=Sack.get(0)
viewGUI = av.GetProject.FindGUI( "Layout" )
if (viewGUI <> nil) then
    'prüfen, ob die Schaltfläche schon existiert
    if(viewGUI.GetButtonBar.findbyscript(Schaltflaeche.getclick)=nil)then
      'Schaltfläche an der 2. Stelle einfügen
      viewGUI.GetButtonBar.Add( Schaltflaeche, 2)
    end
end

av.getproject.Adddialog( Sack.get(1))




