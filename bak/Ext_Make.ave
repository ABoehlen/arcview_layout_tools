LayoutTools = Extension.Make("$AVHOME\projects\layout_tools\LayoutTools.avx".AsFileName,
"LayoutTools",av.FindScript("Ext_inst"),av.FindScript("Ext_unin"), {"$AVBIN/avdlog.dll".AsFileName})

LayoutTools.SetExtVersion(1)
LayoutTools.SetAbout("LayoutTools Toolbar (v0.4) ")
LayoutTools.SetUnloadScript(av.FindScript("ext_unload"))

Schaltflaeche=( av.FindGUI( "Layout").GetButtonBar.findbyscript("LayoutTools.start"))  
LayoutToolsDialog = av.FindDialog("LayoutTools")
LayoutTools.Add( Schaltflaeche)   'Schaltfläche hinzufügen
LayoutTools.Add(LayoutToolsDialog)

for each aDoc in av.GetProject.GetDocs
  if (aDoc.Is(SEd)) then
    if (aDoc.GetName.Contains("LayoutTools.")) then
      if (aDoc.IsCompiled.Not) then
        aDoc.Compile
      end
      LayoutTools.Add(av.FindScript(aDoc.GetName))
    end
  end
end

LayoutTools.Commit


